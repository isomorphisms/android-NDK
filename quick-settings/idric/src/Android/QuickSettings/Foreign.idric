export
%foreign "dex:static:Landroid/service/quicksettings/TileService;:requestListeningState:(Landroid/content/Context;Landroid/content/ComponentName;)V"
request_listening : Context → ComponentName → PrimIO ()

export
%foreign "dex:virtual:Landroid/service/quicksettings/TileService;:startActivityAndCollapse:(Landroid/app/PendingIntent;)V"
start_activity : TileService → PendingIntent → PrimIO ()

-- API 24 legacy overload; deprecated in 34 and rejected on Android 14 when
-- the app targets API 34+. It remains explicitly named, never a fallback.
export
%foreign "dex:virtual:Landroid/service/quicksettings/TileService;:startActivityAndCollapse:(Landroid/content/Intent;)V"
start_activity_legacy : TileService → Intent → PrimIO ()

