module Android.QuickSettings.Foreign

import Android.QuickSettings.References

-- Exact public SDK calls, with raw ABI types and effectful reads.
-- Foreign declarations do not register a service or generate callbacks.
-- The supported API floor for each method is in api.tsv.

export
%foreign "dex:virtual:Landroid/service/quicksettings/TileService;:getQsTile:()Landroid/service/quicksettings/Tile;"
