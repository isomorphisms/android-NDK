export
%foreign "dex:virtual:Landroid/service/quicksettings/TileService;:isLocked:()Z"
is_locked : TileService → PrimIO Int32

export
%foreign "dex:virtual:Landroid/service/quicksettings/TileService;:isSecure:()Z"
