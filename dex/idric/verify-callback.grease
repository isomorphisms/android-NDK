#!/usr/bin/env grease

# Compiler/host qualification; ART is a separate required stage.
if (len(ARGV) !== 6) {
  echo 'usage: grease verify-callback.grease REPOSITORY IDRIC UPSTREAM DEXDUMP EVIDENCE EXPECTED_HEAD' >&2
  exit 2
}
var repository = ARGV[0]
var core = ARGV[1]
var upstream = ARGV[2]
var dexdump = ARGV[3]
var evidence = ARGV[4]
var expected_head = ARGV[5]
for path in "$repository" "$core" "$upstream" "$dexdump" "$evidence" {
  if (path[0] !== '/') { echo 'absolute path required' >&2; exit 2 }
}
test "$(git -C "$repository" rev-parse HEAD)" = "$expected_head"
test "$(git -C "$core" rev-parse HEAD)" = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
if test -e "$evidence" { echo 'refusing reused callback evidence' >&2; exit 1 }
mkdir -p "$evidence"
var compiler = "$core/_/build/exec/idris2"
var scheme = "$core/_/.tools/bin/scheme"
var prefix = "$core/_/bootstrap-build"
var libraries = "$prefix/idris2-0.8.0/base-0.8.0:$prefix/idris2-0.8.0/prelude-0.8.0"
var api = "$core/_/build/ttc"
var driver = "$upstream/backend/exec/idric-dex"
var source = "$repository/examples/autogenerated/interface-callback"
for program in "$compiler" "$scheme" "$driver" "$dexdump" { test -x "$program" }
git -C "$repository" rev-parse HEAD 'HEAD^{tree}' > "$evidence/revision.txt"
git -C "$repository" diff --binary HEAD > "$evidence/local.patch"
sha256sum "$source/ViewCallbackSource.idric" "$source/CallbackPlanChecks.idric" \
  "$source/ViewCallbackRunner.smali" "$driver" \
  "$upstream/backend/exec/idric-dex_app/idric-dex.so" > "$evidence/inputs.txt"

proc clean_log(path) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$path" }
  var status = _error.code
  if (status === 0) { echo 'FAIL compiler diagnostics' >&2; return 1 }
  if (status !== 1) { echo 'FAIL diagnostic inspection' >&2; return 2 }
}

proc host_check(directory, modules, output) {
  mkdir -p "$output"
  env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$modules:$api:$libraries" CHEZ="$scheme" \
    "$compiler" --cg chez --source-dir "$directory" --build-dir "$output/build" \
    --output-dir "$output" "$directory/CallbackPlanChecks.idric" -o callback-plans \
    > "$output/compile.txt" 2>&1
  clean_log "$output/compile.txt"
  test -x "$output/callback-plans"
  cp "$core/_/build/exec/idris2_app/libidris2_support.so" "$output/callback-plans_app/"
}
host_check "$source" "$upstream/backend/ttc" "$evidence/host"
env CHEZ="$scheme" "$evidence/host/callback-plans" > "$evidence/host/run.txt" 2>&1
rg -q -x -F 'PASS callback typed-plan controls' "$evidence/host/run.txt"

# Real production changes must remain type-correct and fail the host oracle.
for mutation in receiver signature {
  var directory = "$evidence/$mutation-source"
  mkdir -p "$directory"
  cp -R "$repository/dex/idric/src/Backend" "$directory/"
  cp "$source/CallbackPlanChecks.idric" "$directory/"
  var target = "$directory/Backend/DEX/Callback.idr"
  if (mutation === 'receiver') {
    sed 's/argument_registers 2 target.parameter_types/argument_registers 1 target.parameter_types/' \
      "$repository/dex/idric/src/Backend/DEX/Callback.idr" > "$target"
  } else {
    sed 's/if method_descriptor reference \/= callback.signature/if False/' \
      "$repository/dex/idric/src/Backend/DEX/Callback.idr" > "$target"
  }
  if cmp -s "$repository/dex/idric/src/Backend/DEX/Callback.idr" "$target" {
    echo 'FAIL mutation made no change' >&2; exit 1
  }
  host_check "$directory" "$directory/build/ttc" "$evidence/host-$mutation"
  try { env CHEZ="$scheme" "$evidence/host-$mutation/callback-plans" > "$evidence/host-$mutation/run.txt" 2>&1 }
  var status = _error.code
  test "$status" = 1
  if (mutation === 'receiver') {
    rg -q -x -F 'FAIL actual-argument-excludes-listener-receiver' "$evidence/host-$mutation/run.txt"
  } else {
    rg -q -x -F 'FAIL wrong-source-signature-refuses' "$evidence/host-$mutation/run.txt"
  }
}

proc compile_candidate(directory, name) {
  var output = "$evidence/$name"
  mkdir -p "$output"
  try {
    env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$upstream/backend/ttc:$libraries" CHEZ="$scheme" \
      "$driver" --cg dex --source-dir "$directory" --build-dir "$output/build" \
      --output-dir "$output" "$directory/ViewCallbackSource.idric" -o candidate > "$output/compile.txt" 2>&1
  }
  var compiler_status = _error.code
  printf 'compiler_exit=%s\n' "$compiler_status" > "$output/compiler-status.txt"
  cat "$output/compile.txt"
  if (compiler_status !== 0) { return "$compiler_status" }
  clean_log "$output/compile.txt"
  for suffix in dex dex.plan checked.anf smali { test -s "$output/candidate.$suffix" }
  "$dexdump" -c "$output/candidate.dex" > "$output/checksum.txt" 2>&1
  "$dexdump" -d "$output/candidate.dex" > "$output/disassembly.txt" 2>&1
  rg -q -F 'Landroid/view/View$OnClickListener;' "$output/disassembly.txt"
  rg -q -F 'onClick' "$output/disassembly.txt"
  rg -q -F 'invoke-direct' "$output/disassembly.txt"
  sha256sum "$output/candidate.dex" > "$output/sha256.txt"
}
compile_candidate "$source" positive
mkdir -p "$evidence/action-mutant-source"
sed 's/identity ≟ 101/identity ≟ 102/' "$source/ViewCallbackSource.idric" \
  > "$evidence/action-mutant-source/ViewCallbackSource.idric"
if cmp -s "$source/ViewCallbackSource.idric" "$evidence/action-mutant-source/ViewCallbackSource.idric" { exit 1 }
compile_candidate "$evidence/action-mutant-source" mutant
compile_candidate "$source" recovery
cmp "$evidence/positive/candidate.dex" "$evidence/recovery/candidate.dex"

for refusal in wrong-signature missing-export {
  var directory = "$evidence/$refusal-source"
  mkdir -p "$directory"
  if (refusal === 'wrong-signature') {
    sed 's/onClick (Landroid\/view\/View;)V click_action/onClick (I)V click_action/' \
      "$source/ViewCallbackSource.idric" > "$directory/ViewCallbackSource.idric"
  } else {
    sed 's/)V click_action/)V absent_export/' "$source/ViewCallbackSource.idric" > "$directory/ViewCallbackSource.idric"
  }
  env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$libraries" CHEZ="$scheme" "$driver" \
    --source-dir "$directory" --build-dir "$evidence/$refusal-check" \
    --check "$directory/ViewCallbackSource.idric" > "$evidence/$refusal-check.txt" 2>&1
  clean_log "$evidence/$refusal-check.txt"
  try { compile_candidate "$directory" "$refusal" }
  if (_error.code === 0) { echo 'FAIL unsupported callback accepted' >&2; exit 1 }
  if test -e "$evidence/$refusal/candidate.dex" { echo 'FAIL refused callback emitted DEX' >&2; exit 1 }
  if (refusal === 'wrong-signature') {
    rg -q -F 'DEX callback signature disagrees with checked export' "$evidence/$refusal/compile.txt"
  } else {
    rg -q -F 'DEX callback has no unique checked static export' "$evidence/$refusal/compile.txt"
  }
}
echo 'PASS callback host controls, source refusals and deterministic recovery' > "$evidence/result.txt"
echo 'ART NOT_RUN; runtime stage is separately required' >> "$evidence/result.txt"
cat "$evidence/result.txt"
