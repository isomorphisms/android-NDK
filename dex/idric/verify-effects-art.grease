#!/usr/bin/env grease

# External Android emulator acceptance. Candidate semantics come only from
# the checked DEX outputs; smali assembles the separate observation runners.
if (len(ARGV) !== 4) {
  echo 'usage: grease verify-effects-art.grease REPOSITORY HOST_EVIDENCE SMALI_JAR ADB'
  exit 2
}
var repository = ARGV[0]
var evidence = ARGV[1]
var smali = ARGV[2]
var adb = ARGV[3]
var runner_sources = "$repository/examples/autogenerated/quick-settings-runtime"
var runtime = "$evidence/art"

for path in "$repository" "$evidence" "$smali" "$adb" {
  if (path[0] !== '/') {
    echo "FAIL absolute path required: $path"
    exit 2
  }
}
test -x "$adb"
test -s "$evidence/dex-sha256.txt"
sha256sum -c "$evidence/dex-sha256.txt"
test -s "$smali"
if test -e "$runtime" {
  echo "FAIL runtime evidence directory already exists: $runtime"
  exit 1
}
mkdir -p "$runtime"
"$adb" -s emulator-5554 get-state
"$adb" -s emulator-5554 shell getprop ro.build.fingerprint > "$runtime/fingerprint.txt"
"$adb" -s emulator-5554 shell getprop ro.product.cpu.abi > "$runtime/abi.txt"
"$adb" -s emulator-5554 shell getprop ro.build.version.sdk > "$runtime/sdk.txt"
"$adb" -s emulator-5554 shell mkdir -p /data/local/tmp/idric-quick-settings

proc run_candidate(candidate, source, runner, expected) {
  printf '\033[36mACTION\033[0m execute %s on emulator-5554\n' "$candidate"
  mkdir -p "$runtime/source-$candidate"
  cp "$runner_sources/$source" "$runtime/source-$candidate/"
  java -jar "$smali" assemble "$runtime/source-$candidate" -o "$runtime/$candidate-runner.dex"
  test -s "$runtime/$candidate-runner.dex"
  "$adb" -s emulator-5554 push "$evidence/$candidate.dex" "/data/local/tmp/idric-quick-settings/$candidate.dex"
  "$adb" -s emulator-5554 push "$runtime/$candidate-runner.dex" "/data/local/tmp/idric-quick-settings/$candidate-runner.dex"
  # Android 14's read-only dynamic-code rule applies before app_process loads.
  "$adb" -s emulator-5554 shell chmod 0444 "/data/local/tmp/idric-quick-settings/$candidate.dex" "/data/local/tmp/idric-quick-settings/$candidate-runner.dex"
  # Compare the bytes received by the emulator before executing them.
  "$adb" -s emulator-5554 pull "/data/local/tmp/idric-quick-settings/$candidate.dex" "$runtime/$candidate-received.dex"
  cmp "$evidence/$candidate.dex" "$runtime/$candidate-received.dex"
  "$adb" -s emulator-5554 pull "/data/local/tmp/idric-quick-settings/$candidate-runner.dex" "$runtime/$candidate-runner-received.dex"
  cmp "$runtime/$candidate-runner.dex" "$runtime/$candidate-runner-received.dex"
  "$adb" -s emulator-5554 shell \
    "CLASSPATH=/data/local/tmp/idric-quick-settings/$candidate-runner.dex:/data/local/tmp/idric-quick-settings/$candidate.dex app_process /system/bin $runner" \
    > "$runtime/$candidate.txt" 2>&1
  rg -q -x -F "$expected" "$runtime/$candidate.txt"
}

run_candidate effects ParcelEffectsRunner.smali Idric.ParcelEffectsRunner 'quick-settings source effects PASS'
run_candidate quick-settings QuickSettingsRunner.smali Idric.QuickSettingsRunner 'quick-settings callback payload PASS'
run_candidate invoke-range InvokeRangeRunner.smali Idric.InvokeRangeRunner 'DEX invoke range PASS'
run_candidate boolean BooleanRunner.smali Idric.BooleanRunner 'DEX Boolean ABI PASS'
echo 'PASS ART executed checked reference/effect/branch/range candidates on this emulator' > "$runtime/result.txt"
echo 'NOT_RUN TileService lifecycle, tile registration, SystemUI, physical device' >> "$runtime/result.txt"
printf '\033[32mPASS\033[0m ART executed checked reference/effect/branch/range candidates on this emulator\n'
printf '\033[33mNOT_RUN\033[0m TileService lifecycle, tile registration, SystemUI, physical device\n'
