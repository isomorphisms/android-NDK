#!/usr/bin/env grease
# Called after the exact frontend/bootstrap and compiler API are provisioned.
if (len(ARGV) !== 4) {
  echo 'usage: grease prepare-reconcile.grease REPOSITORY IDRIC_REPOSITORY SDK EVIDENCE'
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var sdk = ARGV[2]
var evidence = ARGV[3]
var compiler = "$frontend/_/build/exec/idris2"
var scheme = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
var packages = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PACKAGE_PATH = packages
grease "$repository/dex/idric/install-frontend.grease" "$frontend"
cd "$repository/dex/idric"
grease "$repository/dex/idric/tests/dex/source-boundary-self-test.grease" "$repository/dex/idric"
"$compiler" --build backend.ipkg
cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" build/exec/idric-dex_app/
mkdir -p "$evidence/oracles"
curl -fL https://github.com/baksmali/smali/releases/download/3.0.10/baksmali-3.0.10-fat-release.jar -o "$evidence/oracles/baksmali.jar"
curl -fL https://github.com/baksmali/smali/releases/download/3.0.10/smali-3.0.10-fat-release.jar -o "$evidence/oracles/smali.jar"
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$evidence/oracles/baksmali.jar" | sha256sum -c -
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$evidence/oracles/smali.jar" | sha256sum -c -
grease "$repository/dex/idric/verify-reconcile.grease" "$repository" "$compiler" \
  "$frontend/_/bootstrap-build" "$packages" "$scheme" \
  "$evidence/oracles/baksmali.jar" "$evidence/host"
grease "$repository/dex/idric/verify-sources.grease" "$repository" \
  "$repository/dex/idric/build/exec/idric-dex" "$repository/dex/idric/build/ttc" \
  "$sdk/build-tools/35.0.0/dexdump" "$evidence/sources"
grease "$repository/dex/idric/verify-adapters.grease" "$repository/dex/idric" \
  "$compiler" "$repository/dex/idric/build/ttc" "$evidence/oracles" "$evidence/adapters"
grease "$repository/examples/autogenerated/icu-runtime/prepare.grease" "$repository" \
  "$repository/dex/idric/build/exec/idric-dex" "$evidence/oracles/baksmali.jar" "$evidence/checked-arguments"
