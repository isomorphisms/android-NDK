#!/usr/bin/env grease
if (len(ARGV) !== 5) {
  echo 'usage: grease verify-adapters.grease PACKAGE COMPILER MODULES ORACLES EVIDENCE'
  exit 2
}
var package = ARGV[0]
var compiler = ARGV[1]
var modules = ARGV[2]
var oracles = ARGV[3]
var evidence = ARGV[4]
var repository = $(realpath "$package/../..")
mkdir -p "$evidence"
setglobal ENV.IDRIS2_PATH = modules
cd "$package"
"$compiler" --source-dir src --build-dir "$evidence/modules" --check src/Backend/DEX/EncodeNativeActivity.idr > "$evidence/wegert-check.txt" 2>&1
"$compiler" --source-dir src --build-dir "$evidence/modules" --check src/Backend/DEX/EncodeRedditCli.idr > "$evidence/reddit-check.txt" 2>&1
"$compiler" --source-dir src --build-dir "$evidence/modules" --check src/Backend/DEX/EncodeNativeActivityShell.idr > "$evidence/shell-check.txt" 2>&1
"$compiler" --source-dir src --build-dir "$evidence/modules" --check src/Backend/DEX/EncodeCallbackShell.idr > "$evidence/callback-check.txt" 2>&1
setglobal ENV.IDRIS2_PATH = "$evidence/modules/ttc:$modules"
proc generator(source, name) {
  "$compiler" -p idris2 --source-dir tests/dex --build-dir "$evidence/$name-build" \
    "tests/dex/$source" -o generator > "$evidence/$name-build.txt" 2>&1
  test -x "$evidence/$name-build/exec/generator"
  "$evidence/$name-build/exec/generator" > "$evidence/$name-generate.txt" 2>&1
}
mkdir -p build/exec/wegert build/exec/reddit build/exec/native-shell/wegert build/exec/native-shell/analytic-continuation
generator WegertDexGen.idr wegert
generator RedditCliDexGen.idr reddit
generator NativeActivityShellGen.idr shell
proc compare_oracle(source, candidate, class, name) {
  java -jar "$oracles/smali.jar" assemble "$source" -o "$evidence/$name-oracle.dex"
  java -jar "$oracles/baksmali.jar" disassemble "$candidate" -o "$evidence/$name-candidate"
  java -jar "$oracles/baksmali.jar" disassemble "$evidence/$name-oracle.dex" -o "$evidence/$name-reference"
  cmp "$evidence/$name-candidate/$class.smali" "$evidence/$name-reference/$class.smali"
  printf '%s\tPASS\n' "$name" >> "$evidence/receipt.tsv"
  sha256sum "$candidate" >> "$evidence/artifacts.sha256"
}
compare_oracle tests/dex/oracles/WegertActivity.smali build/exec/wegert/classes.dex org/isomorphisms/wegert/WegertActivity wegert
compare_oracle tests/dex/oracles/RedditCli.smali build/exec/reddit/classes.dex org/isomorphisms/reddit/RedditCli reddit
compare_oracle tests/dex/oracles/NativeActivityShell.smali build/exec/native-shell/wegert/classes.dex org/isomorphisms/wegert/WegertActivity shell
python3 tests/dex/check_dex.py build/exec/native-shell/analytic-continuation/classes.dex
mkdir -p build/exec/webview
"$compiler" -p idris2 --source-dir "$repository/examples/autogenerated/webview-shell" \
  --build-dir "$evidence/webview-build" \
  "$repository/examples/autogenerated/webview-shell/WebViewShell.idric" -o generator > "$evidence/webview-build.txt" 2>&1
"$evidence/webview-build/exec/generator" > "$evidence/webview-generate.txt" 2>&1
for name in classes.dex classes2.dex classes3.dex {
  python3 tests/dex/check_dex.py "build/exec/webview/$name"
  java -jar "$oracles/baksmali.jar" disassemble "build/exec/webview/$name" -o "$evidence/webview-$name"
}
rg -F '.method public native onCreate(Landroid/os/Bundle;)V' "$evidence/webview-classes.dex/org/isomorphisms/webview/BridgeActivity.smali"
rg -F '.method public native onMessage(Landroid/webkit/WebMessagePort;Landroid/webkit/WebMessage;)V' "$evidence/webview-classes3.dex/org/isomorphisms/webview/BridgeMessageCallback.smali"
"$compiler" -p idris2 --source-dir "$repository/examples/autogenerated/native-view-callback" \
  --build-dir "$evidence/view-build" \
  "$repository/examples/autogenerated/native-view-callback/ClickListener.idric" -o generator > "$evidence/view-build.txt" 2>&1
"$evidence/view-build/exec/generator" "$evidence/view.dex" > "$evidence/view-generate.txt" 2>&1
java -jar "$oracles/baksmali.jar" disassemble "$evidence/view.dex" -o "$evidence/view"
rg -F '.implements Landroid/view/View$OnClickListener;' "$evidence/view/org/isomorphisms/NativeClickListener.smali"
printf 'webview\tPASS\nview_callbacks\tPASS\n' >> "$evidence/receipt.tsv"
printf '\033[32mPASS\033[0m preserved Wegert, Reddit and NativeActivity shell instructions/metadata\n'
