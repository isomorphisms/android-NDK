#!/usr/bin/env grease

if (len(ARGV) !== 4) {
  echo 'usage: grease verify-callback-art.grease REPOSITORY EVIDENCE SMALI_JAR ADB' >&2
  exit 2
}
var repository = ARGV[0]
var evidence = ARGV[1]
var smali = ARGV[2]
var adb = ARGV[3]
for path in "$repository" "$evidence" "$smali" "$adb" {
  if (path[0] !== '/') { echo 'absolute path required' >&2; exit 2 }
}
test -x "$adb"
test -s "$smali"
rg -q -x -F 'PASS callback host controls, source refusals and deterministic recovery' "$evidence/result.txt"
var source = "$repository/examples/autogenerated/interface-callback"
if test -e "$evidence/art" { echo 'refusing reused callback runtime evidence' >&2; exit 1 }
mkdir -p "$evidence/art"
"$adb" -s emulator-5554 get-state > "$evidence/art/connection.txt"
rg -q -x -F device "$evidence/art/connection.txt"
# An observed emulator control endpoint is required before any target write.
"$adb" -s emulator-5554 emu avd name > "$evidence/art/emulator.txt"
"$adb" -s emulator-5554 shell getprop ro.build.version.sdk > "$evidence/art/sdk.txt"
"$adb" -s emulator-5554 shell getprop ro.product.cpu.abi > "$evidence/art/abi.txt"
java -jar "$smali" assemble "$source/ViewCallbackRunner.smali" \
  -o "$evidence/art/observer.dex" > "$evidence/art/observer-compile.txt" 2>&1
test -s "$evidence/art/observer.dex"
sha256sum "$source/ViewCallbackRunner.smali" "$evidence/art/observer.dex" > "$evidence/art/observer-sha256.txt"

for name in positive mutant recovery {
  var remote = "/data/local/tmp/idric-callback-$name"
  var candidate = "$evidence/$name/candidate.dex"
  test -s "$candidate"
  "$adb" -s emulator-5554 shell mkdir -p "$remote"
  "$adb" -s emulator-5554 shell rm -f "$remote/candidate.dex" "$remote/observer.dex"
  "$adb" -s emulator-5554 push "$candidate" "$remote/candidate.dex" > "$evidence/art/$name-push.txt" 2>&1
  "$adb" -s emulator-5554 push "$evidence/art/observer.dex" "$remote/observer.dex" >> "$evidence/art/$name-push.txt" 2>&1
  "$adb" -s emulator-5554 shell chmod 444 "$remote/candidate.dex" "$remote/observer.dex"
  "$adb" -s emulator-5554 pull "$remote/candidate.dex" "$evidence/art/$name-received.dex" > "$evidence/art/$name-pull.txt" 2>&1
  "$adb" -s emulator-5554 pull "$remote/observer.dex" "$evidence/art/$name-observer-received.dex" >> "$evidence/art/$name-pull.txt" 2>&1
  cmp "$candidate" "$evidence/art/$name-received.dex"
  cmp "$evidence/art/observer.dex" "$evidence/art/$name-observer-received.dex"
  try {
    "$adb" -s emulator-5554 shell app_process -cp "$remote/candidate.dex:$remote/observer.dex" \
      /system/bin ViewCallbackRunner > "$evidence/art/$name.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/art/$name.status"
  cat "$evidence/art/$name.txt"
  if (name === 'mutant') {
    test "$status" = 73
    rg -q -x -F 'FAIL checked Idric framework click and exact text' "$evidence/art/$name.txt"
    try { rg -q -x -F 'PASS checked Idric framework click and exact text' "$evidence/art/$name.txt" }
    var marker_status = _error.code
    test "$marker_status" = 1
  } else {
    test "$status" = 0
    rg -q -x -F 'PASS checked Idric framework click and exact text' "$evidence/art/$name.txt"
  }
}
echo 'PASS original and recovery framework callbacks; source action mutant rejected on ART' > "$evidence/art/result.txt"
echo 'Framework View transition-name transport; Material 3 display, APK and physical device NOT_RUN' >> "$evidence/art/result.txt"
cat "$evidence/art/result.txt"
