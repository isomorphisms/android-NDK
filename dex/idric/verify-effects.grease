#!/usr/bin/env grease

# Host verification only. The candidate is emitted by the checked DEX backend.
# Arguments are absolute paths, so invoking this script needs no prior cd.
if (len(ARGV) !== 5) {
  echo 'usage: grease verify-effects.grease REPOSITORY IDRIC_REPOSITORY CHEZ DEXDUMP OUTPUT_DIRECTORY'
  exit 2
}

var repository = ARGV[0]
var compiler_repository = ARGV[1]
var chez = ARGV[2]
var dexdump = ARGV[3]
var evidence = ARGV[4]
var compiler = "$compiler_repository/_/build/exec/idris2"
var compiler_prefix = "$compiler_repository/_/bootstrap-build"
var support = "$compiler_repository/_/build/exec/idris2_app/libidris2_support.so"
var compiler_modules = "$compiler_repository/_/build/ttc"
var base_modules = "$compiler_repository/_/libs/base/build/ttc"
var prelude_modules = "$compiler_repository/_/libs/prelude/build/ttc"
var backend = "$repository/dex/idric"
var driver = "$evidence/backend/exec/idric-dex"

proc section(message) {
  printf '\033[36mACTION\033[0m %s\n' "$message"
}

proc require_file(path) {
  if ! test -s "$path" {
    printf '\033[31mFAIL\033[0m required new artifact is absent or empty: %s\n' "$path"
    exit 1
  }
}

proc require_clean_log(path) {
  if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$path" {
    printf '\033[31mFAIL\033[0m compiler reported an error: %s\n' "$path"
    exit 1
  }
}

for path in "$repository" "$compiler_repository" "$chez" "$dexdump" "$evidence" {
  if (path[0] !== '/') {
    echo "FAIL absolute path required: $path"
    exit 2
  }
}
test -x "$compiler"
test -x "$chez"
test -x "$dexdump"
require_file "$support"
require_file "$compiler_prefix/idris2-0.8.0/idris2-0.8.0/idris2.ipkg"
if test -e "$evidence" {
  echo "FAIL evidence directory already exists: $evidence"
  exit 1
}
mkdir -p "$evidence"

section 'Build the checked DEX driver'
cd "$backend"
env IDRIS2_PREFIX="$compiler_prefix" IDRIS2_CG=chez CHEZ="$chez" \
  IDRIS2_PATH="$compiler_modules:$base_modules:$prelude_modules" \
  "$compiler" --build-dir "$evidence/backend" --output-dir "$evidence/backend/exec" \
  --build backend.ipkg > "$evidence/backend-build.txt" 2>&1
require_clean_log "$evidence/backend-build.txt"
require_file "$driver"
require_file "$evidence/backend/exec/idric-dex_app/idric-dex.so"
cp "$support" "$evidence/backend/exec/idric-dex_app/"
env IDRIS2_PREFIX="$compiler_prefix" "$driver" --version > "$evidence/driver-version.txt"

proc run_host_check(directory, source, name, expected) {
  section "Run $name on the host"
  env IDRIS2_PREFIX="$compiler_prefix" IDRIS2_CG=chez CHEZ="$chez" \
    IDRIS2_PATH="$evidence/backend/ttc:$compiler_modules:$base_modules:$prelude_modules" \
    "$compiler" --build-dir "$evidence/check-$name" --source-dir "$directory" \
    "$directory/$source" -o "$name" > "$evidence/$name.build.txt" 2>&1
  require_clean_log "$evidence/$name.build.txt"
  require_file "$evidence/check-$name/exec/$name"
  require_file "$evidence/check-$name/exec/${name}_app/$name.so"
  cp "$support" "$evidence/check-$name/exec/${name}_app/"
  "$evidence/check-$name/exec/$name" > "$evidence/$name.result.txt" 2>&1
  rg -q -x -F "$expected" "$evidence/$name.result.txt"
}

run_host_check "$repository/examples/autogenerated/dex-invoke-range" DexInvocationChecks.idric invocation-checks 'PASS: DEX invocation placement and word counts'
run_host_check "$backend/tests/dex" ForeignSpecTest.idr foreign-spec-checks 'PASS: DEX foreign convention parser'
run_host_check "$backend/tests/dex" EncoderSelfTest.idr encoder-checks 'PASS: DEX encoder self-test'

# Do not trust this compiler's exit status alone: its historical driver can
# print a rejection and return zero. Every positive case requires a fresh DEX.
proc compile_source(directory, source, name) {
  section "Compile and independently parse $name"
  env IDRIS2_PREFIX="$compiler_prefix" \
    IDRIS2_PATH="$evidence/backend/ttc:$evidence/bindings/ttc:$base_modules:$prelude_modules" \
    "$driver" --cg dex --source-dir "$directory" \
    --build-dir "$evidence/source-$name" --output-dir "$evidence" \
    --dumpanf "$evidence/$name.anf" "$directory/$source" -o "$name" \
    > "$evidence/$name.compile.txt" 2>&1
  require_clean_log "$evidence/$name.compile.txt"
  require_file "$evidence/$name.dex"
  require_file "$evidence/$name.dex.plan"
  require_file "$evidence/$name.checked.anf"
  require_file "$evidence/$name.smali"
  "$dexdump" -c "$evidence/$name.dex" > "$evidence/$name.checksum.txt" 2>&1
  "$dexdump" -d "$evidence/$name.dex" > "$evidence/$name.disassembly.txt" 2>&1
}

compile_source "$backend/examples" DexArithmetic.idric arithmetic
compile_source "$backend/examples" DexText.idric text
compile_source "$backend/examples" DexForeign.idric pure-foreign
compile_source "$repository/examples/autogenerated/quick-settings-source-effects" QuickSettingsSourceEffects.idric effects
compile_source "$repository/examples/autogenerated/dex-invoke-range" DexInvokeRange.idric invoke-range

cd "$repository/quick-settings/idric"
env IDRIS2_PREFIX="$compiler_prefix" IDRIS2_PATH="$base_modules:$prelude_modules" \
  "$compiler" --build-dir "$evidence/bindings" \
  --typecheck idric-android-quick-settings.ipkg > "$evidence/bindings-source.txt" 2>&1
require_clean_log "$evidence/bindings-source.txt"
compile_source "$repository/examples/autogenerated/quick-settings-runtime" QuickSettingsRuntime.idric quick-settings
compile_source "$repository/examples/autogenerated/quick-settings-source-effects" QuickSettingsBoolean.idric boolean

compile_source "$repository/examples/autogenerated/quick-settings-runtime" QuickSettingsRuntime.idric quick-settings-repeat
cmp "$evidence/quick-settings.dex" "$evidence/quick-settings-repeat.dex"
echo 'PASS repeated checked-source compilation produced identical DEX bytes' > "$evidence/determinism.txt"

proc expect_refusal(directory, source, name, expected) {
  section "Verify checked-source refusal: $name"
  env IDRIS2_PREFIX="$compiler_prefix" \
    IDRIS2_PATH="$evidence/bindings/ttc:$base_modules:$prelude_modules" \
    "$compiler" --check --source-dir "$directory" --build-dir "$evidence/check-source-$name" \
    "$directory/$source" > "$evidence/$name.source.txt" 2>&1
  require_clean_log "$evidence/$name.source.txt"
  if env IDRIS2_PREFIX="$compiler_prefix" \
    IDRIS2_PATH="$evidence/bindings/ttc:$base_modules:$prelude_modules" \
    "$driver" --cg dex --source-dir "$directory" --build-dir "$evidence/refusal-$name" \
    --output-dir "$evidence" "$directory/$source" -o "$name" \
    > "$evidence/$name.refusal.txt" 2>&1 {
    echo 'Compiler exited zero; acceptance depends on the rejection and absent artifact.' > "$evidence/$name.exit.txt"
  } else {
    echo 'Compiler exited nonzero.' > "$evidence/$name.exit.txt"
  }
  rg -q -F "$expected" "$evidence/$name.refusal.txt"
  if test -e "$evidence/$name.dex" {
    echo "FAIL rejected source produced a DEX artifact: $name"
    exit 1
  }
}

expect_refusal "$repository/examples/autogenerated/quick-settings-source-effects" OrdinaryReferenceRefusal.idric ordinary-reference 'ordinary algebraic data, not an external reference'
expect_refusal "$repository/examples/autogenerated/quick-settings-source-effects" ConflictingReferenceRefusal.idric conflicting-reference 'has conflicting descriptors'
expect_refusal "$repository/examples/autogenerated/quick-settings-runtime" UnprojectedTileState.idric unprojected-result 'dex rejected source ABI'

git -C "$repository" rev-parse HEAD > "$evidence/backend-revision.txt"
git -C "$repository" diff --binary HEAD > "$evidence/backend-local.patch"
git -C "$compiler_repository" rev-parse HEAD > "$evidence/compiler-revision.txt"
sha256sum "$evidence/arithmetic.dex" "$evidence/text.dex" \
  "$evidence/pure-foreign.dex" "$evidence/effects.dex" \
  "$evidence/invoke-range.dex" "$evidence/quick-settings.dex" \
  "$evidence/boolean.dex" > "$evidence/dex-sha256.txt"
echo 'PASS checked source emitted independently parsed DEX' > "$evidence/host-result.txt"
echo 'NOT_RUN ART execution; this script is host verification only' >> "$evidence/host-result.txt"
printf '\033[32mPASS\033[0m checked source emitted independently parsed DEX\n'
printf '\033[33mNOT_RUN\033[0m ART execution; this script is host verification only\n'
