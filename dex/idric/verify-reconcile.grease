#!/usr/bin/env grease
# Explicit pinned host inputs; no phone-side compiler or source build.
if (len(ARGV) !== 7 and len(ARGV) !== 8) {
  echo 'usage: grease verify-reconcile.grease REPOSITORY IDRIC PREFIX PACKAGES SCHEME BAKSMALI EVIDENCE'
  exit 2
}
var repository = ARGV[0]
var compiler = ARGV[1]
var prefix = ARGV[2]
var packages = ARGV[3]
var scheme = ARGV[4]
var baksmali = ARGV[5]
var evidence = ARGV[6]
var backend = "$repository/dex/idric"
var modules = "$backend/build/ttc"
if (len(ARGV) === 8) { setvar modules = ARGV[7] }
setglobal ENV.IDRIS2_PREFIX = prefix
setglobal ENV.IDRIS2_PACKAGE_PATH = packages
setglobal ENV.CHEZ = scheme
setglobal ENV.IDRIS2_CG = 'chez'
setglobal ENV.IDRIS2_PATH = modules
if test -e "$evidence" { echo 'FAIL: evidence directory already exists'; exit 1 }
mkdir -p "$evidence"
cd "$backend"
proc clean_log(path) {
  if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$path" {
    echo "FAIL compiler diagnostic: $path"
    exit 1
  }
}
proc host_check(directory, file, name, marker) {
  printf '\033[36mACTION\033[0m %s\n' "$name"
  "$compiler" -p idris2 --source-dir "$directory" --build-dir "$evidence/$name-build" \
    "$directory/$file" -o "$name" > "$evidence/$name-build.txt" 2>&1
  clean_log "$evidence/$name-build.txt"
  test -x "$evidence/$name-build/exec/$name"
  "$evidence/$name-build/exec/$name" > "$evidence/$name.txt" 2>&1
  rg -x -F "$marker" "$evidence/$name.txt"
  printf '%s\tPASS\n' "$name" >> "$evidence/host.tsv"
}
host_check "$backend/tests/dex" EncoderSelfTest.idr encoder 'PASS: DEX encoder self-test'
host_check "$backend/tests/dex" ArgvBridgeTest.idr argv 'PASS: DEX ART argument-array bridge plan and refusal controls'
host_check "$backend/tests/dex" RuntimeArgsTest.idr runtime-args 'PASS: reusable Idriç ART runtime arguments and wrong-count mutation'
host_check "$backend/tests/dex" ForeignSpecTest.idr foreign 'PASS: DEX foreign convention parser'
host_check "$backend/tests/dex" FinalizedLayoutCheck.idr layout 'PASS: DEX finalized plan and readable evidence'
host_check "$backend/tests/dex" FrameworkClassesTest.idr framework 'PASS: class encoder, deterministic output, eight rejection cases'
host_check "$backend/tests/dex" FrameworkInterfacesTest.idric interfaces 'PASS interface plan and two hostile cases'
host_check "$repository/examples/autogenerated/checked-calls" SharedClassTest.idric shared-class 'PASS shared class encoder, deterministic ordering and eleven refusals'
host_check "$repository/examples/autogenerated/dex-invoke-range" DexInvocationChecks.idric invocation 'PASS: DEX invocation placement and word counts'
host_check "$repository/examples/autogenerated/dex-constant-tags" DexConstantTagChecks.idric boolean-tags 'PASS: DEX bounded compiler Boolean tags'
host_check "$repository/examples/autogenerated/interface-callback" CallbackPlanChecks.idric callbacks 'PASS callback typed-plan controls'
host_check "$repository/examples/autogenerated/activity-adapter" ActivityPlanChecks.idric activity 'PASS Activity typed-plan controls'
host_check "$repository/examples/autogenerated/source-loop-values" LoopValueChecks.idric loop-values 'PASS source loop-value semantics'
host_check "$repository/examples/autogenerated/source-loop-values" StringEncodingChecks.idric strings 'PASS DEX string data and ordering'
java -jar "$baksmali" disassemble build/shared-class-test.dex -o "$evidence/shared-classes"
java -jar "$baksmali" disassemble build/array-boundary.dex -o "$evidence/array-boundary"
java -jar "$baksmali" disassemble build/argv-boundary.dex -o "$evidence/argv-boundary"
java -jar "$baksmali" disassemble build/runtime-arguments.dex -o "$evidence/runtime-arguments"
rg -F '.field private static __idric_arguments:[Ljava/lang/String;' "$evidence/runtime-arguments/Idric/RuntimeArguments.smali"
rg -F '.method public static main([Ljava/lang/String;)V' "$evidence/runtime-arguments/Idric/RuntimeArguments.smali"
rg -F 'add-long ' "$evidence/runtime-arguments/Idric/RuntimeArguments.smali"
rg -F 'toIntExact(J)I' "$evidence/runtime-arguments/Idric/RuntimeArguments.smali"
rg -F '.method public static commandLineCount([Ljava/lang/String;)J' "$evidence/argv-boundary/Idric/ArgvBoundary.smali"
rg -F 'array-length ' "$evidence/argv-boundary/Idric/ArgvBoundary.smali"
rg -F 'aget-object ' "$evidence/argv-boundary/Idric/ArgvBoundary.smali"
rg -F 'int-to-long ' "$evidence/argv-boundary/Idric/ArgvBoundary.smali"
rg -F '.method public static answer()I' "$evidence/shared-classes/example/Checked.smali"
rg -F '.method public native answer(ILjava/lang/String;)I' "$evidence/shared-classes/example/Callback.smali"
rg -F '.method public native wide(JDFBCS)D' "$evidence/shared-classes/example/Callback.smali"
rg -F '.method static constructor <clinit>()V' "$evidence/shared-classes/example/Callback.smali"
rg -F '.method public static native ping()V' "$evidence/shared-classes/example/NativeOnly.smali"
sha256sum build/shared-class-test.dex > "$evidence/shared-classes.sha256"
printf '\033[32mPASS\033[0m canonical host regressions and independent shared-class decode\n'
