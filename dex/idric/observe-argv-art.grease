#!/usr/bin/env grease
# Independent ART observer of direct DEX argument-array methods. The smali
# runner supplies only assertions and program entry; not the target methods.
if (len(ARGV) !== 6) {
  echo 'usage: grease observe-argv-art.grease ADB SERIAL CANDIDATE RUNNER WRONG EVIDENCE'
  exit 2
}
var adb = ARGV[0]
var serial = ARGV[1]
var candidate = ARGV[2]
var runner = ARGV[3]
var wrong = ARGV[4]
var evidence = ARGV[5]
mkdir -p "$evidence"
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x '1'
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x 'x86_64'
"$adb" -s "$serial" shell mkdir -p /data/local/tmp/idric-argv
"$adb" -s "$serial" push "$candidate" /data/local/tmp/idric-argv/candidate.dex
"$adb" -s "$serial" push "$runner" /data/local/tmp/idric-argv/observer.dex
"$adb" -s "$serial" push "$wrong" /data/local/tmp/idric-argv/wrong.dex
timeout 90 "$adb" -s "$serial" shell 'CLASSPATH=/data/local/tmp/idric-argv/candidate.dex:/data/local/tmp/idric-argv/observer.dex app_process /system/bin acceptance.ArgvObserver' > "$evidence/zero.txt" 2>&1
rg -x -F 'PASS argv: zero program arguments' "$evidence/zero.txt"
timeout 90 "$adb" -s "$serial" shell 'CLASSPATH=/data/local/tmp/idric-argv/candidate.dex:/data/local/tmp/idric-argv/observer.dex app_process /system/bin acceptance.ArgvObserver first second' > "$evidence/two.txt" 2>&1
rg -x -F 'PASS argv: two program arguments' "$evidence/two.txt"
if timeout 90 "$adb" -s "$serial" shell 'CLASSPATH=/data/local/tmp/idric-argv/wrong.dex:/data/local/tmp/idric-argv/observer.dex app_process /system/bin acceptance.ArgvObserver first second' > "$evidence/wrong.txt" 2>&1 {
  echo 'FAIL: wrong compiled argument count passed the independent ART observer'
  exit 1
} else {
  var status = $?
  printf '%s\n' "$status" > "$evidence/wrong-status.txt"
  test "$status" -eq 73
}
"$adb" -s "$serial" pull /data/local/tmp/idric-argv/candidate.dex "$evidence/received.dex"
cmp "$candidate" "$evidence/received.dex"
sha256sum "$candidate" "$runner" "$wrong" > "$evidence/artifacts.sha256"
printf 'real_ART_argv\tPASS\nzero_args\tPASS\ntwo_args\tPASS\nwrong_count\tREJECTED\nsource_System_getArgs\tNOT_IMPLEMENTED\nphysical_A1\tNOT_VERIFIED\nphysical_C67\tNOT_VERIFIED\n' > "$evidence/receipt.tsv"
printf '\033[32mPASS\033[0m direct DEX argument read and compiled wrong-count rejection on emulator ART\n'
