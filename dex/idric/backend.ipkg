package idric_dex
version = 0.2.0

sourcedir = "src"

depends = idris2

modules =
  Backend.DEX.IR,
  Backend.DEX.Placement,
  Backend.DEX.Invoke,
  Backend.DEX.Foreign,
  Backend.DEX.Callback,
  Backend.DEX.Lower,
  Backend.DEX.Unpack,
  Backend.DEX.Hash,
  Backend.DEX.Encode,
  Backend.DEX.FrameworkClasses,
  Backend.DEX.EncodeCallbackShell,
  Backend.DEX.Smali,
  Backend.DEX.Codegen,
  Backend.DEX.Main

main = Backend.DEX.Main
executable = idric-dex
