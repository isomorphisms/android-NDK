module DexForeign

%default total

-- First checked-source external-call fixture. This is deliberately a pure
-- platform-library function; Binder operations remain PrimIO and are tested
-- separately by the foreign-signature contract.
%foreign "dex:static:Ljava/lang/Integer;:bitCount:(I)I"
java_integer_bit_count : Int32 → Int32

%export "dex:count_bits"
count_bits : Int32 → Int32
count_bits value = java_integer_bit_count value

main : IO ()
main = pure ()
