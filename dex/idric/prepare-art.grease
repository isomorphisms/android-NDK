#!/usr/bin/env grease
if (len(ARGV) !== 4) {
  echo 'usage: grease prepare-art.grease REPOSITORY AICI DRIVER EVIDENCE'
  exit 2
}
var repository = ARGV[0]
var aici = ARGV[1]
var driver = ARGV[2]
var evidence = ARGV[3]
var original = "$repository/examples/autogenerated/checked-calls"
cp -R "$original" "$evidence/mutant-source"
sed 's/value + 7/value + 8/' "$original/CheckedHelpers.idric" > "$evidence/mutant-source/CheckedHelpers.idric"
rg -x -F 'bump value = value + 8' "$evidence/mutant-source/CheckedHelpers.idric"
if cmp -s "$original/CheckedHelpers.idric" "$evidence/mutant-source/CheckedHelpers.idric" {
  echo 'FAIL mutation did not change the actual checked helper'
  exit 1
}
"$driver" --cg dex --source-dir "$evidence/mutant-source" \
  --build-dir "$evidence/mutant-build" --output-dir "$evidence" \
  "$evidence/mutant-source/CheckedCalls.idric" -o mutant > "$evidence/mutant-build.txt" 2>&1
test -s "$evidence/mutant.dex"
rg 'invoke-static' "$evidence/sources/calls-disassembly.txt"
java -jar "$evidence/oracles/smali.jar" assemble "$aici/dex/CheckedCallsRunner.smali" -o "$evidence/runner.dex"
test -s "$evidence/runner.dex"
# The independently assembled observation program supplies no target methods.
java -jar "$evidence/oracles/smali.jar" assemble "$repository/dex/idric/tests/dex/runtime/ArgvObserver.smali" -o "$evidence/argv-runner.dex"
test -s "$evidence/argv-runner.dex"
java -jar "$evidence/oracles/smali.jar" assemble "$repository/dex/idric/tests/dex/runtime/RuntimeArgObserver.smali" -o "$evidence/runtime-arg-runner.dex"
test -s "$evidence/runtime-arg-runner.dex"
test -s "$repository/dex/idric/build/runtime-arguments.dex"
test -s "$repository/dex/idric/build/runtime-arguments-wrong.dex"
test -s "$repository/dex/idric/build/argv-boundary.dex"
test -s "$repository/dex/idric/build/argv-wrong.dex"
