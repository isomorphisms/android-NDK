#!/usr/bin/env grease
# Run after building the canonical driver. Compiler/package environment is
# supplied explicitly by the caller, as in verify-reconcile.grease.
if (len(ARGV) !== 5) {
  echo 'usage: grease verify-sources.grease REPOSITORY DRIVER MODULES DEXDUMP EVIDENCE'
  exit 2
}
var repository = ARGV[0]
var driver = ARGV[1]
var modules = ARGV[2]
var dexdump = ARGV[3]
var evidence = ARGV[4]
var backend = "$repository/dex/idric"
setglobal ENV.IDRIS2_PATH = modules
if test -e "$evidence" { echo 'FAIL evidence directory already exists'; exit 1 }
mkdir -p "$evidence"
proc candidate(directory, source, name) {
  "$driver" --cg dex --source-dir "$directory" --build-dir "$evidence/$name-build" \
    --output-dir "$evidence" "$directory/$source" -o "$name" > "$evidence/$name.log" 2>&1
  if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$evidence/$name.log" {
    echo 'FAIL: compiler diagnostic in positive source'
    exit 1
  }
  test -s "$evidence/$name.dex"
  "$dexdump" -c "$evidence/$name.dex" > "$evidence/$name-checksum.txt" 2>&1
  "$dexdump" -d "$evidence/$name.dex" > "$evidence/$name-disassembly.txt" 2>&1
  printf '%s\tPASS\n' "$name" >> "$evidence/sources.tsv"
  sha256sum "$evidence/$name.dex" >> "$evidence/artifacts.sha256"
}
candidate "$backend/examples" DexArithmetic.idric arithmetic
candidate "$backend/examples" DexText.idric text
candidate "$backend/examples" DexForeign.idric foreign
candidate "$backend/tests/source" LayoutText.idric layout
candidate "$repository/examples/autogenerated/checked-calls" CheckedCalls.idric calls
candidate "$repository/examples/autogenerated/checked-calls" CheckedCalls.idric calls-repeat
cmp "$evidence/calls.dex" "$evidence/calls-repeat.dex"
candidate "$repository/examples/autogenerated/activity-adapter" ActivitySource.idric activity
candidate "$repository/examples/autogenerated/interface-callback" ViewCallbackSource.idric callback
candidate "$repository/examples/autogenerated/source-loop-values" LoopValues.idric loop-values
if "$driver" --cg dex --source-dir "$backend/tests/source" \
  --build-dir "$evidence/refusal-build" --output-dir "$evidence" \
  "$backend/tests/source/InvalidDexInt.idric" -o refused > "$evidence/refusal.log" 2>&1 {
  echo 'FAIL unsupported source returned success'
  exit 1
} else {
  var refusal_status = $?
  test "$refusal_status" -eq 1
}
rg -F 'dex rejected source ABI' "$evidence/refusal.log"
test ! -e "$evidence/refused.dex"
printf '\033[32mPASS\033[0m canonical checked source generation, refusal and determinism\n'
