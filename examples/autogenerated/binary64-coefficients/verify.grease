#!/usr/bin/env grease
if (len(ARGV) !== 5) {
  echo 'usage: grease verify.grease REPOSITORY FRONTEND FRESH_EVIDENCE BAKSMALI SMALI' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var evidence = ARGV[2]
var baksmali = ARGV[3]
var smali = ARGV[4]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL refusing reused evidence' >&2; exit 1 }
command -v rg > /dev/null
test $(git -C "$frontend" rev-parse HEAD) = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
var compiler = "$frontend/_/build/exec/idris2"
var backend = "$repository/dex/idric"
var driver = "$backend/build/exec/idric-dex"
var example = "$repository/examples/autogenerated/binary64-coefficients"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$backend/build/ttc"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/support/c"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
mkdir -p "$evidence/plan" "$evidence/host" "$evidence/positive" "$evidence/repeat" "$evidence/mutant/source" \
  "$evidence/platform" "$evidence/platform-repeat" "$evidence/platform-mutant/source"
git -C "$repository" rev-parse HEAD > "$evidence/backend-base.txt"
git -C "$repository" diff -- dex/idric/src dex/idric/backend.ipkg > "$evidence/backend.patch"
sha256sum "$example/Binary64Source.idric" "$example/Binary64Operators.idr" "$example/Binary64PlanCheck.idr" \
  "$example/PlatformCoefficient.idric" > "$evidence/source.sha256"
make -C "$backend" driver IDRIC="$compiler"

proc absent_pattern(pattern, path, message) {
  try { rg -n "$pattern" "$path" }
  var status = _error.code
  if (status === 0) { echo "FAIL $message" >&2; exit 1 }
  if (status !== 1) { echo "FAIL diagnostic/opcode checker failed: $path" >&2; exit 1 }
}
proc no_diagnostics(log) {
  absent_pattern '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" 'compiler returned success with diagnostics'
}
proc different_files(first, second) {
  try { cmp -s "$first" "$second" }
  var status = _error.code
  if (status === 0) { echo 'FAIL unchanged source mutation or candidate' >&2; exit 1 }
  if (status !== 1) { echo 'FAIL mutation comparison could not read both files' >&2; exit 1 }
}
proc host_check(module, suffix, marker) {
  "$compiler" -p idris2 --source-dir "$example" --build-dir "$evidence/$suffix/build" \
    --output-dir "$evidence/$suffix" "$example/$module" -o check \
    > "$evidence/$suffix/compiler.txt" 2>&1
  no_diagnostics "$evidence/$suffix/compiler.txt"
  cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$evidence/$suffix/check_app/"
  "$evidence/$suffix/check" > "$evidence/$suffix/output.txt" 2>&1
  cat "$evidence/$suffix/output.txt"
  rg -x -F "$marker" "$evidence/$suffix/output.txt"
}
printf '\033[36mACTION\033[0m binary64 literal bits, opcode bytes and paired layout\n'
host_check Binary64PlanCheck.idr plan 'PASS binary64 literal, encoder and placement checks'
host_check Binary64Source.idric host 'PASS managed binary64 coefficients'

proc emit_source(directory, module, output) {
  try {
    "$driver" --cg dex --directive managed-exports --source-dir "$directory" \
      --build-dir "$output/build" --output-dir "$output" \
      "$directory/$module.idric" -o candidate > "$output/compiler.txt" 2>&1
  }
  var status = _error.code
  cat "$output/compiler.txt"
  if (status !== 0) { echo 'FAIL checked binary64 source-to-DEX' >&2; exit 1 }
  no_diagnostics "$output/compiler.txt"
  test -s "$output/candidate.dex"
  java -jar "$baksmali" disassemble "$output/candidate.dex" -o "$output/decoded"
}
printf '\033[36mACTION\033[0m emit actual checked source and decode independently\n'
emit_source "$example" Binary64Source "$evidence/positive"
emit_source "$example" Binary64Source "$evidence/repeat"
cmp "$evidence/positive/candidate.dex" "$evidence/repeat/candidate.dex"
var decoded = "$evidence/positive/decoded/Idric/Generated.smali"
for opcode in add-double sub-double mul-double div-double neg-double cmpl-double cmpg-double {
  rg -F "$opcode" "$decoded"
}
absent_pattern 'add-float|sub-float|mul-float|div-float|neg-float' "$decoded" 'explicit binary64 source narrowed to Float32'
rg -x -F '.method public static binary64_observation(Ljava/lang/String;)I' "$decoded"
sed 's/16777217.0 + step/subtract_coefficients 16777217.0 step/' "$example/Binary64Source.idric" \
  > "$evidence/mutant/source/Binary64Source.idric"
cp "$example/Binary64Operators.idr" "$evidence/mutant/source/"
different_files "$example/Binary64Source.idric" "$evidence/mutant/source/Binary64Source.idric"
emit_source "$evidence/mutant/source" Binary64Source "$evidence/mutant"
different_files "$evidence/positive/candidate.dex" "$evidence/mutant/candidate.dex"
java -jar "$smali" assemble "$example/Binary64Runner.smali" -o "$evidence/runner.dex"
printf '\033[36mACTION\033[0m compile original-jsurf platform coefficient contracts\n'
emit_source "$example" PlatformCoefficient "$evidence/platform"
emit_source "$example" PlatformCoefficient "$evidence/platform-repeat"
cmp "$evidence/platform/candidate.dex" "$evidence/platform-repeat/candidate.dex"
var platform_decoded = "$evidence/platform/decoded/Idric/Generated.smali"
for signature in \
  'Ljava/lang/Double;->parseDouble(Ljava/lang/String;)D' \
  'Ljava/lang/Math;->sqrt(D)D' \
  'Ljava/lang/Math;->pow(DD)D' \
  'Ljava/lang/Double;->doubleToLongBits(D)J' \
  'Ljava/lang/Long;->toHexString(J)Ljava/lang/String;' {
  rg -F "$signature" "$platform_decoded"
}
absent_pattern '^\.method public static main\(' "$platform_decoded" 'pure coefficient exports acquired a command entry'
sed 's/parse_jsurf_coefficient input/parse_jsurf_coefficient "0.4"/g' \
  "$example/PlatformCoefficient.idric" > "$evidence/platform-mutant/source/PlatformCoefficient.idric"
cp "$example/Binary64Operators.idr" "$evidence/platform-mutant/source/"
different_files "$example/PlatformCoefficient.idric" "$evidence/platform-mutant/source/PlatformCoefficient.idric"
emit_source "$evidence/platform-mutant/source" PlatformCoefficient "$evidence/platform-mutant"
different_files "$evidence/platform/candidate.dex" "$evidence/platform-mutant/candidate.dex"
java -jar "$smali" assemble "$example/PlatformCoefficientRunner.smali" -o "$evidence/platform-runner.dex"

proc refuse_source(module, diagnostic) {
  var output = "$evidence/refuse-$module"
  mkdir -p "$output"
  "$driver" --source-dir "$example" --build-dir "$output/check" \
    --check "$example/$module.idric" > "$output/typecheck.txt" 2>&1
  no_diagnostics "$output/typecheck.txt"
  try {
    "$driver" --cg dex --directive managed-exports --source-dir "$example" \
      --build-dir "$output/build" --output-dir "$output" \
      "$example/$module.idric" -o candidate > "$output/compiler.txt" 2>&1
  }
  var status = _error.code
  cat "$output/compiler.txt"
  printf '%s\n' "$status" > "$output/compiler.exit"
  if (status !== 1) { echo "FAIL intended source refusal missing: $module" >&2; exit 1 }
  test ! -e "$output/candidate.dex"
  rg -F "$diagnostic" "$output/compiler.txt"
}
refuse_source WrongDoubleResult 'dex foreign result type does not match'
refuse_source WrongDoubleArgument 'dex foreign argument types do not match'
refuse_source UnsupportedFloat 'Unsupported DEX descriptor type'
refuse_source UnsupportedArray 'DEX array descriptors are outside the checked foreign-call slice'
refuse_source UnsupportedDoubleExport 'dex rejected source ABI'
refuse_source UnsupportedTextCast 'Managed DEX unsupported Text numeric target Double'
sha256sum "$evidence/positive/candidate.dex" "$evidence/mutant/candidate.dex" "$evidence/runner.dex" \
  "$evidence/platform/candidate.dex" "$evidence/platform-mutant/candidate.dex" "$evidence/platform-runner.dex" > "$evidence/candidates.sha256"
printf 'host_numeric_reference\tPASS\nencoder_layout\tPASS\nchecked_source_Dex\tPASS\nindependent_decode\tPASS\ndeterminism\tPASS\nART\tNOT_RUN\n' > "$evidence/result.tsv"
printf '\033[32mPASS\033[0m binary64 host, encoder, checked source and decoder; ART separate\n'
