#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) { echo 'requires BACKEND FRONTEND BAKSMALI NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var baksmali = ARGV[2]
var evidence = ARGV[3]
for path in "$repository" "$frontend" "$baksmali" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused export alias evidence' >&2; exit 2 }
mkdir -p "$evidence/mutant-source"
var source = "$repository/examples/autogenerated/export-aliases"
var driver = "$repository/dex/idric/build/exec/idric-dex"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$repository/dex/idric/build/ttc"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.LD_LIBRARY_PATH = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
proc compile(lane, directory) {
  mkdir "$evidence/$lane"
  "$driver" --cg dex --directive managed-exports --source-dir "$directory" \
    --build-dir "$evidence/$lane/build" --output-dir "$evidence/$lane" \
    "$directory/ExportAliases.idric" -o candidate > "$evidence/$lane/compiler.txt" 2>&1
  if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/$lane/compiler.txt" { exit 1 }
  test -s "$evidence/$lane/candidate.dex"
  java -jar "$baksmali" disassemble "$evidence/$lane/candidate.dex" -o "$evidence/$lane/decoded"
}
compile managed "$source"
compile repeat "$source"
cmp "$evidence/managed/candidate.dex" "$evidence/repeat/candidate.dex"
sed 's/add_counter counter amount/add_counter counter 1/' "$source/ExportAliases.idric" > "$evidence/mutant-source/ExportAliases.idric"
if cmp -s "$source/ExportAliases.idric" "$evidence/mutant-source/ExportAliases.idric" { exit 1 }
compile mutant "$evidence/mutant-source"
if cmp -s "$evidence/managed/candidate.dex" "$evidence/mutant/candidate.dex" { exit 1 }
mkdir "$evidence/refused"
try {
  "$driver" --cg dex --directive managed-exports --source-dir "$source" \
    --build-dir "$evidence/refused/build" --output-dir "$evidence/refused" \
    "$source/InvalidExport.idric" -o candidate > "$evidence/refused/compiler.txt" 2>&1
}
if (_error.code !== 1) { echo 'FAIL ordinary data alias escaped the source ABI' >&2; exit 1 }
test ! -e "$evidence/refused/candidate.dex"
rg -F 'has no validated external DEX descriptor' "$evidence/refused/compiler.txt"
git -C "$repository" rev-parse HEAD > "$evidence/backend-commit.txt"
git -C "$frontend" rev-parse HEAD > "$evidence/frontend-commit.txt"
sha256sum "$repository/dex/idric/src/Backend/DEX/ManagedBoundary.idr" \
  "$repository/dex/idric/src/Backend/DEX/Codegen.idr" "$driver" "${driver}_app/idric-dex.so" \
  "$source/ExportAliases.idric" "$evidence/managed/candidate.dex" "$evidence/mutant/candidate.dex" > "$evidence/sha256.txt"
printf 'source_checked\tPASS\nindependent_decode\tPASS\ndeterminism\tPASS\nordinary_data_alias\tREFUSED\nART\tNOT_RUN\nphysical_TAB_P10\tNOT_RUN\n' > "$evidence/receipt.tsv"
