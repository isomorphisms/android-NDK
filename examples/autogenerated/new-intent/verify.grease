#!/usr/bin/env grease
if (len(ARGV) !== 5) {
  echo 'usage: grease verify.grease REPOSITORY FRONTEND BAKSMALI NEW_EVIDENCE GREASE' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var baksmali = ARGV[2]
var evidence = ARGV[3]
var grease = ARGV[4]
for path in "$repository" "$frontend" "$baksmali" "$evidence" "$grease" {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL evidence already exists' >&2; exit 2 }
mkdir -p "$evidence"
var compiler = "$frontend/_/build/exec/idris2"
var scheme = "$frontend/_/.tools/bin/scheme"
var prefix = "$frontend/_/bootstrap-build"
var package = "$repository/dex/idric"
var source = "$repository/examples/autogenerated/new-intent"
setglobal ENV.IDRIS2_PREFIX = prefix
setglobal ENV.IDRIS2_PACKAGE_PATH = "$prefix/idris2-0.8.0"
setglobal ENV.CHEZ = scheme
setglobal ENV.IDRIS2_CG = 'chez'
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.IDRIS2_PATH = "$package/build/ttc"
git -C "$repository" rev-parse HEAD > "$evidence/backend-ref.txt"
git -C "$repository" diff --binary HEAD > "$evidence/backend.patch"
git -C "$frontend" rev-parse HEAD > "$evidence/frontend-ref.txt"
sha256sum "$compiler" "$scheme" "$source/NewIntentActivity.idric" \
  "$source/NewIntentPlanChecks.idric" > "$evidence/input.sha256"
cd "$package"
"$compiler" --build backend.ipkg > "$evidence/backend-build.txt" 2>&1
if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$evidence/backend-build.txt" {
  echo 'FAIL backend compiler diagnostic' >&2; exit 1
}
cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" build/exec/idric-dex_app/
var driver = "$package/build/exec/idric-dex"
"$compiler" -p idris2 --source-dir "$source" --build-dir "$evidence/host-build" \
  "$source/NewIntentPlanChecks.idric" -o intent-checks > "$evidence/host-compile.txt" 2>&1
if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$evidence/host-compile.txt" {
  echo 'FAIL host compiler diagnostic' >&2; exit 1
}
"$evidence/host-build/exec/intent-checks" > "$evidence/host.txt" 2>&1
cat "$evidence/host.txt"
proc emit_source(directory, name) {
  mkdir -p "$evidence/$name"
  "$driver" --cg dex --source-dir "$directory" --build-dir "$evidence/$name-build" \
    --output-dir "$evidence/$name" "$directory/NewIntentActivity.idric" -o candidate \
    > "$evidence/$name/compile.txt" 2>&1
  if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$evidence/$name/compile.txt" {
    echo 'FAIL source compiler diagnostic' >&2; return 1
  }
  test -s "$evidence/$name/candidate.dex"
  java -jar "$baksmali" disassemble "$evidence/$name/candidate.dex" -o "$evidence/$name/decoded"
}
emit_source "$source" positive
emit_source "$source" recovery
cmp "$evidence/positive/candidate.dex" "$evidence/recovery/candidate.dex"
rg -F '.method public onNewIntent(Landroid/content/Intent;)V' "$evidence/positive/decoded/Idric/Generated.smali"
rg -F 'Landroid/app/Activity;->onNewIntent(Landroid/content/Intent;)V' "$evidence/positive/decoded/Idric/Generated.smali"
rg -F 'Landroid/app/Activity;->setIntent(Landroid/content/Intent;)V' "$evidence/positive/decoded/Idric/Generated.smali"
for mutant in omitted-intent wrong-signature {
  mkdir -p "$evidence/$mutant-source"
  if (mutant === 'omitted-intent') {
    sed -e 's/ActivityReference → IntentReference → IO ()/ActivityReference → IO ()/' \
      -e 's/receive_new_intent activity intent = primIO (retain_current_intent activity intent)/receive_new_intent activity = do { prior ← primIO (earlier_intent activity); primIO (retain_current_intent activity prior) }/' \
      "$source/NewIntentActivity.idric" > "$evidence/$mutant-source/NewIntentActivity.idric"
  } else {
    sed 's/override onNewIntent (Landroid\/content\/Intent;)V/override onNewIntent (Landroid\/os\/Bundle;)V/' \
      "$source/NewIntentActivity.idric" > "$evidence/$mutant-source/NewIntentActivity.idric"
  }
  "$driver" --source-dir "$evidence/$mutant-source" --build-dir "$evidence/$mutant-check" \
    --check "$evidence/$mutant-source/NewIntentActivity.idric" > "$evidence/$mutant-typecheck.txt" 2>&1
  try { emit_source "$evidence/$mutant-source" "$mutant" }
  var status = _error.code
  if (status === 0) { echo "FAIL $mutant accepted" >&2; exit 1 }
  test ! -e "$evidence/$mutant/candidate.dex"
  if (mutant === 'omitted-intent') {
    rg -F 'DEX lifecycle signature must include its checked Activity receiver' "$evidence/$mutant/compile.txt"
  } else {
    rg -F 'DEX checked lifecycle admits onCreate(Bundle) and onNewIntent(Intent) only' "$evidence/$mutant/compile.txt"
  }
}
sha256sum "$driver" "${driver}_app/idric-dex.so" "$evidence/positive/candidate.dex" > "$evidence/output.sha256"
printf 'host_plans\tPASS\nsource_to_dex\tPASS\ndeterminism\tPASS\nsource_refusals\tPASS\nART\tNOT_RUN\nphysical_C67\tNOT_RUN\nphysical_A1\tNOT_RUN\n' > "$evidence/receipt.tsv"
printf '\033[32mPASS\033[0m new Intent host plans, source lowering, decode, refusals and deterministic recovery\n'
