#!/usr/bin/env grease
if (len(ARGV) !== 7) {
  echo 'usage: grease verify-independent.grease REPOSITORY FRONTEND AICI BAKSMALI QUALIFIED_EVIDENCE NEW_EVIDENCE GREASE' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var oracle = ARGV[2]
var decoder = ARGV[3]
var qualified = ARGV[4]
var evidence = ARGV[5]
var grease = ARGV[6]
for path in "$repository" "$frontend" "$oracle" "$decoder" "$qualified" "$evidence" "$grease" {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL evidence already exists' >&2; exit 2 }
mkdir -p "$evidence/mutant-source"
var prefix = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PREFIX = prefix
setglobal ENV.IDRIS2_PACKAGE_PATH = "$prefix/idris2-0.8.0"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
var driver = "$repository/dex/idric/build/exec/idric-dex"
var source = "$repository/examples/autogenerated/new-intent/NewIntentActivity.idric"
test -x "$grease"
"$grease" "$oracle/dex/verify-new-intent.grease" "$decoder" \
  "$qualified/positive/candidate.dex" "$evidence/positive"
sed 's/receive_new_intent activity intent = primIO (retain_current_intent activity intent)/receive_new_intent activity intent = do { prior ← primIO (earlier_intent activity); primIO (retain_current_intent activity prior) }/' \
  "$source" > "$evidence/mutant-source/NewIntentActivity.idric"
"$driver" --cg dex --source-dir "$evidence/mutant-source" --build-dir "$evidence/mutant-build" \
  --output-dir "$evidence" "$evidence/mutant-source/NewIntentActivity.idric" -o wrong-intent \
  > "$evidence/mutant-compile.txt" 2>&1
test -s "$evidence/wrong-intent.dex"
if cmp -s "$qualified/positive/candidate.dex" "$evidence/wrong-intent.dex" {
  echo 'FAIL ineffective source mutant' >&2; exit 1
}
try {
  "$grease" "$oracle/dex/verify-new-intent.grease" "$decoder" \
    "$evidence/wrong-intent.dex" "$evidence/mutant" > "$evidence/mutant.txt" 2>&1
}
var status = _error.code
test "$status" = 1
rg -F 'FAIL new Intent retention must use the supplied Intent' "$evidence/mutant.txt"
"$grease" "$oracle/dex/verify-new-intent.grease" "$decoder" \
  "$qualified/recovery/candidate.dex" "$evidence/recovery"
git -C "$oracle" rev-parse HEAD > "$evidence/oracle-ref.txt"
git -C "$oracle" diff --binary HEAD > "$evidence/oracle.patch"
sha256sum "$oracle/dex/verify-new-intent.grease" "$evidence/wrong-intent.dex" > "$evidence/inputs.sha256"
printf 'positive\tPASS\ncompiled_wrong_intent\tREJECTED\nrecovery\tPASS\nART\tNOT_RUN\nphysical_C67\tNOT_RUN\n' > "$evidence/result.tsv"
