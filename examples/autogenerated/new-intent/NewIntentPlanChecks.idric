module NewIntentPlanChecks

import Backend.DEX.Callback
import Backend.DEX.IR
import Backend.DEX.Encode
import Backend.DEX.Smali
import Data.Text
import Data.List
import System

-- The inherited encoder deliberately exposes a covering API.
%default covering

activity_reference : FrameworkValueType
activity_reference = ReferenceValue (MkTypeReference "Landroid/app/Activity;")

intent_reference : FrameworkValueType
intent_reference = ReferenceValue (MkTypeReference "Landroid/content/Intent;")

receive_intent_method : MethodPlan
receive_intent_method = MkMethodPlan "checked Intent handler" "receive_intent" 2
  [activity_reference, intent_reference] VoidValue 2 [ReturnVoid]

new_intent_directive : Text
new_intent_directive = "override onNewIntent (Landroid/content/Intent;)V receive_intent"

plan_with_handler : MethodPlan → List Text → Either Text FilePlan
plan_with_handler handler directives = with_interface_callbacks "LIdric/Generated;"
  [handler] directives

plan_refuses : Either Text value → Bool
plan_refuses (Left _) = True
plan_refuses (Right _) = False

forwards_exact_new_intent_after_parent : Bool
forwards_exact_new_intent_after_parent =
  case plan_with_handler receive_intent_method
    ["extends Landroid/app/Activity;", new_intent_directive] of
      Left _ ⇒ False
      Right plan ⇒ case filter (\method ⇒ method.method_name ≟ "onNewIntent") plan.methods of
        [bridge] ⇒ bridge.mode ≟ InstanceMethod &&
          bridge.parameter_types ≟ [intent_reference] &&
          case bridge.instructions of
            [InvokeMethod parent, InvokeMethod checked, ReturnVoid] ⇒
              parent.kind ≟ InvokeSuper &&
              parent.method.owner ≟ MkTypeReference "Landroid/app/Activity;" &&
              parent.method.name ≟ "onNewIntent" &&
              parent.method.argument_types ≟ [intent_reference] &&
              parent.arguments ≟ [MkRegister 1, MkRegister 2] &&
              checked.kind ≟ InvokeStatic &&
              checked.method.name ≟ "receive_intent" &&
              checked.arguments ≟ [MkRegister 1, MkRegister 2]
            _ ⇒ False
        _ ⇒ False

full_plan_encodes : Bool
full_plan_encodes = case plan_with_handler receive_intent_method
  ["extends Landroid/app/Activity;", new_intent_directive] of
    Left _ ⇒ False
    Right plan ⇒ case finalize_file_plan plan of
      Left _ ⇒ False
      Right frozen ⇒ case encode_finalized_dex frozen of
        Left _ ⇒ False
        Right bytes ⇒ not (null bytes) &&
          isInfixOf ".method public onNewIntent(Landroid/content/Intent;)V"
            (render_finalized_smali frozen)

repeated_override_refuses : Bool
repeated_override_refuses = case plan_with_handler receive_intent_method
  ["extends Landroid/app/Activity;", new_intent_directive, new_intent_directive] of
    Left _ ⇒ True
    Right plan ⇒ plan_refuses (finalize_file_plan plan)

intent_cases : List (Text, Bool)
intent_cases =
  [ ("parent-before-exact-activity-and-intent", forwards_exact_new_intent_after_parent)
  , ("new-intent-plan-encodes", full_plan_encodes)
  , ("missing-activity-superclass-refused", plan_refuses
      (plan_with_handler receive_intent_method [new_intent_directive]))
  , ("wrong-sdk-argument-refused", plan_refuses
      (plan_with_handler receive_intent_method
        ["extends Landroid/app/Activity;", "override onNewIntent (Landroid/os/Bundle;)V receive_intent"]))
  , ("missing-source-export-refused", plan_refuses
      (with_interface_callbacks "LIdric/Generated;" []
        ["extends Landroid/app/Activity;", new_intent_directive]))
  , ("omitted-new-intent-refused", plan_refuses
      (plan_with_handler (MkMethodPlan "omits Intent" "receive_intent" 1
        [activity_reference] VoidValue 1 [ReturnVoid])
        ["extends Landroid/app/Activity;", new_intent_directive]))
  , ("wrong-source-domain-refused", plan_refuses
      (plan_with_handler (MkMethodPlan "wrong domain" "receive_intent" 2
        [activity_reference, ExistingValue IntegerValue] VoidValue 2 [ReturnVoid])
        ["extends Landroid/app/Activity;", new_intent_directive]))
  , ("repeated-override-refused", repeated_override_refuses)
  ]

main : IO ()
main = do
  traverse_ (\(name, passed) ⇒ putStrLn ((if passed then "PASS " else "FAIL ") ++ name)) intent_cases
  if all snd intent_cases then putStrLn "PASS new Intent typed-plan controls" else exitFailure
