#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 6) {
  echo 'usage: grease verify.grease REPOSITORY FRONTEND DRIVER BACKEND_TTC BAKSMALI FRESH_OUTPUT' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var backend_ttc = ARGV[3]
var baksmali = ARGV[4]
var output = ARGV[5]
for path in (ARGV) { if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 } }
if test -e "$output" { echo 'FAIL refusing reused library-header evidence' >&2; exit 1 }
command -v rg > /dev/null
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
var source = "$repository/examples/autogenerated/explicit-jni-library"
printf '%s  %s\n' 0c294a71f19576f9b7d0b717814258c2f4a134a5448e91eacf4a4023c9a9f9f8 "$source/LibraryIdentity.idric" | sha256sum -c -
printf '%s  %s\n' 8fc82bf80e6672a824bef74222bded56ab815235a31e60b188c099b763e92302 "$source/property.tsv" | sha256sum -c -
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/support/c"
test -s "$backend_ttc/2025081600/Backend/DEX/NativeContract.ttc"
setglobal ENV.IDRIS2_PATH = backend_ttc
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
mkdir -p "$output/headers" "$output/named" "$output/repeat" "$output/property" "$output/changed" "$output/maps"
git -C "$repository" rev-parse HEAD > "$output/source-revision.txt"
sha256sum "$driver" "$source/LibraryIdentity.idric" "$source/LibraryHeaderChecks.idric" \
  "$source/library.tsv" "$source/property.tsv" "$source/property-baseline.sha256" \
  "$source/verify.grease" \
  "$backend_ttc/2025081600/Backend/DEX/NativeContract.ttc" \
  > "$output/inputs.sha256"

proc no_diagnostics(path) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$path" }
  var diagnostics = _error.code
  if (diagnostics !== 1) { cat "$path" >&2; echo 'FAIL source diagnostics or scanner failure' >&2; exit 1 }
}
"$frontend/_/build/exec/idris2" -p idris2 --source-dir "$source" --build-dir "$output/headers" \
  "$source/LibraryHeaderChecks.idric" -o library-header-checks > "$output/headers/compiler.txt" 2>&1
no_diagnostics "$output/headers/compiler.txt"
cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$output/headers/exec/library-header-checks_app/"
"$output/headers/exec/library-header-checks" > "$output/headers/result.txt" 2>&1
rg -x -F 'PASS explicit JNI library header and historical property selection' "$output/headers/result.txt"

proc emit(map, destination) {
  "$driver" --cg dex --directive managed-exports --directive "jni-map=$map" \
    --source-dir "$source" --build-dir "$destination/build" --output-dir "$destination" \
    "$source/LibraryIdentity.idric" -o candidate > "$destination/compiler.txt" 2>&1
  no_diagnostics "$destination/compiler.txt"
  test -s "$destination/candidate.dex"
  java -jar "$baksmali" disassemble "$destination/candidate.dex" -o "$destination/decoded"
  sed -n '/^.method static constructor <clinit>()V$/,/^.end method$/p' \
    "$destination/decoded/Idric/Generated.smali" > "$destination/initializer.smali"
  test $(rg -c -F '.method static constructor <clinit>()V' "$destination/initializer.smali") = 1
}
emit "$source/library.tsv" "$output/named"
emit "$source/library.tsv" "$output/repeat"
cmp "$output/named/candidate.dex" "$output/repeat/candidate.dex"
rg -x -F '.method public static library_identity(I)I' "$output/named/decoded/Idric/Generated.smali"
rg -x -F '.method public static native narrow(I)I' "$output/named/decoded/Idric/Generated.smali"
rg -F 'LIdric/Generated;->narrow(I)I' "$output/named/decoded/Idric/Generated.smali"
rg -F 'const-string v0, "contract"' "$output/named/initializer.smali"
rg -F 'Ljava/lang/System;->loadLibrary(Ljava/lang/String;)V' "$output/named/initializer.smali"
try { rg -n 'Ljava/lang/System;->(getProperty|load)\(' "$output/named/initializer.smali" }
var old_loader = _error.code
if (old_loader !== 1) { echo 'FAIL named header used path-property loader or checker failed' >&2; exit 1 }
emit "$source/property.tsv" "$output/property"
rg -F 'Ljava/lang/System;->getProperty(Ljava/lang/String;)Ljava/lang/String;' "$output/property/initializer.smali"
rg -F 'Ljava/lang/System;->load(Ljava/lang/String;)V' "$output/property/initializer.smali"
cd "$output"
sha256sum -c "$source/property-baseline.sha256"
cd "$repository"
sed 's/^library contract$/library other_contract/' "$source/library.tsv" > "$output/maps/changed.tsv"
emit "$output/maps/changed.tsv" "$output/changed"
rg -F 'const-string v0, "other_contract"' "$output/changed/initializer.smali"
try { cmp -s "$output/named/candidate.dex" "$output/changed/candidate.dex" }
if (_error.code !== 1) { echo 'FAIL logical-name source mutation did not change candidate or comparison failed' >&2; exit 1 }

var row = 'C:contract_narrow,libcontract narrow (I)I current-thread synchronous borrowed-local nonnull-strings propagate-exceptions'
proc refuse(name, header, diagnostic) {
  var destination = "$output/refused-$name"
  mkdir -p "$destination"
  printf '%s\n%s\n' "$header" "$row" > "$output/maps/$name.tsv"
  try {
    "$driver" --cg dex --directive managed-exports --directive "jni-map=$output/maps/$name.tsv" \
      --source-dir "$source" --build-dir "$destination/build" --output-dir "$destination" \
      "$source/LibraryIdentity.idric" -o refused > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  printf 'exit_status\t%s\n' "$status" > "$destination/status.tsv"
  if (status !== 1) { echo "FAIL expected JNI library refusal exit 1: $name" >&2; exit 1 }
  test ! -e "$destination/refused.dex"
  rg -F "$diagnostic" "$destination/compiler.txt"
}
refuse empty '' 'JNI map requires exactly one'
refuse absent-name library 'JNI map requires exactly one'
refuse path 'library ../contract' 'JNI library name must be'
refuse suffix 'library libcontract.so' 'JNI library name must be'
refuse hyphen 'library contract-name' 'JNI library name must be'
refuse unicode 'library café' 'JNI library name must be'
refuse extra 'library contract extra' 'JNI map requires exactly one'
refuse duplicate b'library contract\nlibrary other_contract' 'JNI map repeats a library header'
refuse mixed b'library contract\nlibrary_property contract.library' 'JNI map repeats a library header'
refuse property-mixed b'library_property contract.library\nlibrary contract' 'JNI map repeats a library header'
refuse same-line 'library contract library_property contract.library' 'JNI map requires exactly one'
refuse unknown 'native_library contract' 'JNI map requires exactly one'
sha256sum "$output/named/candidate.dex" "$output/repeat/candidate.dex" \
  "$output/property/candidate.dex" "$output/changed/candidate.dex" > "$output/candidates.sha256"
printf 'checked_named_library_source\tPASS\nindependent_initializer_decode\tPASS\ndeterministic_repeat\tPASS\nproperty_old_bytes\tPASS\nmalformed_duplicate_headers\tREFUSED\nchanged_logical_name\tCHANGED_CANDIDATE\nAPK_ART_load\tNOT_RUN\nphysical_devices\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m explicit JNI logical-name loading; APK and target loading separate\n'
