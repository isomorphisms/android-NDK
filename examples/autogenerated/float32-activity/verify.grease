#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 5) {
  echo 'usage: grease verify.grease REPOSITORY FRONTEND BAKSMALI SMALI FRESH_EVIDENCE' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var baksmali = ARGV[2]
var smali = ARGV[3]
var evidence = ARGV[4]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL refusing reused Float32 evidence' >&2; exit 1 }
command -v rg > /dev/null
test $(git -C "$frontend" rev-parse HEAD) = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
var compiler = "$frontend/_/build/exec/idris2"
var backend = "$repository/dex/idric"
var driver = "$backend/build/exec/idric-dex"
var source = "$repository/examples/autogenerated/float32-activity"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$backend/build/ttc"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/support/c"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
mkdir -p "$evidence/ir" "$evidence/contract" "$evidence/positive" "$evidence/repeat" "$evidence/mutant/source"
git -C "$repository" rev-parse HEAD > "$evidence/backend-revision.txt"
git -C "$repository" diff -- dex/idric/src > "$evidence/backend.patch"
sha256sum "$source/Float32Source.idric" "$source/Float32Runner.smali" \
  "$source/Float32IRCheck.idr" "$source/Float32ContractCheck.idr" > "$evidence/sources.sha256"
make -C "$backend" driver IDRIC="$compiler"

proc absent_pattern(pattern, path, message) {
  try { rg -n "$pattern" "$path" }
  var status = _error.code
  if (status === 0) { echo "FAIL $message" >&2; exit 1 }
  if (status !== 1) { echo "FAIL checker could not read input: $path" >&2; exit 1 }
}
proc no_diagnostics(log) {
  absent_pattern '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" 'compiler returned success with diagnostics'
}
proc different_files(first, second) {
  try { cmp -s "$first" "$second" }
  var status = _error.code
  if (status === 0) { echo 'FAIL unchanged Float32 source mutation or DEX' >&2; exit 1 }
  if (status !== 1) { echo 'FAIL source comparison could not read both files' >&2; exit 1 }
}
proc host_check(module, label, marker) {
  "$compiler" -p idris2 --source-dir "$source" --build-dir "$evidence/$label/build" \
    --output-dir "$evidence/$label" "$source/$module.idr" -o check \
    > "$evidence/$label/compiler.txt" 2>&1
  no_diagnostics "$evidence/$label/compiler.txt"
  cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$evidence/$label/check_app/"
  "$evidence/$label/check" > "$evidence/$label/output.txt" 2>&1
  cat "$evidence/$label/output.txt"
  rg -x -F "$marker" "$evidence/$label/output.txt"
}
printf '\033[36mACTION\033[0m verify actual Float32 opcodes, placement and checked domains\n'
host_check Float32IRCheck ir 'PASS Float32 opcode, register placement and alias checks'
host_check Float32ContractCheck contract 'PASS checked Float32 domains, arithmetic and preserved refusals'

proc emit_source(directory, output) {
  "$driver" --cg dex --directive managed-exports --source-dir "$directory" \
    --build-dir "$output/build" --output-dir "$output" \
    "$directory/Float32Source.idric" -o candidate > "$output/compiler.txt" 2>&1
  no_diagnostics "$output/compiler.txt"
  test -s "$output/candidate.dex"
  java -jar "$baksmali" disassemble "$output/candidate.dex" -o "$output/decoded"
}
printf '\033[36mACTION\033[0m compile actual distinct-domain Float32 source and Android coordinate calls\n'
emit_source "$source" "$evidence/positive"
emit_source "$source" "$evidence/repeat"
cmp "$evidence/positive/candidate.dex" "$evidence/repeat/candidate.dex"
var decoded = "$evidence/positive/decoded/Idric/Generated.smali"
for operation in add-float sub-float mul-float div-float { rg -F "$operation" "$decoded" }
for signature in \
  '.method public static f32_calculate_bits(III)I' \
  '.method public static f32_calculate_widened_bits(III)J' \
  '.method public static f32_event_delta_bits(II)J' \
  '.method public static f32_scale_factor_bits(Landroid/view/ScaleGestureDetector;)I' \
  'Landroid/view/MotionEvent;->obtain(JJIFFI)Landroid/view/MotionEvent;' \
  'Landroid/view/MotionEvent;->getX()F' \
  'Landroid/view/MotionEvent;->getY()F' \
  'Landroid/view/ScaleGestureDetector;->getScaleFactor()F' \
  'Ljava/lang/Float;->floatValue()F' \
  'Ljava/lang/Float;->doubleValue()D' {
  rg -F "$signature" "$decoded"
}
absent_pattern 'Ljava/lang/Float;->sum|add-double|sub-double|mul-double|div-double|double-to-float' \
  "$decoded" 'Float32 source acquired API24 sum, widened arithmetic or hidden narrowing'
sed 's/dex:float32:subtract/dex:float32:add/' "$source/Float32Source.idric" \
  > "$evidence/mutant/source/Float32Source.idric"
different_files "$source/Float32Source.idric" "$evidence/mutant/source/Float32Source.idric"
emit_source "$evidence/mutant/source" "$evidence/mutant"
different_files "$evidence/positive/candidate.dex" "$evidence/mutant/candidate.dex"
java -jar "$smali" assemble "$source/Float32Runner.smali" -o "$evidence/runner.dex"
java -jar "$baksmali" disassemble "$evidence/runner.dex" -o "$evidence/runner-decoded"

proc refuse_source(module, diagnostic) {
  var output = "$evidence/refuse-$module"
  mkdir -p "$output"
  "$driver" --source-dir "$source" --build-dir "$output/typecheck" --check "$source/$module.idric" \
    > "$output/typecheck.txt" 2>&1
  no_diagnostics "$output/typecheck.txt"
  try {
    "$driver" --cg dex --directive managed-exports --source-dir "$source" \
      --build-dir "$output/build" --output-dir "$output" "$source/$module.idric" -o candidate \
      > "$output/compiler.txt" 2>&1
  }
  var status = _error.code
  cat "$output/compiler.txt"
  if (status !== 1) { echo "FAIL missing intended Float32 source refusal: $module" >&2; exit 1 }
  test ! -e "$output/candidate.dex"
  rg -F "$diagnostic" "$output/compiler.txt"
}
refuse_source OrdinaryFloatDomain 'is ordinary algebraic data, not an external reference'
refuse_source ConflictingFloatDomain 'has conflicting descriptors'
refuse_source WidenedFloatForeign 'dex foreign result type does not match'
refuse_source WidenedFloatArithmetic 'Checked Float32 arithmetic requires two values and a result in one external Float32 domain'
sha256sum "$evidence/positive/candidate.dex" "$evidence/repeat/candidate.dex" \
  "$evidence/mutant/candidate.dex" "$evidence/runner.dex" > "$evidence/artifacts.sha256"
printf 'checked_external_Float32_domain\tPASS\nreal_F32_arithmetic\tPASS\nplatform_F_arguments_and_results\tPASS\nindependent_decode\tPASS\ndeterminism\tPASS\ncompiled_source_mutant\tGENERATED\nsource_domain_refusals\tPASS\nART\tNOT_RUN\nAPI23_execution\tNOT_RUN\nphysical_device\tNOT_RUN\n' \
  > "$evidence/host-result.tsv"
printf '\033[32mPASS\033[0m actual Float32 source, typed boundaries and controls; ART separate\n'
