#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 3) { echo 'usage: grease observe-art.grease ADB SERIAL HOST_EVIDENCE' >&2; exit 2 }
var adb = ARGV[0]
var serial = ARGV[1]
var evidence = ARGV[2]
if (adb[0] !== '/' or evidence[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
command -v rg > /dev/null
if test -e "$evidence/art-positive.txt" { echo 'FAIL refusing reused Float32 ART evidence' >&2; exit 1 }
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
var api = $("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')
if (api !== ENV.AICI_EXPECTED_ANDROID_API or (api !== '29' and api !== '34')) {
  echo 'FAIL unexpected Float32 ART API' >&2; exit 1
}
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
var remote = '/data/local/tmp/idric-float32-activity'
"$adb" -s "$serial" shell rm -rf "$remote"
"$adb" -s "$serial" shell mkdir "$remote"
"$adb" -s "$serial" push "$evidence/positive/candidate.dex" "$remote/positive.dex"
"$adb" -s "$serial" push "$evidence/mutant/candidate.dex" "$remote/mutant.dex"
"$adb" -s "$serial" push "$evidence/runner.dex" "$remote/runner.dex"
"$adb" -s "$serial" shell chmod 444 "$remote/positive.dex" "$remote/mutant.dex" "$remote/runner.dex"
"$adb" -s "$serial" pull "$remote/positive.dex" "$evidence/positive.received.dex"
"$adb" -s "$serial" pull "$remote/mutant.dex" "$evidence/mutant.received.dex"
"$adb" -s "$serial" pull "$remote/runner.dex" "$evidence/runner.received.dex"
cmp "$evidence/positive/candidate.dex" "$evidence/positive.received.dex"
cmp "$evidence/mutant/candidate.dex" "$evidence/mutant.received.dex"
cmp "$evidence/runner.dex" "$evidence/runner.received.dex"
"$adb" -s "$serial" shell "CLASSPATH=$remote/positive.dex:$remote/runner.dex app_process /system/bin qualification.Float32Runner" \
  > "$evidence/art-positive.txt" 2>&1
cat "$evidence/art-positive.txt"
rg -x -F 'PASS checked Float32 source and platform boundary' "$evidence/art-positive.txt"
try {
  "$adb" -s "$serial" shell "CLASSPATH=$remote/mutant.dex:$remote/runner.dex app_process /system/bin qualification.Float32Runner" \
    > "$evidence/art-mutant.txt" 2>&1
}
var status = _error.code
cat "$evidence/art-mutant.txt"
if (status !== 73) { echo 'FAIL missing designated Float32 producer mutant rejection' >&2; exit 1 }
rg -x -F 'FAIL checked Float32 source and platform boundary' "$evidence/art-mutant.txt"
"$adb" -s "$serial" shell getprop ro.build.version.sdk > "$evidence/art-sdk.txt"
"$adb" -s "$serial" shell getprop ro.product.cpu.abi > "$evidence/art-abi.txt"
printf 'checked_Float32_source_ART\tPASS\nreal_MotionEvent_F_arguments_and_results\tPASS\nsubtract_before_explicit_widening\tPASS\nsigned_zero_subnormal_infinity_NaN_classification\tPASS\ncompiled_source_mutant_rejected\tPASS\nScaleGestureDetector_F_binding\tDECODE_ONLY\nAPI23_execution\tNOT_RUN\nphysical_device\tNOT_RUN\n' \
  > "$evidence/art-result.tsv"
printf '\033[32mPASS\033[0m actual Float32 source/platform ART path and source mutation rejection\n'
