#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) { echo 'usage: grease verify-plans.grease REPOSITORY FRONTEND_ROOT BACKEND_TTC FRESH_OUTPUT' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var modules = ARGV[2]
var output = ARGV[3]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused SDK Object array evidence' >&2; exit 1 }
var scheme = "$frontend/.tools/bin/scheme"
var compiler = "$frontend/build/exec/idris2_app/idris2.so"
var source = "$repository/examples/autogenerated/sdk-object-array"
setglobal ENV.IDRIS2_PREFIX = "$frontend/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = modules
setglobal ENV.IDRIS2_INC_SRC = "$frontend/build/exec/idris2_app"
setglobal ENV.LD_LIBRARY_PATH = "$frontend/build/exec/idris2_app"
setglobal ENV.CHEZ = scheme
setglobal ENV.PATH = "$frontend/.tools/bin:" ++ ENV.PATH
mkdir -p "$output/source/Backend/DEX"
# Unit qualification checks the two changed source modules against the supplied
# compiled dependencies. It is not a fresh complete backend build receipt.
cp "$repository/dex/idric/src/Backend/DEX/Foreign.idr" \
  "$repository/dex/idric/src/Backend/DEX/NativeContract.idr" "$output/source/Backend/DEX/"
proc clean_log(log) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" }
  var status = _error.code
  if (status === 0) { echo 'FAIL SDK Object array source diagnostic' >&2; exit 1 }
  if (status !== 1) { echo 'FAIL SDK Object array diagnostic checker' >&2; exit 1 }
}
"$scheme" --program "$compiler" -p idris2 --check --source-dir "$output/source" \
  --build-dir "$output/modules" "$output/source/Backend/DEX/NativeContract.idr" > "$output/modules.txt" 2>&1
clean_log "$output/modules.txt"
cp -a "$modules" "$output/module-overlay"
cp -a "$output/modules/ttc/." "$output/module-overlay/"
cmp "$output/modules/ttc/2025081600/Backend/DEX/Foreign.ttc" "$output/module-overlay/2025081600/Backend/DEX/Foreign.ttc"
cmp "$output/modules/ttc/2025081600/Backend/DEX/NativeContract.ttc" "$output/module-overlay/2025081600/Backend/DEX/NativeContract.ttc"
setglobal ENV.IDRIS2_PATH = "$output/module-overlay"
for lane in object-array copied-array-compatibility {
  var directory = source
  var module = 'SDKObjectArrayChecks.idric'
  var marker = 'PASS opaque SDK Object arrays and exact Text upcast; JNI policies preserved'
  if (lane === 'copied-array-compatibility') {
    setvar directory = "$repository/examples/autogenerated/copied-input-arrays"
    setvar module = 'CopiedArrayContractCheck.idr'
    setvar marker = 'PASS typed copied-array JNI contracts and preserved refusals'
  }
  mkdir -p "$output/$lane"
  "$scheme" --program "$compiler" -p idris2 --source-dir "$directory" \
    --build-dir "$output/$lane/build" --output-dir "$output/$lane" \
    "$directory/$module" -o plan-check > "$output/$lane/compiler.txt" 2>&1
  clean_log "$output/$lane/compiler.txt"
  "$scheme" --program "$output/$lane/plan-check_app/plan-check.so" > "$output/$lane/result.txt" 2>&1
  cat "$output/$lane/result.txt"
  rg -x -F "$marker" "$output/$lane/result.txt"
}
sha256sum "$repository/dex/idric/src/Backend/DEX/Foreign.idr" "$repository/dex/idric/src/Backend/DEX/NativeContract.idr" \
  "$source/SDKObjectArrayChecks.idric" "$compiler" "$modules/2025081600/Backend/DEX/Lower.ttc" \
  "$output/module-overlay/2025081600/Backend/DEX/Foreign.ttc" \
  "$output/module-overlay/2025081600/Backend/DEX/NativeContract.ttc" > "$output/inputs.sha256"
printf 'changed_modules_source_check\tPASS\nSDK_descriptor_and_domain_plans\tPASS\nText_upcast_and_refusals\tPASS\nmanaged_bridge_and_encoding\tPASS\nJNI_array_policy_refusals\tPASS\ncopied_array_compatibility\tPASS\nfull_backend_build\tNOT_RUN\nsource_DEX\tPENDING\nResources_Activity_execution\tPENDING\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m opaque SDK Object array and Text upcast plans; complete build and source DEX separate\n'
