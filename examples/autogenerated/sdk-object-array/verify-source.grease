#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 7) { echo 'usage: grease verify-source.grease REPOSITORY FRONTEND_ROOT DRIVER_PROGRAM BACKEND_TTC BAKSMALI SMALI FRESH_OUTPUT' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var modules = ARGV[3]
var baksmali = ARGV[4]
var smali = ARGV[5]
var output = ARGV[6]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused SDK format source evidence' >&2; exit 1 }
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
var source = "$repository/examples/autogenerated/sdk-object-array"
var scheme = "$frontend/.tools/bin/scheme"
var compiler = "$frontend/build/exec/idris2_app/idris2.so"
setglobal ENV.IDRIS2_PREFIX = "$frontend/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = modules
setglobal ENV.LD_LIBRARY_PATH = "$frontend/build/exec/idris2_app"
setglobal ENV.CHEZ = scheme
setglobal ENV.PATH = "$frontend/.tools/bin:" ++ ENV.PATH
mkdir -p "$output"
proc clean_log(log) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" }
  var status = _error.code
  if (status === 0) { echo 'FAIL SDK format source diagnostic' >&2; exit 1 }
  if (status !== 1) { echo 'FAIL SDK format diagnostic checker' >&2; exit 1 }
}
proc check_source(directory, module, destination) {
  mkdir -p "$destination"
  "$scheme" --program "$compiler" --check --source-dir "$directory" \
    --build-dir "$destination/check-build" "$directory/$module.idric" > "$destination/typecheck.txt" 2>&1
  clean_log "$destination/typecheck.txt"
}
proc emit(directory, module, destination) {
  mkdir -p "$destination"
  try {
    "$scheme" --program "$driver" --cg dex --directive managed-exports \
      --source-dir "$directory" --build-dir "$destination/build" --output-dir "$destination" \
      "$directory/$module.idric" -o candidate > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$destination/compiler.exit"
  cat "$destination/compiler.txt"
  if (status !== 0) { return 1 }
  clean_log "$destination/compiler.txt"
  test -s "$destination/candidate.dex"
  java -jar "$baksmali" disassemble "$destination/candidate.dex" -o "$destination/decoded"
}
check_source "$source" FormattedResources "$output/positive"
emit "$source" FormattedResources "$output/positive"
emit "$source" FormattedResources "$output/repeat"
cmp "$output/positive/candidate.dex" "$output/repeat/candidate.dex"
rg -F 'Ljava/util/ArrayList;->toArray()[Ljava/lang/Object;' "$output/positive/decoded/Idric/Generated.smali"
rg -F 'Landroid/content/res/Resources;->getString(I[Ljava/lang/Object;)Ljava/lang/String;' "$output/positive/decoded/Idric/Generated.smali"
rg -F 'Ljava/lang/Integer;->valueOf(I)Ljava/lang/Integer;' "$output/positive/decoded/Idric/Generated.smali"
rg -F 'Ljava/lang/Long;->valueOf(J)Ljava/lang/Long;' "$output/positive/decoded/Idric/Generated.smali"
rg -F 'Ljava/lang/String;->format(Ljava/lang/String;[Ljava/lang/Object;)Ljava/lang/String;' "$output/positive/decoded/Idric/Generated.smali"

for lane in ordinary-array conflicting-array unsupported-reference-array wrong-text-source wrong-text-target ordinary-object {
  var directory = "$output/$lane-source"
  mkdir -p "$directory" "$output/$lane"
  if (lane === 'ordinary-array') {
    sed 's/data FormatArguments : Type where \[external\]/data FormatArguments = PretendArguments/' "$source/FormattedResources.idric" > "$directory/FormattedResources.idric"
  } elif (lane === 'conflicting-array') {
    sed 's/toArray:()\[Ljava\/lang\/Object;/toArray:()[I/' "$source/FormattedResources.idric" > "$directory/FormattedResources.idric"
  } elif (lane === 'unsupported-reference-array') {
    sed 's/\[Ljava\/lang\/Object;/[Ljava\/lang\/String;/g' "$source/FormattedResources.idric" > "$directory/FormattedResources.idric"
  } elif (lane === 'wrong-text-source') {
    sed 's/cast:Ljava\/lang\/String;:Ljava\/lang\/Object;/cast:Ljava\/lang\/CharSequence;:Ljava\/lang\/Object;/' "$source/FormattedResources.idric" > "$directory/FormattedResources.idric"
  } elif (lane === 'wrong-text-target') {
    sed 's/cast:Ljava\/lang\/String;:Ljava\/lang\/Object;/cast:Ljava\/lang\/String;:Ljava\/util\/ArrayList;/' "$source/FormattedResources.idric" > "$directory/FormattedResources.idric"
  } else {
    sed 's/data ObjectReference : Type where \[external\]/data ObjectReference = PretendObject/' "$source/FormattedResources.idric" > "$directory/FormattedResources.idric"
  }
  if cmp -s "$source/FormattedResources.idric" "$directory/FormattedResources.idric" { echo 'FAIL unchanged SDK format refusal source' >&2; exit 1 }
  check_source "$directory" FormattedResources "$output/$lane"
  cp "$output/positive/candidate.dex" "$output/$lane/candidate.dex"
  try { emit "$directory" FormattedResources "$output/$lane" }
  var status = _error.code
  if (status !== 1) { echo 'FAIL missing SDK format source refusal' >&2; exit 1 }
  test $(cat "$output/$lane/compiler.exit") = 1
  test ! -e "$output/$lane/candidate.dex"
  if (lane === 'ordinary-array' or lane === 'ordinary-object') {
    rg -F 'ordinary algebraic data, not an external reference' "$output/$lane/compiler.txt"
  } elif (lane === 'conflicting-array') {
    rg -F 'has conflicting descriptors' "$output/$lane/compiler.txt"
  } elif (lane === 'unsupported-reference-array') {
    rg -F 'DEX array descriptors admit only checked primitive [D/[I references or opaque [Ljava/lang/Object;' "$output/$lane/compiler.txt"
  } else {
    rg -F 'DEX Text cast admits only explicit String to Object' "$output/$lane/compiler.txt"
  }
}
check_source "$source" OrdinaryTextCast "$output/ordinary-text-cast"
cp "$output/positive/candidate.dex" "$output/ordinary-text-cast/candidate.dex"
try { emit "$source" OrdinaryTextCast "$output/ordinary-text-cast" }
var ordinary_status = _error.code
if (ordinary_status !== 1) { echo 'FAIL ordinary source ADT escaped through String cast' >&2; exit 1 }
test $(cat "$output/ordinary-text-cast/compiler.exit") = 1
test ! -e "$output/ordinary-text-cast/candidate.dex"
rg -F 'DEX String source cast requires checked Text' "$output/ordinary-text-cast/compiler.txt"
mkdir -p "$output/order-mutant-source"
sed 's/box_integer first/box_integer second/' "$source/FormattedResources.idric" > "$output/order-mutant-source/FormattedResources.idric"
if cmp -s "$source/FormattedResources.idric" "$output/order-mutant-source/FormattedResources.idric" { echo 'FAIL unchanged formatting source mutation' >&2; exit 1 }
emit "$output/order-mutant-source" FormattedResources "$output/order-mutant"
if cmp -s "$output/positive/candidate.dex" "$output/order-mutant/candidate.dex" { echo 'FAIL unchanged formatting mutation DEX' >&2; exit 1 }
java -jar "$smali" assemble "$source/FormattedResourcesRunner.smali" -o "$output/runner.dex"
sha256sum "$repository/dex/idric/src/Backend/DEX/Foreign.idr" "$repository/dex/idric/src/Backend/DEX/NativeContract.idr" \
  "$source/FormattedResources.idric" "$source/OrdinaryTextCast.idric" "$driver" \
  "$output/positive/candidate.dex" "$output/order-mutant/candidate.dex" "$output/runner.dex" > "$output/inputs-candidates.sha256"
printf 'checked_source\tPASS\nindependent_decode\tPASS\ndeterministic_repeat\tPASS\nsource_refusals\tPASS\nstale_DEX_after_refusal\tABSENT\nsource_mutation\tBUILT\nformat_argument_ART\tPENDING\napplication_resource_formats\tPENDING\nphysical_device\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m actual SDK Object array formatting source and refusals; runtime separate\n'
