#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 7) {
  echo 'usage: grease verify.grease REPOSITORY FRONTEND DRIVER BACKEND_TTC BAKSMALI SMALI FRESH_OUTPUT' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var modules = ARGV[3]
var baksmali = ARGV[4]
var smali = ARGV[5]
var output = ARGV[6]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused managed IORef evidence' >&2; exit 1 }
test $(git -C "$frontend" rev-parse HEAD) = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
var source = "$repository/examples/autogenerated/managed-ioref"
var compiler = "$frontend/_/build/exec/idris2"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = modules
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
mkdir -p "$output"
printf 'backend\t%s\nfrontend\t%s\n' $(git -C "$repository" rev-parse HEAD) \
  $(git -C "$frontend" rev-parse HEAD) > "$output/inputs.tsv"
git -C "$repository" diff --binary HEAD > "$output/local.patch"
sha256sum "$repository/dex/idric/src/Backend/DEX/ManagedIORef.idr" \
  "$repository/dex/idric/src/Backend/DEX/Heap.idr" \
  "$repository/dex/idric/src/Backend/DEX/ValueLayout.idr" \
  "$source/ManagedIORefSource.idric" "$source/IORefPlanChecks.idric" \
  "$source/ManagedIORefRunner.smali" "$driver" > "$output/source-artifacts.sha256"

proc clean_log(log) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" }
  var status = _error.code
  if (status === 0) { echo 'FAIL managed IORef source diagnostic' >&2; exit 1 }
  if (status !== 1) { echo 'FAIL managed IORef diagnostic checker' >&2; exit 1 }
}
proc host(directory, module, destination) {
  mkdir -p "$destination"
  try {
    "$compiler" -p idris2 --source-dir "$directory" --build-dir "$destination/build" \
      --output-dir "$destination" "$directory/$module.idric" -o host > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  cat "$destination/compiler.txt"
  printf '%s\n' "$status" > "$destination/compiler.exit"
  if (status !== 0) { echo 'FAIL managed IORef host compilation' >&2; exit 1 }
  clean_log "$destination/compiler.txt"
  cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$destination/host_app/"
  try { "$destination/host" > "$destination/result.txt" 2>&1 }
  var run_status = _error.code
  printf '%s\n' "$run_status" > "$destination/host.exit"
  cat "$destination/result.txt"
}
host "$source" IORefPlanChecks "$output/plans"
test $(cat "$output/plans/host.exit") = 0
rg -x -F 'PASS managed IORef checked plans and refusals' "$output/plans/result.txt"
host "$source" ManagedIORefSource "$output/host"
test $(cat "$output/host/host.exit") = 0
rg -x -F 'PASS managed IORef host semantics' "$output/host/result.txt"

proc emit(directory, module, destination) {
  mkdir -p "$destination"
  try {
    "$driver" --cg dex --directive managed-exports --source-dir "$directory" \
      --build-dir "$destination/build" --output-dir "$destination" \
      "$directory/$module.idric" -o candidate > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$destination/compiler.exit"
  cat "$destination/compiler.txt"
  if (status !== 0) { return 1 }
  clean_log "$destination/compiler.txt"
  test -s "$destination/candidate.dex"
  java -jar "$baksmali" disassemble "$destination/candidate.dex" -o "$destination/decoded"
}
emit "$source" ManagedIORefSource "$output/positive"
emit "$source" ManagedIORefSource "$output/repeat"
cmp "$output/positive/candidate.dex" "$output/repeat/candidate.dex"
rg -F 'Ljava/util/ArrayList;->set(ILjava/lang/Object;)Ljava/lang/Object;' "$output/positive/decoded/Idric/Generated.smali"
rg -F 'Ljava/util/ArrayList;->get(I)Ljava/lang/Object;' "$output/positive/decoded/Idric/Generated.smali"
rg -F '__idricIORef' "$output/positive/decoded/Idric/Generated.smali"
rg -F 'capability' "$output/positive/candidate.runtime.tsv" | rg -F 'managed-ioref'

for mutant in payload-mutant alias-mutant write-mutant intermediate-mutant {
  var directory = "$output/$mutant-source"
  mkdir -p "$directory"
  if (mutant === 'payload-mutant') {
    sed 's/("updated:" ++ supplied)/("mutated:" ++ supplied)/' "$source/ManagedIORefSource.idric" > "$directory/ManagedIORefSource.idric"
  } elif (mutant === 'alias-mutant') {
    sed 's/let alias = first/let alias = second/' "$source/ManagedIORefSource.idric" > "$directory/ManagedIORefSource.idric"
  } elif (mutant === 'write-mutant') {
    sed 's/writeIORef first (ProbeOpen/writeIORef second (ProbeOpen/' "$source/ManagedIORefSource.idric" > "$directory/ManagedIORefSource.idric"
  } else {
    sed '/writeIORef first ProbeClosed/d' "$source/ManagedIORefSource.idric" > "$directory/ManagedIORefSource.idric"
  }
  if cmp -s "$source/ManagedIORefSource.idric" "$directory/ManagedIORefSource.idric" {
    echo 'FAIL unchanged managed IORef source mutation' >&2; exit 1
  }
  host "$directory" ManagedIORefSource "$output/$mutant-host"
  test $(cat "$output/$mutant-host/host.exit") = 1
  rg -x -F 'FAIL managed IORef host semantics' "$output/$mutant-host/result.txt"
  emit "$directory" ManagedIORefSource "$output/$mutant"
  if cmp -s "$output/positive/candidate.dex" "$output/$mutant/candidate.dex" {
    echo 'FAIL unchanged managed IORef mutant bytes' >&2; exit 1
  }
}

for module in IORefPublicBoundary UnknownExtern LookalikeExtern {
  try { emit "$source" "$module" "$output/refusal-$module" }
  var status = _error.code
  if (status === 0) { echo 'FAIL expected managed IORef refusal' >&2; exit 1 }
  test $(cat "$output/refusal-$module/compiler.exit") = 1
  test ! -e "$output/refusal-$module/candidate.dex"
  if (module === 'IORefPublicBoundary') {
    rg -F 'unsupported applied or dependent source value type' "$output/refusal-$module/compiler.txt"
  } else {
    rg -F 'unsupported checked external primitive' "$output/refusal-$module/compiler.txt"
    rg -F "$module.prim__" "$output/refusal-$module/compiler.txt"
  }
}
java -jar "$smali" assemble "$source/ManagedIORefRunner.smali" -o "$output/runner.dex"
sha256sum "$output/positive/candidate.dex" "$output/payload-mutant/candidate.dex" \
  "$output/alias-mutant/candidate.dex" "$output/write-mutant/candidate.dex" \
  "$output/intermediate-mutant/candidate.dex" \
  "$output/runner.dex" > "$output/candidates.sha256"
printf 'checked_source\tPASS\nmanaged_cell_emission\tPASS\nindependent_decode\tPASS\nsource_mutations\tBUILT\nsource_refusals\tPASS\nART\tPENDING\ncallback_capture\tNOT_IMPLEMENTED\nAPK\tNOT_RUN\nphysical_device\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m managed IORef source build, decode, mutations and refusals; ART pending\n'
