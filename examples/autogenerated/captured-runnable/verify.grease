#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 10) {
  echo 'usage: grease verify.grease REPOSITORY FRONTEND_SOURCE FRONTEND_RUNTIME DRIVER_SO BACKEND_TTC SCHEME HEAPS BAKSMALI SMALI FRESH_OUTPUT' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var runtime = ARGV[2]
var driver = ARGV[3]
var modules = ARGV[4]
var scheme = ARGV[5]
var heaps = ARGV[6]
var baksmali = ARGV[7]
var smali = ARGV[8]
var output = ARGV[9]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused captured Runnable evidence' >&2; exit 1 }
test $(git -C "$frontend" rev-parse HEAD) = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
var source = "$repository/examples/autogenerated/captured-runnable"
var compiler = "$runtime/_/build/exec/idris2_app/idris2.so"
setglobal ENV.IDRIS2_PREFIX = "$runtime/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$runtime/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = modules
setglobal ENV.CHEZ = scheme
setglobal ENV.SCHEMEHEAPDIRS = heaps
setglobal ENV.LD_LIBRARY_PATH = "$runtime/_/build/exec/idris2_app"
mkdir -p "$output"
printf 'backend\t%s\nfrontend\t%s\n' $(git -C "$repository" rev-parse HEAD) \
  $(git -C "$frontend" rev-parse HEAD) > "$output/inputs.tsv"
git -C "$repository" diff --binary HEAD > "$output/local.patch"
sha256sum "$compiler" "$driver" "$source/CapturedRunnable.idric" \
  "$source/CapturedRunnablePlan.idric" "$source/CapturedRunnableRunner.smali" \
  "$repository/dex/idric/src/Backend/DEX/ManagedRunnable.idr" \
  "$repository/dex/idric/src/Backend/DEX/Foreign.idr" \
  "$repository/dex/idric/src/Backend/DEX/Codegen.idr" > "$output/inputs.sha256"

proc clean_log(log) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" }
  var status = _error.code
  if (status === 0) { echo 'FAIL checked source diagnostic' >&2; exit 1 }
  if (status !== 1) { echo 'FAIL diagnostic checker' >&2; exit 1 }
}
proc host_check(directory, module, extension, destination) {
  mkdir -p "$destination"
  "$scheme" --program "$compiler" -p idris2 --source-dir "$directory" \
    --build-dir "$destination/build" --output-dir "$destination" \
    "$directory/$module.$extension" -o plans > "$destination/compiler.txt" 2>&1
  clean_log "$destination/compiler.txt"
  cd "$destination"
  "$scheme" --program "$destination/plans_app/plans.so" > "$destination/result.txt" 2>&1
  cat "$destination/result.txt"
}
host_check "$source" CapturedRunnablePlan idric "$output/host"
rg -x -F 'PASS checked Runnable metadata, instance object placement, refusal and shared writer' "$output/host/result.txt"
host_check "$repository/dex/idric/tests/dex" ArgvBridgeTest idr "$output/legacy-host"
rg -F 'PASS' "$output/legacy-host/result.txt"

proc emit(directory, module, destination) {
  mkdir -p "$destination"
  try {
    "$scheme" --program "$driver" --cg dex --source-dir "$directory" \
      --build-dir "$destination/build" --output-dir "$destination" \
      "$directory/$module.idric" -o candidate > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$destination/compiler.exit"
  if (status !== 0) { return 1 }
  clean_log "$destination/compiler.txt"
  test -s "$destination/candidate.dex"
  java -jar "$baksmali" disassemble "$destination/candidate.dex" -o "$destination/decoded"
}
emit "$source" CapturedRunnable "$output/positive"
emit "$source" CapturedRunnable "$output/repeat"
cmp "$output/positive/candidate.dex" "$output/repeat/candidate.dex"
var generated = "$output/positive/decoded/Idric/Generated.smali"
var callback = "$output/positive/decoded/Idric/Generated\$CapturedRunnable.smali"
rg -x -F '.method public static make_captured_runnable(Ljava/lang/StringBuilder;Ljava/lang/String;Z)Ljava/lang/Runnable;' "$generated"
rg -x -F '.implements Ljava/lang/Runnable;' "$callback"
rg -x -F '.field private final __idric_action:Ljava/lang/Object;' "$callback"
rg -x -F '.method public run()V' "$callback"
rg -F 'iget-object' "$callback"
rg -F 'iput-object' "$callback"
rg -F 'LIdric/Generated;->__idricApply(Ljava/lang/Object;Ljava/lang/Object;)Ljava/lang/Object;' "$callback"
if rg -F '.method public native run()V' "$callback" { echo 'FAIL native callback substitute' >&2; exit 1 }
mkdir -p "$output/rendered"
cp "$output/positive/candidate.smali" "$output/rendered/Generated.smali"
cp "$output/positive/candidate.captured-runnable.smali" "$output/rendered/CapturedRunnable.smali"
java -jar "$smali" assemble "$output/rendered" -o "$output/rendered.dex"
java -jar "$baksmali" disassemble "$output/rendered.dex" -o "$output/rendered-decoded"
diff -ru "$output/positive/decoded" "$output/rendered-decoded"

mkdir -p "$output/order-mutant-source" "$output/text-mutant-source"
sed 's/OriginalOrder ⇒ join_fragments job.fragments/OriginalOrder ⇒ join_fragments (reverse_fragments job.fragments [])/' \
  "$source/CapturedRunnable.idric" > "$output/order-mutant-source/CapturedRunnable.idric"
sed 's/"|λ🙂|"/"|changed|"/' "$source/CapturedRunnable.idric" > "$output/text-mutant-source/CapturedRunnable.idric"
emit "$output/order-mutant-source" CapturedRunnable "$output/order-mutant"
emit "$output/text-mutant-source" CapturedRunnable "$output/text-mutant"
if cmp -s "$output/positive/candidate.dex" "$output/order-mutant/candidate.dex" { echo 'FAIL unchanged order mutant' >&2; exit 1 }
if cmp -s "$output/positive/candidate.dex" "$output/text-mutant/candidate.dex" { echo 'FAIL unchanged Text mutant' >&2; exit 1 }

for refusal in WrongAction WrongActionResult PureFactory WrongFactoryResult OrdinaryResult {
  mkdir -p "$output/$refusal-check"
  "$scheme" --program "$compiler" --check --source-dir "$source" --build-dir "$output/$refusal-check" \
    "$source/$refusal.idric" > "$output/$refusal-check/compiler.txt" 2>&1
  clean_log "$output/$refusal-check/compiler.txt"
  try { emit "$source" "$refusal" "$output/$refusal" }
  var status = _error.code
  if (status === 0) { echo 'FAIL unsupported captured Runnable admitted' >&2; exit 1 }
  test $(cat "$output/$refusal/compiler.exit") = 1
  if test -e "$output/$refusal/candidate.dex" { echo 'FAIL refused source emitted DEX' >&2; exit 1 }
  if (refusal === 'PureFactory') {
    rg -F 'DEX captured Runnable factory must return PrimIO' "$output/$refusal/compiler.txt"
  } elif (refusal === 'WrongFactoryResult') {
    rg -F 'DEX captured Runnable requires a concrete external Runnable result domain' "$output/$refusal/compiler.txt"
  } elif (refusal === 'OrdinaryResult') {
    rg -F 'is ordinary algebraic data, not an external reference' "$output/$refusal/compiler.txt"
  } else {
    rg -F 'DEX captured Runnable requires exactly one checked IO Unit action' "$output/$refusal/compiler.txt"
  }
}
java -jar "$smali" assemble "$source/CapturedRunnableRunner.smali" -o "$output/runner.dex"
sha256sum "$output/positive/candidate.dex" "$output/order-mutant/candidate.dex" \
  "$output/text-mutant/candidate.dex" "$output/runner.dex" > "$output/candidates.sha256"
printf 'checked_source\tPASS\nprivate_instance_field\tPASS\nrefusals\tPASS\nlegacy_static_field\tPASS\ndeterministic_bytes\tPASS\nART\tNOT_RUN\nAPK\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m checked captured Runnable source, fields and direct DEX; ART separate\n'
