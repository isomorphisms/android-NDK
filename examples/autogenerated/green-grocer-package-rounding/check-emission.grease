#!/usr/bin/env grease

if (len(ARGV) !== 4) {
  echo 'usage: grease check-emission.grease ABS_REPOSITORY ABS_FRONTEND ABS_DRIVER ABS_NEW_OUTPUT' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var output = ARGV[3]
for path in ([repository, frontend, driver, output]) {
  if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused evidence' >&2; exit 1 }
test "$(git -C "$frontend" rev-parse HEAD)" = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
var prefix = "$frontend/_/bootstrap-build"
var modules = "$prefix/idris2-0.8.0/base-0.8.0:$prefix/idris2-0.8.0/prelude-0.8.0"
var compiler = "$frontend/_/build/exec/idris2"
var scheme = "$frontend/_/.tools/bin/scheme"
var support = "$frontend/_/build/exec/idris2_app/libidris2_support.so"
var source = "$repository/examples/autogenerated/green-grocer-package-rounding"
for program in ([compiler, driver, scheme]) { test -x "$program" }
mkdir -p "$output/host"
sha256sum "$source/ExactPackageRounding.idric" "$driver" "$compiler" > "$output/input-sha256.txt"
env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$modules" IDRIS2_DATA="$frontend/_/support" \
  IDRIS2_LIBS="$frontend/_/build/exec/idris2_app" CHEZ="$scheme" \
  "$compiler" --cg chez --source-dir "$source" --build-dir "$output/host/build" \
  --output-dir "$output/host" "$source/ExactPackageRounding.idric" -o rounding \
  > "$output/host/compile.txt" 2>&1
if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$output/host/compile.txt" {
  echo 'FAIL host control compilation' >&2; exit 1
}
test -x "$output/host/rounding"
cp "$support" "$output/host/rounding_app/"
env CHEZ="$scheme" "$output/host/rounding" > "$output/host/execution.txt" 2>&1
printf '%s\n' -1 0 1 1 2 2 2 3 > "$output/host/expected.txt"
cmp "$output/host/expected.txt" "$output/host/execution.txt"
printf 'host_control\tPASS\n' > "$output/result.tsv"
printf '\033[36mACTION\033[0m Emit exact package rounding through the canonical DEX compiler\n'
try {
  env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$modules" CHEZ="$scheme" \
    "$driver" --cg dex --source-dir "$source" --build-dir "$output/dex-build" \
    --output-dir "$output" "$source/ExactPackageRounding.idric" -o rounding \
    > "$output/dex-compile.txt" 2>&1
}
var status = _error.code
cat "$output/dex-compile.txt"
printf 'dex_compiler_exit\t%s\n' "$status" >> "$output/result.tsv"
if (status !== 0) {
  printf 'dex_emission\tFAIL\nart_execution\tNOT_RUN\n' >> "$output/result.tsv"
  printf '\033[31mFAIL\033[0m required package-rounding emission remains blocked\n' >&2
  exit 1
}
if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$output/dex-compile.txt" {
  echo 'FAIL driver printed an error despite zero exit' >&2; exit 1
}
test -s "$output/rounding.dex"
sha256sum "$output/rounding.dex" > "$output/dex-sha256.txt"
printf 'dex_emission\tPASS\nart_execution\tNOT_RUN\n' >> "$output/result.tsv"
printf '\033[32mPASS\033[0m emission only; run PackageRoundingObserver under ART before claiming runtime acceptance\n'
