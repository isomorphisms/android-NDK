#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 6) { echo 'usage: grease verify.grease REPOSITORY FRONTEND DRIVER BAKSMALI SMALI FRESH_OUTPUT' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var baksmali = ARGV[3]
var smali = ARGV[4]
var output = ARGV[5]
for path in (ARGV) { if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 } }
if test -e "$output" { echo 'FAIL refusing reused output-array evidence' >&2; exit 1 }
command -v rg
test $(git -C "$frontend" rev-parse HEAD) = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
var source = "$repository/examples/autogenerated/synchronous-output-array"
var compiler = "$frontend/_/build/exec/idris2_app/idris2.so"
var scheme = "$frontend/_/.tools/bin/scheme"
setglobal ENV.LD_LIBRARY_PATH = "$frontend/_/build/exec/idris2_app"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$repository/dex/idric/build/ttc"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/support/c"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
mkdir -p "$output/positive" "$output/repeat" "$output/mutant/source" "$output/maps" "$output/contract"
git -C "$repository" rev-parse HEAD > "$output/source-revision.txt"
git -C "$repository" diff -- dex/idric/src > "$output/backend.patch"
sha256sum "$source/OutputArray.idric" "$source/output-jni.tsv" \
  "$source/OutputArrayContractCheck.idr" "$source/OutputArrayRunner.smali" \
  "$repository/dex/idric/src/Backend/DEX/NativeContract.idr" \
  "$repository/dex/idric/src/Backend/DEX/Heap.idr" > "$output/sources.sha256"
proc no_diagnostics(log) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" }
  var status = _error.code
  if (status !== 1) { echo 'FAIL source diagnostics or diagnostic checker' >&2; exit 1 }
}
proc emit(directory, destination) {
  "$driver" --cg dex --directive managed-exports --directive "jni-map=$source/output-jni.tsv" \
    --source-dir "$directory" --build-dir "$destination/build" --output-dir "$destination" \
    "$directory/OutputArray.idric" -o candidate > "$destination/compiler.txt" 2>&1
  no_diagnostics "$destination/compiler.txt"
  test -s "$destination/candidate.dex"
  java -jar "$baksmali" disassemble "$destination/candidate.dex" -o "$destination/decoded"
}
"$scheme" --program "$compiler" -p idris2 --source-dir "$source" --build-dir "$output/contract/build" \
  --output-dir "$output/contract" "$source/OutputArrayContractCheck.idr" -o check \
  > "$output/contract/compiler.txt" 2>&1
no_diagnostics "$output/contract/compiler.txt"
cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$output/contract/check_app/"
"$output/contract/check" > "$output/contract/result.txt" 2>&1
cat "$output/contract/result.txt"
rg -x -F 'PASS synchronous Int32 output-array contract and exact scalar widths' "$output/contract/result.txt"
emit "$source" "$output/positive"
emit "$source" "$output/repeat"
cmp "$output/positive/candidate.dex" "$output/repeat/candidate.dex"
var decoded = "$output/positive/decoded/Idric/Generated.smali"
rg -x -F '.method public static native renderOutput(JIIIDDDD[I)I' "$decoded"
rg -x -F '.method public static render_into([I)I' "$decoded"
rg -F 'Ljava/lang/Double;->doubleValue()D' "$decoded"
rg -F 'JNI synchronous output-array contract rejects null output array' "$decoded"
sed 's/render_output 16777217/render_output 16777218/g' "$source/OutputArray.idric" > "$output/mutant/source/OutputArray.idric"
emit "$output/mutant/source" "$output/mutant"
try { cmp -s "$output/positive/candidate.dex" "$output/mutant/candidate.dex" }
var mutation_status = _error.code
if (mutation_status !== 1) { echo 'FAIL unchanged output-array source mutant' >&2; exit 1 }
proc refuse_map(name, link_map, reason) {
  mkdir -p "$output/$name"
  try {
    "$driver" --cg dex --directive managed-exports --directive "jni-map=$link_map" \
      --source-dir "$source" --build-dir "$output/$name/build" --output-dir "$output/$name" \
      "$source/OutputArray.idric" -o candidate > "$output/$name/compiler.txt" 2>&1
  }
  var status = _error.code
  if (status !== 1) { echo "FAIL missing output policy refusal: $name" >&2; exit 1 }
  rg -F "$reason" "$output/$name/compiler.txt"
  if test -e "$output/$name/candidate.dex" { echo 'FAIL refusal published DEX' >&2; exit 1 }
}
sed 's/(JIIIDDDD\[I)I/(IIIIDDDD[I)I/' "$source/output-jni.tsv" > "$output/maps/handle.tsv"
sed 's/(JIIIDDDD\[I)I/(JIIIJDDD[I)I/' "$source/output-jni.tsv" > "$output/maps/double.tsv"
sed 's/nonnull-output publish-output-on-success/nonnull-inputs copy-input-arrays/' "$source/output-jni.tsv" > "$output/maps/input.tsv"
sed 's/ synchronous / asynchronous /' "$source/output-jni.tsv" > "$output/maps/async.tsv"
sed 's/ borrowed-local / retained-global /' "$source/output-jni.tsv" > "$output/maps/retained.tsv"
sed 's/\[I)I/[D)I/' "$source/output-jni.tsv" > "$output/maps/output-kind.tsv"
sed 's/)I /)J /' "$source/output-jni.tsv" > "$output/maps/result.tsv"
refuse_map wrong-handle "$output/maps/handle.tsv" 'source argument type does not match its descriptor'
refuse_map wrong-double "$output/maps/double.tsv" 'source argument type does not match its descriptor'
refuse_map input-is-not-output "$output/maps/input.tsv" 'Copy-input-array JNI contract requires'
refuse_map asynchronous "$output/maps/async.tsv" 'Unsupported JNI'
refuse_map retained "$output/maps/retained.tsv" 'Unsupported JNI'
refuse_map wrong-output-kind "$output/maps/output-kind.tsv" 'Synchronous output-array JNI contract requires'
refuse_map wrong-result "$output/maps/result.tsv" 'Synchronous output-array JNI contract requires'
java -jar "$smali" assemble "$source/OutputArrayRunner.smali" -o "$output/runner.dex"
java -jar "$baksmali" disassemble "$output/runner.dex" -o "$output/runner-decoded"
sha256sum "$output/positive/candidate.dex" "$output/repeat/candidate.dex" \
  "$output/mutant/candidate.dex" "$output/runner.dex" > "$output/candidates.sha256"
printf 'output_policy_source_generation\tPASS\nexact_mixed_scalar_widths\tPASS\nrefusals\tPASS\nJNI_ART\tNOT_RUN\nphysical_device\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m explicit output policy, source generation, independent decode and refusals; JNI/ART separate\n'
