#!/usr/bin/env grease
if (len(ARGV) !== 5) { echo 'usage: grease prepare.grease REPOSITORY FRONTEND DRIVER BAKSMALI EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var baksmali = ARGV[3]
var evidence = ARGV[4]
var source = "$repository/examples/autogenerated/jni-contracts"
var compiler = "$frontend/_/build/exec/idris2"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/support/c"
setglobal ENV.IDRIS2_PATH = "$repository/dex/idric/build/ttc"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
if test -e "$evidence" { echo 'FAIL refusing reused JNI build evidence' >&2; exit 1 }
mkdir -p "$evidence"
"$compiler" -p idris2 --source-dir "$source" --build-dir "$evidence/host" \
  "$source/NativeContractChecks.idric" -o native-contract-checks > "$evidence/host-build.log" 2>&1
if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$evidence/host-build.log" { cat "$evidence/host-build.log" >&2; exit 1 }
cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$evidence/host/exec/native-contract-checks_app/"
"$evidence/host/exec/native-contract-checks" > "$evidence/host-result.txt"
rg -x 'PASS JNI explicit contracts, legacy behavior and refusal controls' "$evidence/host-result.txt"
"$driver" --cg dex --directive "jni-map=$source/explicit-jni.tsv" --source-dir "$source" \
  --build-dir "$evidence/explicit-build" --output-dir "$evidence" "$source/NativeIdentity.idric" -o native-contract
"$driver" --cg dex --directive "jni-map=$source/legacy-jni.tsv" --source-dir "$source" \
  --build-dir "$evidence/legacy-build" --output-dir "$evidence/legacy" "$source/NativeIdentity.idric" -o native-contract
java -jar "$baksmali" disassemble "$evidence/native-contract.dex" -o "$evidence/decoded"
java -jar "$baksmali" disassemble "$evidence/legacy/native-contract.dex" -o "$evidence/legacy-decoded"
rg -F 'JNI contract rejects null String argument' "$evidence/decoded/Idric/Generated.smali"
rg -F 'JNI contract rejects null String result' "$evidence/decoded/Idric/Generated.smali"
if rg -F 'JNI contract rejects null String' "$evidence/legacy-decoded/Idric/Generated.smali" { echo 'FAIL legacy null behavior changed' >&2; exit 1 }
printf '%s\n' 'library_property contract.library' \
  'C:contract_identity,libcontract identity (Ljava/lang/String;)Ljava/lang/String; current-thread synchronous retained-global nonnull-strings propagate-exceptions' > "$evidence/retained.tsv"
var refusal = 0
try {
  "$driver" --cg dex --directive "jni-map=$evidence/retained.tsv" --source-dir "$source" \
    --build-dir "$evidence/refused-build" --output-dir "$evidence/refused" "$source/NativeIdentity.idric" -o refused > "$evidence/refused.log" 2>&1
}
setvar refusal = _error.code
if (refusal === 0) { echo 'FAIL unimplemented reference retention accepted' >&2; exit 1 }
if test -e "$evidence/refused/refused.dex" { echo 'FAIL refused contract left candidate DEX' >&2; exit 1 }
rg -F 'Unsupported JNI contract' "$evidence/refused.log"
sha256sum "$evidence/native-contract.dex" "$evidence/legacy/native-contract.dex" > "$evidence/artifacts.sha256"
printf '\033[32mPASS\033[0m JNI contract host controls, checked DEX and independent decode; ART not run\n'
