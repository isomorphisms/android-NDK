#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 11) {
  echo 'usage: grease verify.grease BACKEND SDK MANIFEST RESOURCES MAIN_DEX AUX_DEX X64_ELF KEYSTORE PACKAGE CERTIFICATE NEW_EVIDENCE' >&2; exit 2
}
var repository = ARGV[0]
var sdk = ARGV[1]
var manifest = ARGV[2]
var resources = ARGV[3]
var main_dex = ARGV[4]
var aux_dex = ARGV[5]
var native = ARGV[6]
var keystore = ARGV[7]
var package = ARGV[8]
var certificate = ARGV[9]
var evidence = ARGV[10]
for path in "$repository" "$sdk" "$manifest" "$resources" "$main_dex" "$aux_dex" "$native" "$keystore" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute qualification input required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused payload qualification' >&2; exit 2 }
mkdir -p "$evidence/payload/lib/x86_64" "$evidence/payload/assets"
cp "$aux_dex" "$evidence/payload/classes2.dex"
cp "$aux_dex" "$evidence/payload/assets/checked-worker.dex"
cp "$native" "$evidence/payload/lib/x86_64/libib_reader.so"
cp "$repository/examples/autogenerated/native-apk-payload/attempt.md" "$evidence/payload/assets/payload-record.md"
var grease = ENV.IB_GREASE
var producer = "$repository/apk/build-direct-dex-activity.grease"
"$grease" "$producer" "$sdk" "$manifest" "$resources" "$main_dex" "$keystore" \
  "$package" "$certificate" "$evidence/positive" "$evidence/payload" > "$evidence/positive.txt" 2>&1
cat "$evidence/positive.txt"
test -s "$evidence/positive/ib-material-reader.apk"
for control in wrong-abi symlink primary-override dex-gap corrupted-dex corrupted-dex-asset {
  var payload = "$evidence/$control-payload"
  cp -R "$evidence/payload" "$payload"
  var marker = 'FAIL payload ELF ABI differs from directory identity'
  if (control === 'wrong-abi') {
    mkdir -p "$payload/lib/arm64-v8a"
    cp "$native" "$payload/lib/arm64-v8a/libib_reader.so"
  }
  if (control === 'symlink') {
    ln -s "$main_dex" "$payload/assets/alias.dex"
    setvar marker = 'FAIL payload contains a symlink or special file'
  }
  if (control === 'primary-override') {
    cp "$aux_dex" "$payload/classes.dex"
    setvar marker = 'FAIL undeclared payload entry'
  }
  if (control === 'dex-gap') {
    mv "$payload/classes2.dex" "$payload/classes3.dex"
    setvar marker = 'FAIL noncontiguous payload DEX sequence'
  }
  if (control === 'corrupted-dex') {
    printf '\000\000\000\000' | dd of="$payload/classes2.dex" bs=1 seek=32 conv=notrunc status=none
    setvar marker = 'FAIL payload DEX integrity'
  }
  if (control === 'corrupted-dex-asset') {
    printf '\000\000\000\000' | dd of="$payload/assets/checked-worker.dex" bs=1 seek=32 conv=notrunc status=none
    setvar marker = 'FAIL payload DEX integrity'
  }
  try {
    "$grease" "$producer" "$sdk" "$manifest" "$resources" "$main_dex" "$keystore" \
      "$package" "$certificate" "$evidence/$control" "$payload" > "$evidence/$control.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/$control.exit"
  if (status !== 1) { cat "$evidence/$control.txt"; echo "FAIL wrong payload refusal: $control" >&2; exit 1 }
  rg -x -F "$marker" "$evidence/$control.txt"
  if test -e "$evidence/$control/ib-material-reader.apk" { echo 'FAIL refused payload exposed final APK' >&2; exit 1 }
}
git -C "$repository" rev-parse HEAD > "$evidence/backend-commit.txt"
sha256sum "$producer" "$main_dex" "$aux_dex" "$native" "$manifest" "$keystore" \
  "$evidence/positive/ib-material-reader.apk" > "$evidence/sha256.txt"
printf 'schema\tchecked-native-apk-payload-v1\npositive_package_and_readback\tPASS\nwrong_ABI\tREJECTED\nsymlink\tREJECTED\nprimary_DEX_override\tREJECTED\nnoncontiguous_DEX\tREJECTED\ncorrupted_DEX\tREJECTED\nART\tNOT_RUN\nphysical_TAB_P10\tNOT_RUN\n' > "$evidence/receipt.tsv"
cat "$evidence/receipt.tsv"
