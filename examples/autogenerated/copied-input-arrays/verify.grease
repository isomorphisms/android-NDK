#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 8) {
  echo 'usage: grease verify.grease REPOSITORY FRONTEND DRIVER BAKSMALI SMALI QUALIFIED_CC NDK FRESH_EVIDENCE' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var baksmali = ARGV[3]
var smali = ARGV[4]
var native_compiler = ARGV[5]
var ndk = ARGV[6]
var evidence = ARGV[7]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL refusing reused copied-array evidence' >&2; exit 1 }
command -v rg > /dev/null
test $(git -C "$frontend" rev-parse HEAD) = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
var compiler = "$frontend/_/build/exec/idris2"
var backend = "$repository/dex/idric"
var source = "$repository/examples/autogenerated/copied-input-arrays"
var toolchain = "$ndk/toolchains/llvm/prebuilt/linux-x86_64"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$backend/build/ttc"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/support/c"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
mkdir -p "$evidence/contract" "$evidence/positive" "$evidence/repeat" "$evidence/mutant/source" "$evidence/maps" \
  "$evidence/typed-handles" "$evidence/typed-repeat" "$evidence/typed-mutant/source"
mkdir -p "$evidence/int64-exports" "$evidence/int64-repeat" "$evidence/int64-automatic" \
  "$evidence/int64-pure-managed" "$evidence/int64-pure-automatic" "$evidence/int64-mutant/source"
git -C "$repository" rev-parse HEAD > "$evidence/source-revision.txt"
git -C "$repository" diff -- dex/idric/src > "$evidence/backend.patch"
sha256sum "$source/CopiedSurface.idric" "$source/copied-jni.tsv" "$source/copied_input_arrays_fixture.c" \
  "$source/CopiedInputArraysRunner.smali" "$source/TypedHandleSource.idric" \
  "$source/typed-handles-jni.tsv" "$source/TypedHandleRunner.smali" \
  "$source/Int64ExportSource.idric" "$source/Int64PureExportSource.idric" \
  "$source/Int64IdentityObserver.smali" "$source/Int64ExportRunner.smali" > "$evidence/source.sha256"
make -C "$backend" driver IDRIC="$compiler"

proc absent_pattern(pattern, path, message) {
  try { rg -n "$pattern" "$path" }
  var status = _error.code
  if (status === 0) { echo "FAIL $message" >&2; exit 1 }
  if (status !== 1) { echo "FAIL checker could not read input: $path" >&2; exit 1 }
}
proc no_diagnostics(log) {
  absent_pattern '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" 'compiler returned success with diagnostics'
}
proc only_matching_lines(pattern, path, message) {
  try { rg -n -v -F "$pattern" "$path" }
  var status = _error.code
  if (status === 0) { echo "FAIL $message" >&2; exit 1 }
  if (status !== 1) { echo "FAIL checker could not read input: $path" >&2; exit 1 }
}
proc different_files(first, second) {
  try { cmp -s "$first" "$second" }
  var status = _error.code
  if (status === 0) { echo 'FAIL unchanged source mutation or candidate' >&2; exit 1 }
  if (status !== 1) { echo 'FAIL source comparison could not read both files' >&2; exit 1 }
}
proc emit_source(directory, output) {
  "$driver" --cg dex --directive managed-exports --directive "jni-map=$source/copied-jni.tsv" \
    --source-dir "$directory" --build-dir "$output/build" --output-dir "$output" \
    "$directory/CopiedSurface.idric" -o candidate > "$output/compiler.txt" 2>&1
  no_diagnostics "$output/compiler.txt"
  test -s "$output/candidate.dex"
  java -jar "$baksmali" disassemble "$output/candidate.dex" -o "$output/decoded"
}
proc emit_typed_handles(directory, output) {
  "$driver" --cg dex --directive managed-exports --directive "jni-map=$source/typed-handles-jni.tsv" \
    --source-dir "$directory" --build-dir "$output/build" --output-dir "$output" \
    "$directory/TypedHandleSource.idric" -o candidate > "$output/compiler.txt" 2>&1
  no_diagnostics "$output/compiler.txt"
  test -s "$output/candidate.dex"
  java -jar "$baksmali" disassemble "$output/candidate.dex" -o "$output/decoded"
}
proc emit_int64_handles(directory, output, mode) {
  if (mode === 'managed') {
    "$driver" --cg dex --directive managed-exports --directive "jni-map=$source/typed-handles-jni.tsv" \
      --source-dir "$directory" --build-dir "$output/build" --output-dir "$output" \
      "$directory/Int64ExportSource.idric" -o candidate > "$output/compiler.txt" 2>&1
  } else {
    if (mode !== 'automatic') { echo 'FAIL unknown Int64 export mode' >&2; exit 1 }
    "$driver" --cg dex --directive "jni-map=$source/typed-handles-jni.tsv" \
      --source-dir "$directory" --build-dir "$output/build" --output-dir "$output" \
      "$directory/Int64ExportSource.idric" -o candidate > "$output/compiler.txt" 2>&1
  }
  no_diagnostics "$output/compiler.txt"
  test -s "$output/candidate.dex"
  java -jar "$baksmali" disassemble "$output/candidate.dex" -o "$output/decoded"
}
proc emit_pure_int64(output, mode) {
  if (mode === 'managed') {
    "$driver" --cg dex --directive managed-exports --source-dir "$source" \
      --build-dir "$output/build" --output-dir "$output" \
      "$source/Int64PureExportSource.idric" -o candidate > "$output/compiler.txt" 2>&1
  } else {
    if (mode !== 'automatic') { echo 'FAIL unknown pure Int64 export mode' >&2; exit 1 }
    "$driver" --cg dex --source-dir "$source" --build-dir "$output/build" --output-dir "$output" \
      "$source/Int64PureExportSource.idric" -o candidate > "$output/compiler.txt" 2>&1
  }
  no_diagnostics "$output/compiler.txt"
  test -s "$output/candidate.dex"
  java -jar "$baksmali" disassemble "$output/candidate.dex" -o "$output/decoded"
}

printf '\033[36mACTION\033[0m check copied-array ownership policy and generated boundary plan\n'
"$compiler" -p idris2 --source-dir "$source" --build-dir "$evidence/contract/build" \
  --output-dir "$evidence/contract" "$source/CopiedArrayContractCheck.idr" -o check \
  > "$evidence/contract/compiler.txt" 2>&1
no_diagnostics "$evidence/contract/compiler.txt"
cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$evidence/contract/check_app/"
"$evidence/contract/check" > "$evidence/contract/output.txt" 2>&1
cat "$evidence/contract/output.txt"
rg -x -F 'PASS typed copied-array JNI contracts and preserved refusals' "$evidence/contract/output.txt"

printf '\033[36mACTION\033[0m compile records and lists through actual primitive arrays and generated JNI\n'
emit_source "$source" "$evidence/positive"
emit_source "$source" "$evidence/repeat"
cmp "$evidence/positive/candidate.dex" "$evidence/repeat/candidate.dex"
var decoded = "$evidence/positive/decoded/Idric/Generated.smali"
for signature in \
  '.method public static produce_surface(I)I' \
  '.method public static copy_arrays([D[I)I' \
  '.method public static native copySurface(IIIIIII[D[I)J' \
  'Ljava/nio/DoubleBuffer;->allocate(I)Ljava/nio/DoubleBuffer;' \
  'Ljava/nio/DoubleBuffer;->put(ID)Ljava/nio/DoubleBuffer;' \
  'Ljava/nio/DoubleBuffer;->array()[D' \
  'Ljava/nio/IntBuffer;->put(II)Ljava/nio/IntBuffer;' \
  'Ljava/nio/IntBuffer;->array()[I' \
  'LIdric/Generated;->copySurface(IIIIIII[D[I)J' \
  'JNI copy-input-array contract rejects null input array' {
  rg -F "$signature" "$decoded"
}
rg 'check-cast .*, \[D' "$decoded"
rg 'check-cast .*, \[I' "$decoded"
absent_pattern '^\.method public static main\(' "$decoded" 'selected exports acquired a command entry'
sed 's/MkTerm (cast input) 2 0 0/MkTerm (cast (input + 1)) 2 0 0/' "$source/CopiedSurface.idric" \
  > "$evidence/mutant/source/CopiedSurface.idric"
different_files "$source/CopiedSurface.idric" "$evidence/mutant/source/CopiedSurface.idric"
emit_source "$evidence/mutant/source" "$evidence/mutant"
different_files "$evidence/positive/candidate.dex" "$evidence/mutant/candidate.dex"
java -jar "$smali" assemble "$source/CopiedInputArraysRunner.smali" -o "$evidence/runner.dex"
java -jar "$baksmali" disassemble "$evidence/runner.dex" -o "$evidence/runner-decoded"

printf '\033[36mACTION\033[0m compile exact typed scalar handle calls around the shared array producer\n'
emit_typed_handles "$source" "$evidence/typed-handles"
emit_typed_handles "$source" "$evidence/typed-repeat"
cmp "$evidence/typed-handles/candidate.dex" "$evidence/typed-repeat/candidate.dex"
var typed_decoded = "$evidence/typed-handles/decoded/Idric/Generated.smali"
for signature in \
  '.method public static typed_handle_bits(I)Ljava/lang/String;' \
  'LIdric/Generated;->lastHandle()J' \
  'LIdric/Generated;->coefficientCount(J)I' \
  'LIdric/Generated;->coefficientBits(JI)J' \
  'LIdric/Generated;->releaseSurface(J)V' {
  rg -F "$signature" "$typed_decoded"
}
sed 's/prepared_surface_handle input/prepared_surface_handle (input + 1)/' "$source/TypedHandleSource.idric" \
  > "$evidence/typed-mutant/source/TypedHandleSource.idric"
cp "$source/CopiedSurface.idric" "$evidence/typed-mutant/source/CopiedSurface.idric"
cmp "$source/CopiedSurface.idric" "$evidence/typed-mutant/source/CopiedSurface.idric"
different_files "$source/TypedHandleSource.idric" "$evidence/typed-mutant/source/TypedHandleSource.idric"
emit_typed_handles "$evidence/typed-mutant/source" "$evidence/typed-mutant"
different_files "$evidence/typed-handles/candidate.dex" "$evidence/typed-mutant/candidate.dex"
java -jar "$smali" assemble "$source/TypedHandleRunner.smali" -o "$evidence/typed-runner.dex"
java -jar "$baksmali" disassemble "$evidence/typed-runner.dex" -o "$evidence/typed-runner-decoded"

printf '\033[36mACTION\033[0m compile signed Int64 exports and real native handles through paired public ABI\n'
emit_int64_handles "$source" "$evidence/int64-exports" managed
emit_int64_handles "$source" "$evidence/int64-repeat" managed
emit_int64_handles "$source" "$evidence/int64-automatic" automatic
cmp "$evidence/int64-exports/candidate.dex" "$evidence/int64-repeat/candidate.dex"
cmp "$evidence/int64-exports/candidate.dex" "$evidence/int64-automatic/candidate.dex"
var int64_decoded = "$evidence/int64-exports/decoded/Idric/Generated.smali"
for signature in \
  '.method public static int64_identity(J)J' \
  '.method public static int64_io_identity(J)J' \
  '.method public static int64_after_int32(IJ)J' \
  '.method public static int64_before_int32(JI)J' \
  '.method public static select_int64_argument(JIJ)J' \
  '.method public static create_surface_handle(I)J' \
  '.method public static actual_prepare_handle(Ljava/lang/String;)J' {
  rg -x -F "$signature" "$int64_decoded"
}
emit_pure_int64 "$evidence/int64-pure-managed" managed
emit_pure_int64 "$evidence/int64-pure-automatic" automatic
cmp "$evidence/int64-pure-managed/candidate.dex" "$evidence/int64-pure-automatic/candidate.dex"
rg -x -F '.method public static int64_identity(J)J' "$evidence/int64-pure-automatic/decoded/Idric/Generated.smali"
sed 's/int64_io_identity value = pure value/int64_io_identity value = pure (value + 1)/' \
  "$source/Int64ExportSource.idric" > "$evidence/int64-mutant/source/Int64ExportSource.idric"
cp "$source/CopiedSurface.idric" "$evidence/int64-mutant/source/CopiedSurface.idric"
cmp "$source/CopiedSurface.idric" "$evidence/int64-mutant/source/CopiedSurface.idric"
different_files "$source/Int64ExportSource.idric" "$evidence/int64-mutant/source/Int64ExportSource.idric"
emit_int64_handles "$evidence/int64-mutant/source" "$evidence/int64-mutant" managed
different_files "$evidence/int64-exports/candidate.dex" "$evidence/int64-mutant/candidate.dex"
java -jar "$smali" assemble "$source/Int64IdentityObserver.smali" "$source/Int64ExportRunner.smali" -o "$evidence/int64-runner.dex"
java -jar "$baksmali" disassemble "$evidence/int64-runner.dex" -o "$evidence/int64-runner-decoded"

proc refuse_source(module, diagnostic) {
  var output = "$evidence/refuse-$module"
  mkdir -p "$output"
  "$driver" --source-dir "$source" --build-dir "$output/check" --check "$source/$module.idric" \
    > "$output/typecheck.txt" 2>&1
  no_diagnostics "$output/typecheck.txt"
  try {
    "$driver" --cg dex --directive managed-exports --source-dir "$source" \
      --build-dir "$output/build" --output-dir "$output" "$source/$module.idric" -o candidate \
      > "$output/compiler.txt" 2>&1
  }
  var status = _error.code
  cat "$output/compiler.txt"
  printf '%s\n' "$status" > "$output/compiler.exit"
  if (status !== 1) { echo "FAIL intended source refusal missing: $module" >&2; exit 1 }
  test ! -e "$output/candidate.dex"
  rg -F "$diagnostic" "$output/compiler.txt"
}
refuse_source OrdinaryArrayDomain 'is ordinary algebraic data, not an external reference'
refuse_source ConflictingArrayDomain 'has conflicting descriptors'
refuse_source UnsupportedFloatArray 'DEX array descriptors admit only checked primitive [D/[I references'
refuse_source UnsupportedNestedArray 'DEX array descriptors admit only checked primitive [D/[I references'
refuse_source UnsupportedReferenceArray 'DEX array descriptors admit only checked primitive [D/[I references'
refuse_source UnsupportedArrayOwner 'Invalid DEX reference descriptor'
refuse_source UnsupportedArrayConstruction 'Invalid DEX reference descriptor'
refuse_source UnsupportedDefaultIntExport 'unsupported source primitive type'
refuse_source UnsupportedDoubleHandleExport 'unsupported source primitive type'

proc refuse_map(label, map, module, diagnostic) {
  var output = "$evidence/refuse-$label"
  mkdir -p "$output"
  "$driver" --source-dir "$source" --build-dir "$output/check" --check "$source/$module.idric" \
    > "$output/typecheck.txt" 2>&1
  no_diagnostics "$output/typecheck.txt"
  try {
    "$driver" --cg dex --directive managed-exports --directive "jni-map=$map" --source-dir "$source" \
      --build-dir "$output/build" --output-dir "$output" "$source/$module.idric" -o candidate \
      > "$output/compiler.txt" 2>&1
  }
  var status = _error.code
  cat "$output/compiler.txt"
  printf '%s\n' "$status" > "$output/compiler.exit"
  if (status !== 1) { echo "FAIL intended native-policy refusal missing: $label" >&2; exit 1 }
  test ! -e "$output/candidate.dex"
  rg -F "$diagnostic" "$output/compiler.txt"
}
printf '%s\n' 'library_property copiedarrays.library' \
  'C:unqualified_array,libcopiedarrays unqualifiedArray ([D)J' > "$evidence/maps/legacy.tsv"
cp "$source/copied-jni.tsv" "$evidence/maps/unused-legacy-array.tsv"
printf '%s\n' 'C:unused_array,libcopiedarrays unusedArray ([D)J' >> "$evidence/maps/unused-legacy-array.tsv"
printf '%s\n' 'library_property copiedarrays.library' \
  'C:unqualified_array,libcopiedarrays unqualifiedArray ([D)J current-thread synchronous borrowed-local nonnull-strings propagate-exceptions' \
  > "$evidence/maps/scalar-only.tsv"
printf '%s\n' 'library_property copiedarrays.library' \
  'C:ordinary_native_array,libcopiedarrays ordinaryNativeArray ([D)J current-thread synchronous borrowed-local nonnull-inputs copy-input-arrays propagate-exceptions' \
  > "$evidence/maps/ordinary-native.tsv"
printf '%s\n' 'library_property copiedarrays.library' \
  'C:conflicting_native_array,libcopiedarrays conflictingNativeArray ([I)J current-thread synchronous borrowed-local nonnull-inputs copy-input-arrays propagate-exceptions' \
  > "$evidence/maps/conflicting-native.tsv"
sed 's/borrowed-local nonnull-inputs/retained-global nonnull-inputs/' "$source/copied-jni.tsv" > "$evidence/maps/retained.tsv"
sed 's/current-thread synchronous/current-thread asynchronous/' "$source/copied-jni.tsv" > "$evidence/maps/async.tsv"
sed 's/nonnull-inputs copy-input-arrays/nullable-inputs copy-input-arrays/' "$source/copied-jni.tsv" > "$evidence/maps/nullable.tsv"
sed 's/(IIIIIII\[D\[I)J/(IIIIIII[D[I)[D/' "$source/copied-jni.tsv" > "$evidence/maps/output-array.tsv"
refuse_map legacy-array "$evidence/maps/legacy.tsv" UnqualifiedArrayNative 'Legacy JNI maps do not admit array descriptors'
refuse_map unused-legacy-array "$evidence/maps/unused-legacy-array.tsv" CopiedSurface 'Legacy JNI maps do not admit array descriptors'
refuse_map scalar-only-array "$evidence/maps/scalar-only.tsv" UnqualifiedArrayNative 'Explicit JNI contract supports int/long/String'
refuse_map ordinary-native-array "$evidence/maps/ordinary-native.tsv" OrdinaryNativeArrayDomain 'is ordinary algebraic data, not an external reference'
refuse_map conflicting-native-array "$evidence/maps/conflicting-native.tsv" ConflictingNativeArrayDomain 'has conflicting descriptors'
refuse_map retained "$evidence/maps/retained.tsv" CopiedSurface 'Unsupported JNI copy-input-array contract'
refuse_map async "$evidence/maps/async.tsv" CopiedSurface 'Unsupported JNI copy-input-array contract'
refuse_map nullable "$evidence/maps/nullable.tsv" CopiedSurface 'Unsupported JNI copy-input-array contract'
refuse_map output-array "$evidence/maps/output-array.tsv" CopiedSurface 'Copy-input-array JNI contract requires'

printf '%s\n' 'library_property copiedarrays.library' \
  'C:wrong_long_argument,libcopiedarrays wrongLongArgument (J)I current-thread synchronous borrowed-local nonnull-strings propagate-exceptions' \
  > "$evidence/maps/wrong-long-argument.tsv"
printf '%s\n' 'library_property copiedarrays.library' \
  'C:wrong_int_argument,libcopiedarrays wrongIntArgument (I)I current-thread synchronous borrowed-local nonnull-strings propagate-exceptions' \
  > "$evidence/maps/wrong-int-argument.tsv"
printf '%s\n' 'library_property copiedarrays.library' \
  'C:wrong_long_result,libcopiedarrays wrongLongResult ()J current-thread synchronous borrowed-local nonnull-strings propagate-exceptions' \
  > "$evidence/maps/wrong-long-result.tsv"
printf '%s\n' 'library_property copiedarrays.library' \
  'C:wrong_int_result,libcopiedarrays wrongIntResult ()I current-thread synchronous borrowed-local nonnull-strings propagate-exceptions' \
  > "$evidence/maps/wrong-int-result.tsv"
refuse_map wrong-long-argument "$evidence/maps/wrong-long-argument.tsv" WrongLongArgument 'JNI synchronous scalar source argument type does not match its descriptor'
refuse_map wrong-int-argument "$evidence/maps/wrong-int-argument.tsv" WrongIntArgument 'JNI synchronous scalar source argument type does not match its descriptor'
refuse_map wrong-long-result "$evidence/maps/wrong-long-result.tsv" WrongLongResult 'JNI synchronous scalar source result type does not match its descriptor'
refuse_map wrong-int-result "$evidence/maps/wrong-int-result.tsv" WrongIntResult 'JNI synchronous scalar source result type does not match its descriptor'

printf '\033[36mACTION\033[0m build the explicit native copy owner with the qualified C driver\n'
test -x "$native_compiler"
test -x "$toolchain/bin/ld.lld"
test -x "$toolchain/bin/llvm-readelf"
test -s "$toolchain/sysroot/usr/include/jni.h"
test -s "$toolchain/sysroot/usr/lib/x86_64-linux-android/29/libc.so"
"$native_compiler" --version > "$evidence/native-compiler-version.txt"
"$native_compiler" -dumpmachine > "$evidence/native-compiler-target.txt"
rg -x 'x86_64[^[:space:]]*-linux[^[:space:]]*' "$evidence/native-compiler-target.txt"
"$toolchain/bin/ld.lld" --version > "$evidence/native-linker-version.txt"
sha256sum "$native_compiler" "$toolchain/bin/ld.lld" "$toolchain/bin/llvm-readelf" "$ndk/source.properties" \
  > "$evidence/native-tools.sha256"
# Reuse the qualified native x86_64 GCC fixture profile: Android headers,
# fixed-width JNI ABI and an explicit bionic link. This does not establish
# general Android ICK code-generation qualification.
"$native_compiler" -m64 --sysroot="$toolchain/sysroot" \
  -isystem "$toolchain/sysroot/usr/include/x86_64-linux-android" \
  -D__ANDROID__ -D__ANDROID_API__=29 -fPIC -ffreestanding -fno-stack-protector \
  -c "$source/copied_input_arrays_fixture.c" -o "$evidence/copied_input_arrays_fixture.o" \
  > "$evidence/native-build.txt" 2>&1
"$toolchain/bin/ld.lld" -shared --no-undefined -soname libcopiedarrays.so \
  "$evidence/copied_input_arrays_fixture.o" -L "$toolchain/sysroot/usr/lib/x86_64-linux-android/29" \
  -lc -o "$evidence/libcopiedarrays.so" > "$evidence/native-link.txt" 2>&1
"$toolchain/bin/llvm-readelf" -h "$evidence/libcopiedarrays.so" > "$evidence/native-elf-header.txt"
rg -F 'Advanced Micro Devices X86-64' "$evidence/native-elf-header.txt"
rg 'Class:.*ELF64' "$evidence/native-elf-header.txt"
"$toolchain/bin/llvm-readelf" --dynamic --version-info "$evidence/libcopiedarrays.so" > "$evidence/native-dynamic.txt"
rg 'NEEDED' "$evidence/native-dynamic.txt" > "$evidence/native-needed.txt"
rg -F '[libc.so]' "$evidence/native-needed.txt"
only_matching_lines '[libc.so]' "$evidence/native-needed.txt" 'native fixture depends on an unexpected library'
absent_pattern 'GLIBC_[0-9]|GLIBC_PRIVATE' "$evidence/native-dynamic.txt" 'host glibc dependency leaked into Android fixture'
sha256sum "$evidence/positive/candidate.dex" "$evidence/repeat/candidate.dex" "$evidence/mutant/candidate.dex" \
  "$evidence/runner.dex" "$evidence/typed-handles/candidate.dex" "$evidence/typed-repeat/candidate.dex" \
  "$evidence/typed-mutant/candidate.dex" "$evidence/typed-runner.dex" \
  "$evidence/int64-exports/candidate.dex" "$evidence/int64-repeat/candidate.dex" "$evidence/int64-automatic/candidate.dex" \
  "$evidence/int64-pure-managed/candidate.dex" "$evidence/int64-pure-automatic/candidate.dex" \
  "$evidence/int64-mutant/candidate.dex" "$evidence/int64-runner.dex" \
  "$evidence/copied_input_arrays_fixture.o" "$evidence/libcopiedarrays.so" > "$evidence/artifacts.sha256"
printf 'checked_source_Dex\tPASS\nrecords_lists_to_primitive_arrays\tPASS\nexplicit_copy_input_array_contract\tPASS\nchecked_typed_scalar_handle_source_Dex\tPASS\nchecked_Int64_public_ABI\tPASS\nautomatic_Int64_managed_lane\tPASS\nindependent_decode\tPASS\ndeterminism\tPASS\nsource_and_policy_refusals\tPASS\nqualified_native_C_fixture\tPASS\nAndroid_bionic_fixture_link\tPASS\ngeneral_Android_ICK_qualification\tNOT_ESTABLISHED\nART\tNOT_RUN\nphysical_A1\tNOT_RUN\nphysical_TAB_P10\tNOT_RUN\n' \
  > "$evidence/host-result.tsv"
printf '\033[32mPASS\033[0m checked copied-array source, native fixture and refusal controls; ART separate\n'
