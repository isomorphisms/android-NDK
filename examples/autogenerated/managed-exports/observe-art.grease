#!/usr/bin/env grease
if (len(ARGV) !== 6) {
  echo 'usage: grease observe-art.grease BACKEND INPUT SMALI_JAR ADB SERIAL NEW_EVIDENCE' >&2
  exit 2
}
var repository = ARGV[0]
var input = ARGV[1]
var smali = ARGV[2]
var adb = ARGV[3]
var serial = ARGV[4]
var evidence = ARGV[5]
for path in "$repository" "$input" "$smali" "$adb" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL evidence already exists' >&2; exit 2 }
mkdir -p "$evidence"
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
"$adb" -s "$serial" shell getprop ro.build.fingerprint > "$evidence/fingerprint.txt"
"$adb" -s "$serial" shell mkdir -p /data/local/tmp/idric-managed-exports
for kind in Generic Search Projection {
  java -jar "$smali" assemble "$repository/examples/autogenerated/managed-exports/${kind}Observer.smali" \
    -o "$evidence/$kind.dex"
  "$adb" -s "$serial" push "$evidence/$kind.dex" "/data/local/tmp/idric-managed-exports/$kind.dex"
}
for name in generic mutant search projection {
  sha256sum -c "$input/$name/output.sha256"
  "$adb" -s "$serial" push "$input/$name/candidate.dex" "/data/local/tmp/idric-managed-exports/$name.dex"
  "$adb" -s "$serial" pull "/data/local/tmp/idric-managed-exports/$name.dex" "$evidence/$name-received.dex"
  cmp "$input/$name/candidate.dex" "$evidence/$name-received.dex"
}
proc execute(name, observer, class, expected_status, expected_text) {
  try {
    timeout 45 "$adb" -s "$serial" shell -T \
      "CLASSPATH=/data/local/tmp/idric-managed-exports/$name.dex:/data/local/tmp/idric-managed-exports/$observer.dex app_process /system/bin $class" \
      > "$evidence/$name.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/$name.exit"
  cat "$evidence/$name.txt"
  if (status !== int(expected_status)) { echo "FAIL unexpected ART process status for $name" >&2; exit 1 }
  rg -x -F "$expected_text" "$evidence/$name.txt"
}
execute generic Generic acceptance.ManagedExportObserver 0 'PASS checked managed exports on ART'
execute mutant Generic acceptance.ManagedExportObserver 73 'FAIL Unicode list/record export'
execute search Search acceptance.SearchExportObserver 0 'PASS unchanged IB search export on ART'
execute projection Projection acceptance.ProjectionExportObserver 0 'PASS unchanged IB source projection on ART'
printf 'managed_exports_ART\tPASS\nsource_mutant\tREJECTED\nunchanged_IB_search_ART\tPASS\nunchanged_IB_projection_ART\tPASS\nActivity_lifecycle\tNOT_RUN\nBinder\tNOT_RUN\nAPK\tNOT_RUN\nphysical_C67\tNOT_RUN\nphysical_A1\tNOT_RUN\n' > "$evidence/receipt.tsv"
printf '\033[32mPASS\033[0m checked managed export semantics and actual IB exports on x86_64 ART\n'
