#!/usr/bin/env grease
if (len(ARGV) !== 6) {
  echo 'usage: grease verify.grease BACKEND FRONTEND BAKSMALI IB_SEARCH IB_READER NEW_EVIDENCE' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var baksmali = ARGV[2]
var search = ARGV[3]
var reader = ARGV[4]
var evidence = ARGV[5]
for path in "$repository" "$frontend" "$baksmali" "$search" "$reader" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL evidence already exists' >&2; exit 2 }
mkdir -p "$evidence/search-source/IB" "$evidence/projection-source"
var prefix = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PREFIX = prefix
setglobal ENV.IDRIS2_PACKAGE_PATH = "$prefix/idris2-0.8.0"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
var driver = "$repository/dex/idric/build/exec/idric-dex"
git -C "$repository" rev-parse HEAD > "$evidence/backend-ref.txt"
git -C "$repository" diff --binary HEAD > "$evidence/backend.patch"
git -C "$frontend" rev-parse HEAD > "$evidence/frontend-ref.txt"
git -C "$search" rev-parse HEAD > "$evidence/search-ref.txt"
git -C "$reader" rev-parse HEAD > "$evidence/reader-ref.txt"
cp "$search/src/IB/WebSearch.idric" "$evidence/search-source/IB/"
cp "$search/examples/autogenerated/chordsearch/SearchIntentRequest.idric" "$evidence/search-source/"
cp -R "$reader/src/IB" "$evidence/projection-source/"
cp "$reader/examples/autogenerated/native-source-projection/NativeSourceProjection.idric" "$evidence/projection-source/"
sha256sum "$driver" "${driver}_app/idric-dex.so" \
  "$evidence/search-source/SearchIntentRequest.idric" "$evidence/search-source/IB/WebSearch.idric" \
  "$evidence/projection-source/NativeSourceProjection.idric" > "$evidence/inputs.sha256"

proc emit_source(directory, module, name) {
  mkdir -p "$evidence/$name"
  try {
    "$driver" --cg dex --directive managed-exports --source-dir "$directory" \
      --build-dir "$evidence/$name/build" --output-dir "$evidence/$name" \
      --dumpanf "$evidence/$name/source.anf" \
      "$directory/$module.idric" -o candidate > "$evidence/$name/compiler.txt" 2>&1
  }
  var status = _error.code
  cat "$evidence/$name/compiler.txt"
  printf 'compiler_exit\t%s\n' "$status" > "$evidence/$name/result.tsv"
  if (status !== 0) { echo "FAIL checked source generation: $name" >&2; exit 1 }
  if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$evidence/$name/compiler.txt" {
    echo "FAIL compiler diagnostics: $name" >&2; exit 1
  }
  test -s "$evidence/$name/candidate.dex"
  java -jar "$baksmali" disassemble "$evidence/$name/candidate.dex" -o "$evidence/$name/decoded"
  sha256sum "$evidence/$name/candidate.dex" > "$evidence/$name/output.sha256"
}
emit_source "$repository/examples/autogenerated/managed-exports" ManagedExports generic
emit_source "$repository/examples/autogenerated/managed-exports" ManagedExports recovery
cmp "$evidence/generic/candidate.dex" "$evidence/recovery/candidate.dex"
mkdir -p "$evidence/mutant-source" "$evidence/wrong-signature-source"
sed 's/pack (reverse_characters retained.characters \[\])/retained.original/' \
  "$repository/examples/autogenerated/managed-exports/ManagedExports.idric" > "$evidence/mutant-source/ManagedExports.idric"
if cmp -s "$repository/examples/autogenerated/managed-exports/ManagedExports.idric" "$evidence/mutant-source/ManagedExports.idric" {
  echo 'FAIL source mutation did not change the program' >&2; exit 1
}
emit_source "$evidence/mutant-source" ManagedExports mutant
if cmp -s "$evidence/generic/candidate.dex" "$evidence/mutant/candidate.dex" {
  echo 'FAIL semantic source mutation emitted the positive bytes' >&2; exit 1
}
sed 's/length:()I/length:()J/' \
  "$repository/examples/autogenerated/managed-exports/ManagedExports.idric" > "$evidence/wrong-signature-source/ManagedExports.idric"
"$driver" --source-dir "$evidence/wrong-signature-source" --build-dir "$evidence/wrong-signature-check" \
  --check "$evidence/wrong-signature-source/ManagedExports.idric" > "$evidence/wrong-signature-typecheck.txt" 2>&1
mkdir -p "$evidence/wrong-signature"
try {
  "$driver" --cg dex --directive managed-exports --source-dir "$evidence/wrong-signature-source" \
    --build-dir "$evidence/wrong-signature/build" --output-dir "$evidence/wrong-signature" \
    "$evidence/wrong-signature-source/ManagedExports.idric" -o candidate \
    > "$evidence/wrong-signature/compiler.txt" 2>&1
}
if (_error.code === 0) { echo 'FAIL wrong platform signature accepted' >&2; exit 1 }
test ! -e "$evidence/wrong-signature/candidate.dex"
rg -F 'dex foreign result type does not match' "$evidence/wrong-signature/compiler.txt"
emit_source "$evidence/search-source" SearchIntentRequest search
emit_source "$evidence/projection-source" NativeSourceProjection projection
printf 'checked_source_to_dex\tPASS\nindependent_decode\tPASS\ndeterminism\tPASS\nART\tNOT_RUN\nAPK\tNOT_RUN\nphysical_C67\tNOT_RUN\n' > "$evidence/result.tsv"
printf '\033[32mPASS\033[0m managed export emission and actual unchanged IB consumers; ART NOT_RUN\n'
