#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) { echo 'requires BACKEND FRONTEND DRIVER NEW_OUTPUT' >&2; exit 2 }
var backend = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var output = ARGV[3]
for path in "$backend" "$frontend" "$driver" "$output" {
  if (path[0] !== '/') { echo 'absolute path required' >&2; exit 2 }
}
test ! -e "$output"
mkdir -p "$output"
var prefix = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PREFIX = prefix
setglobal ENV.IDRIS2_PACKAGE_PATH = "$prefix/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$backend/dex/idric/build/ttc"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
var source = "$backend/examples/autogenerated/presentation-callback"
"$driver" --cg chez -p idris2 --source-dir "$source" --build-dir "$output/build" \
  --output-dir "$output" "$source/PresentationCallback.idric" -o callback > "$output/compile.txt" 2>&1
cat "$output/compile.txt"
"$output/callback" "$output/Action.dex"
"$output/callback" "$output/repeated.dex"
"$output/callback" "$output/wrong-signature.dex" --wrong-signature
cmp "$output/Action.dex" "$output/repeated.dex"
cmp "$output/Action.dex" "$backend/native/presentation/Action.dex"
if cmp -s "$output/Action.dex" "$output/wrong-signature.dex" { echo 'FAIL mutation ineffective' >&2; exit 1 }
sha256sum "$source/PresentationCallback.idric" "$output/Action.dex" "$output/wrong-signature.dex" > "$output/digests.txt"
printf '\033[32mPASS\033[0m typed framework callback emission, reproducibility and distinct wrong-signature control\n'
echo 'NOT_RUN ART, application callbacks and physical devices'
