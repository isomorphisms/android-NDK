#!/usr/bin/env grease
if (len(ARGV) !== 4) {
  echo 'usage: grease verify-art.grease REPOSITORY EVIDENCE SMALI_JAR ADB' >&2
  exit 2
}
var repository = ARGV[0]
var evidence = ARGV[1]
var smali = ARGV[2]
var adb = ARGV[3]
for path in "$repository" "$evidence" "$smali" "$adb" {
  if (len(path) === 0 or path[0] !== '/') { echo 'absolute path required' >&2; exit 2 }
}
var runtime = "$evidence/art"
if test -e "$runtime" { echo 'refusing reused loop-value ART evidence' >&2; exit 1 }
mkdir -p "$runtime/runner"
cp "$repository/examples/autogenerated/source-loop-values/LoopValueRunner.smali" "$runtime/runner/"
# smali is the external oracle's assembler; it never compiles application source.
java -jar "$smali" assemble "$runtime/runner" -o "$runtime/runner.dex"
test -s "$runtime/runner.dex"
"$adb" -s emulator-5554 get-state
"$adb" -s emulator-5554 shell getprop ro.build.fingerprint > "$runtime/fingerprint.txt"
"$adb" -s emulator-5554 shell getprop ro.build.version.sdk > "$runtime/sdk.txt"
"$adb" -s emulator-5554 shell getprop ro.product.cpu.abi > "$runtime/abi.txt"
"$adb" -s emulator-5554 shell mkdir -p /data/local/tmp/idric-loop-values
proc execute(name, expected, expected_status) {
  var candidate = "$evidence/$name/candidate.dex"
  test -s "$candidate"
  sha256sum -c "$evidence/$name/sha256.txt"
  "$adb" -s emulator-5554 push "$candidate" "/data/local/tmp/idric-loop-values/$name.dex"
  "$adb" -s emulator-5554 push "$runtime/runner.dex" "/data/local/tmp/idric-loop-values/$name-runner.dex"
  "$adb" -s emulator-5554 shell chmod 0444 "/data/local/tmp/idric-loop-values/$name.dex" "/data/local/tmp/idric-loop-values/$name-runner.dex"
  "$adb" -s emulator-5554 pull "/data/local/tmp/idric-loop-values/$name.dex" "$runtime/$name-received.dex"
  "$adb" -s emulator-5554 pull "/data/local/tmp/idric-loop-values/$name-runner.dex" "$runtime/$name-runner-received.dex"
  cmp "$candidate" "$runtime/$name-received.dex"
  cmp "$runtime/runner.dex" "$runtime/$name-runner-received.dex"
  try {
    "$adb" -s emulator-5554 shell "CLASSPATH=/data/local/tmp/idric-loop-values/$name-runner.dex:/data/local/tmp/idric-loop-values/$name.dex app_process /system/bin Idric.LoopValueRunner" > "$runtime/$name.txt" 2>&1
  }
  var status = _error.code
  printf 'process_exit=%s\n' "$status" > "$runtime/$name-status.txt"
  cat "$runtime/$name.txt"
  if (status !== int(expected_status)) { echo 'FAIL unexpected ART oracle status' >&2; exit 1 }
  rg -q -x -F "$expected" "$runtime/$name.txt"
  sha256sum "$candidate" "$runtime/runner.dex" "$runtime/$name-received.dex" > "$runtime/$name-sha256.txt"
}
execute positive 'PASS checked source loop values on ART' 0
execute flag 'FAIL true flag' 73
execute text 'FAIL Unicode fallback' 73
echo 'PASS actual checked loop values and two source mutations on ART' > "$runtime/result.txt"
echo 'NOT_RUN canonical IB recovery, Activity callbacks, APK, physical device and producer qualification' >> "$runtime/result.txt"
cat "$runtime/result.txt"
