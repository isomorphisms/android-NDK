#!/usr/bin/env grease
if (len(ARGV) !== 8) {
  echo 'usage: grease verify.grease GREASE BACKEND CORE SCHEME DRIVER BACKEND_TTC DEXDUMP NEW_OUTPUT' >&2
  exit 2
}
var grease = ARGV[0]
var backend = ARGV[1]
var core = ARGV[2]
var scheme = ARGV[3]
var driver = ARGV[4]
var modules = ARGV[5]
var dexdump = ARGV[6]
var evidence = ARGV[7]
for path in "$grease" "$backend" "$core" "$scheme" "$driver" "$modules" "$dexdump" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { echo 'absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'refusing reused loop-value evidence' >&2; exit 1 }
var source = "$backend/examples/autogenerated/source-loop-values"
mkdir -p "$evidence"
git -C "$backend" rev-parse HEAD 'HEAD^{tree}' > "$evidence/backend-revision.txt"
git -C "$backend" diff --binary HEAD > "$evidence/backend-local.patch"
git -C "$core" rev-parse HEAD > "$evidence/core-revision.txt"
sha256sum "$driver" "$backend/dex/idric/src/Backend/DEX/Unpack.idr" "$backend/dex/idric/src/Backend/DEX/Encode.idr" \
  "$source/LoopValues.idric" "$source/LoopValueChecks.idric" "$source/StringEncodingChecks.idric" \
  "$source/WideLoopValue.idric" "$source/WideByteLoop.idric" > "$evidence/input-sha256.txt"
"$grease" "$source/host-checks.grease" "$backend" "$core" "$scheme" "$modules" "$evidence/host"

proc compile_candidate(directory, name) {
  "$grease" "$source/probe.grease" "$core" "$scheme" "$driver" "$modules" "$directory" LoopValues.idric "$evidence/$name"
  "$dexdump" -c "$evidence/$name/candidate.dex" > "$evidence/$name/checksum.txt" 2>&1
  "$dexdump" -d "$evidence/$name/candidate.dex" > "$evidence/$name/disassembly.txt" 2>&1
}
compile_candidate "$source" positive
for mutation in flag text {
  var directory = "$evidence/$mutation-source"
  mkdir -p "$directory"
  if (mutation === 'flag') {
    sed 's/scan_flag True rest/scan_flag False rest/' "$source/LoopValues.idric" > "$directory/LoopValues.idric"
  } else {
    sed 's/fallback λ𝄞/fallback changed/' "$source/LoopValues.idric" > "$directory/LoopValues.idric"
  }
  if cmp -s "$source/LoopValues.idric" "$directory/LoopValues.idric" { echo 'FAIL no source mutation' >&2; exit 1 }
  compile_candidate "$directory" "$mutation"
}
proc require_refusal(file, name, diagnostic) {
  try { "$grease" "$source/probe.grease" "$core" "$scheme" "$driver" "$modules" "$source" "$file" "$evidence/$name" }
  if (_error.code === 0) { echo 'FAIL unsupported loop value accepted' >&2; exit 1 }
  test -s "$evidence/$name/source-check.txt"
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$evidence/$name/source-check.txt" }
  if (_error.code !== 1) { echo 'FAIL refusal source did not typecheck' >&2; exit 1 }
  rg -q -F "$diagnostic" "$evidence/$name/compile.txt"
  if test -e "$evidence/$name/candidate.dex" { echo 'FAIL refused value emitted DEX' >&2; exit 1 }
}
require_refusal WideLoopValue.idric wide 'unbounded Integer literal 0'
require_refusal WideByteLoop.idric byte 'DEX tail-loop byte literal has no qualified binary flag representation'
echo 'PASS source loop controls, independent DEX parsing and numeric refusals' > "$evidence/result.txt"
echo 'NOT_RUN ART; no source collection/record representation is qualified here' >> "$evidence/result.txt"
cat "$evidence/result.txt"
