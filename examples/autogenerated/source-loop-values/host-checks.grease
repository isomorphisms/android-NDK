#!/usr/bin/env grease
if (len(ARGV) !== 5) { echo 'usage: grease host-checks.grease BACKEND CORE SCHEME BACKEND_TTC NEW_OUTPUT' >&2; exit 2 }
var backend = ARGV[0]
var core = ARGV[1]
var scheme = ARGV[2]
var modules = ARGV[3]
var output = ARGV[4]
for path in "$backend" "$core" "$scheme" "$modules" "$output" {
  if (len(path) === 0 or path[0] !== '/') { echo 'absolute path required' >&2; exit 2 }
}
if test -e "$output" { echo 'refusing reused host evidence' >&2; exit 1 }
var prefix = "$core/_/bootstrap-build"
var compiler = "$core/_/build/exec/idris2"
var source = "$backend/examples/autogenerated/source-loop-values"
var libraries = "$prefix/idris2-0.8.0/base-0.8.0:$prefix/idris2-0.8.0/prelude-0.8.0:$prefix/idris2-0.8.0/network-0.8.0:$prefix/idris2-0.8.0/linear-0.8.0"
mkdir -p "$output"
for module in LoopValueChecks StringEncodingChecks {
  var target = "$output/$module"
  mkdir -p "$target"
  env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$modules:$core/_/build/ttc:$libraries" CHEZ="$scheme" \
    "$compiler" --cg chez --source-dir "$source" --build-dir "$target/build" --output-dir "$target" \
    "$source/$module.idric" -o checks > "$target/compile.txt" 2>&1
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$target/compile.txt" }
  if (_error.code !== 1) { echo 'FAIL host compiler diagnostics' >&2; exit 1 }
  test -x "$target/checks"
  cp "$core/_/build/exec/idris2_app/libidris2_support.so" "$target/checks_app/"
  env CHEZ="$scheme" "$target/checks" > "$target/execution.txt" 2>&1
  cat "$target/execution.txt"
}
rg -q -x -F 'PASS source loop-value semantics' "$output/LoopValueChecks/execution.txt"
rg -q -x -F 'PASS DEX string data and ordering' "$output/StringEncodingChecks/execution.txt"
echo 'PASS actual source and encoding host controls; ART NOT_RUN'
