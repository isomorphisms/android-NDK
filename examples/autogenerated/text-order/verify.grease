#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) { echo 'requires BACKEND FRONTEND BAKSMALI NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var baksmali = ARGV[2]
var evidence = ARGV[3]
for path in "$repository" "$frontend" "$baksmali" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused Text ordering evidence' >&2; exit 1 }
mkdir -p "$evidence/mutant-source"
var source = "$repository/examples/autogenerated/text-order"
var driver = "$repository/dex/idric/build/exec/idric-dex"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$repository/dex/idric/build/ttc"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.LD_LIBRARY_PATH = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
proc compile(lane, directory, file, mode) {
  mkdir -p "$evidence/$lane"
  var options = []
  if (mode === 'managed') { setvar options = ['--directive', 'managed-exports'] }
  "$driver" --cg dex @options --source-dir "$directory" --build-dir "$evidence/$lane/build" \
    --output-dir "$evidence/$lane" "$directory/$file" -o candidate > "$evidence/$lane/compiler.txt" 2>&1
  if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/$lane/compiler.txt" { exit 1 }
  test -s "$evidence/$lane/candidate.dex"
  java -jar "$baksmali" disassemble "$evidence/$lane/candidate.dex" -o "$evidence/$lane/decoded"
}
compile managed "$source" TextOrder.idric managed
compile repeat "$source" TextOrder.idric managed
cmp "$evidence/managed/candidate.dex" "$evidence/repeat/candidate.dex"
compile pure "$source" PureTextOrder.idric pure
compile command "$source" CommandTextOrder.idric command
cp "$source/TextOrder.idric" "$evidence/mutant-source/TextOrder.idric"
cp "$source/mutants/TextOrderCore.idric" "$evidence/mutant-source/TextOrderCore.idric"
if cmp -s "$source/TextOrderCore.idric" "$evidence/mutant-source/TextOrderCore.idric" { exit 1 }
compile mutant "$evidence/mutant-source" TextOrder.idric managed
if cmp -s "$evidence/managed/candidate.dex" "$evidence/mutant/candidate.dex" { exit 1 }
mkdir -p "$evidence/refused"
try {
  "$driver" --cg dex --source-dir "$source/initial" --build-dir "$evidence/refused/build" \
    --output-dir "$evidence/refused" "$source/initial/PureTextOrder.idric" -o candidate > "$evidence/refused/compiler.txt" 2>&1
}
if (_error.code !== 1) { echo 'FAIL pure Text foreign escape was not refused' >&2; exit 1 }
test ! -e "$evidence/refused/candidate.dex"
rg -F 'Managed DEX unsupported checked foreign declaration' "$evidence/refused/compiler.txt"
git -C "$repository" rev-parse HEAD > "$evidence/backend-commit.txt"
git -C "$frontend" rev-parse HEAD > "$evidence/frontend-commit.txt"
sha256sum "$repository/dex/idric/src/Backend/DEX/Heap.idr" "$repository/dex/idric/src/Backend/DEX/Codegen.idr" \
  "$repository/dex/idric/src/Backend/DEX/Capabilities.idr" "$driver" "${driver}_app/idric-dex.so" \
  "$source/TextOrderCore.idric" "$evidence/managed/candidate.dex" "$evidence/pure/candidate.dex" \
  "$evidence/command/candidate.dex" "$evidence/mutant/candidate.dex" > "$evidence/sha256.txt"
printf 'source_checked\tPASS\nindependent_decode\tPASS\ndeterminism\tPASS\ncommand_and_pure_contracts\tPASS\nART\tNOT_RUN\nphysical_TAB_P10\tNOT_RUN\n' > "$evidence/receipt.tsv"
