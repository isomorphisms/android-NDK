#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) { echo 'usage: grease verify.grease BACKEND FRONTEND BAKSMALI NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var baksmali = ARGV[2]
var evidence = ARGV[3]
for path in "$repository" "$frontend" "$baksmali" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused field evidence' >&2; exit 2 }
test -x "$repository/dex/idric/build/exec/idric-dex"
mkdir -p "$evidence"
var prefix = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PREFIX = prefix
setglobal ENV.IDRIS2_PACKAGE_PATH = "$prefix/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$repository/dex/idric/build/ttc"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
var source = "$repository/examples/autogenerated/native-reference-fields"
"$frontend/_/build/exec/idris2" -p idris2 --source-dir "$source" \
  --build-dir "$evidence/build" --output-dir "$evidence" \
  "$source/NativeReferenceFields.idric" -o field-generator > "$evidence/compiler.txt" 2>&1
cat "$evidence/compiler.txt"
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/compiler.txt" {
  echo 'FAIL invalid field generator source' >&2; exit 1
}
setglobal ENV.LD_LIBRARY_PATH = "$frontend/_/build/exec/idris2_app"
cd "$evidence"
"$evidence/field-generator" > "$evidence/positive.txt" 2>&1
cat "$evidence/positive.txt"
rg -x -F 'PASS native reference fields, isolated interface lists, deterministic ordering and five declaration/access refusals' "$evidence/positive.txt"
for lane in native-reference-fields native-reference-fields-static-mutant native-reference-fields-interface-mutant native-reference-fields-constructor-mutant {
  test -s "$evidence/$lane.dex"
  java -jar "$baksmali" disassemble "$evidence/$lane.dex" -o "$evidence/$lane.decoded"
}
rg -x -F '.field public binder:Landroid/os/IBinder;' "$evidence/native-reference-fields.decoded/qualification/ReferenceContainer.smali"
rg -x -F '.field private privateBinder:Landroid/os/IBinder;' "$evidence/native-reference-fields.decoded/qualification/ReferenceContainer.smali"
rg -x -F '.field public static shared:Ljava/lang/Object;' "$evidence/native-reference-fields.decoded/qualification/ReferenceContainer.smali"
rg -x -F '.field public static binder:Landroid/os/IBinder;' "$evidence/native-reference-fields-static-mutant.decoded/qualification/ReferenceContainer.smali"
rg -x -F '.implements Ljava/lang/Runnable;' "$evidence/native-reference-fields.decoded/qualification/Runner.smali"
if rg -q '^\.implements ' "$evidence/native-reference-fields.decoded/qualification/ZPlain.smali" {
  echo 'FAIL empty class inherited another class interface list' >&2; exit 1
}
rg -x -F '.implements Ljava/lang/Runnable;' "$evidence/native-reference-fields-interface-mutant.decoded/qualification/ZPlain.smali"
rg -x -F '.method public constructor <init>(Ljava/util/Collection;)V' "$evidence/native-reference-fields.decoded/qualification/CollectionBox.smali"
rg -x -F '.method public constructor <init>(J)V' "$evidence/native-reference-fields.decoded/qualification/WideDate.smali"
rg -x -F 'PASS reference and wide constructors and five malformed-constructor refusals' "$evidence/positive.txt"
if cmp -s "$evidence/native-reference-fields.dex" "$evidence/native-reference-fields-static-mutant.dex" {
  echo 'FAIL unchanged field-kind mutant' >&2; exit 1
}
if cmp -s "$evidence/native-reference-fields.dex" "$evidence/native-reference-fields-interface-mutant.dex" {
  echo 'FAIL unchanged interface-list mutant' >&2; exit 1
}
if cmp -s "$evidence/native-reference-fields.dex" "$evidence/native-reference-fields-constructor-mutant.dex" {
  echo 'FAIL unchanged constructor mutant' >&2; exit 1
}
git -C "$repository" rev-parse HEAD > "$evidence/backend-commit.txt"
git -C "$frontend" rev-parse HEAD > "$evidence/frontend-commit.txt"
sha256sum "$source/NativeReferenceFields.idric" "$repository/dex/idric/src/Backend/DEX/IR.idr" \
  "$repository/dex/idric/src/Backend/DEX/Encode.idr" "$repository/dex/idric/src/Backend/DEX/Smali.idr" \
  "$evidence/field-generator" "$evidence/field-generator_app/field-generator.so" \
  "$evidence/native-reference-fields.dex" "$evidence/native-reference-fields-static-mutant.dex" \
  "$evidence/native-reference-fields-interface-mutant.dex" "$evidence/native-reference-fields-constructor-mutant.dex" > "$evidence/sha256.txt"
printf 'typed_field_plans\tPASS\nclass_interface_lists\tPASS\ndeclaration_order_determinism\tPASS\ninvalid_declarations_and_access\tREJECTED\nindependent_decode\tPASS\nART\tNOT_RUN\nShizuku\tNOT_RUN\nphysical_TAB_P10\tNOT_RUN\n' > "$evidence/receipt.tsv"
