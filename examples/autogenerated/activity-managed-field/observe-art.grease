#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 3) { echo 'usage: grease observe-art.grease ADB SERIAL EVIDENCE' >&2; exit 2 }
var adb = ARGV[0]
var serial = ARGV[1]
var evidence = ARGV[2]
if (adb[0] !== '/' or evidence[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
if test -e "$evidence/art" { echo 'FAIL refusing reused Activity state ART evidence' >&2; exit 1 }
mkdir -p "$evidence/art"
"$adb" -s "$serial" emu avd name > "$evidence/art/emulator.txt"
"$adb" -s "$serial" shell getprop ro.build.version.sdk > "$evidence/art/sdk.txt"
"$adb" -s "$serial" shell getprop ro.product.cpu.abi > "$evidence/art/abi.txt"
for candidate in positive click-mutant resume-mutant destroy-mutant history-mutant {
  var remote = "/data/local/tmp/idric-activity-state-$candidate"
  "$adb" -s "$serial" shell mkdir -p "$remote"
  "$adb" -s "$serial" push "$evidence/$candidate/candidate.dex" "$remote/candidate.dex"
  "$adb" -s "$serial" push "$evidence/runner.dex" "$remote/runner.dex"
  "$adb" -s "$serial" shell chmod 444 "$remote/candidate.dex" "$remote/runner.dex"
  "$adb" -s "$serial" pull "$remote/candidate.dex" "$evidence/art/$candidate-received.dex"
  "$adb" -s "$serial" pull "$remote/runner.dex" "$evidence/art/$candidate-runner-received.dex"
  cmp "$evidence/$candidate/candidate.dex" "$evidence/art/$candidate-received.dex"
  cmp "$evidence/runner.dex" "$evidence/art/$candidate-runner-received.dex"
  timeout 20 "$adb" -s "$serial" logcat -b all -d -v threadtime > "$evidence/art/$candidate-before.logcat.txt" 2>&1
  "$adb" -s "$serial" logcat -b all -c
  try {
    timeout 90 "$adb" -s "$serial" shell "CLASSPATH=$remote/candidate.dex:$remote/runner.dex app_process /system/bin ActivityFieldRunner" \
      > "$evidence/art/$candidate.stdout.txt" 2> "$evidence/art/$candidate.stderr.txt"
  }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/art/$candidate.exit"
  timeout 20 "$adb" -s "$serial" logcat -b all -d -v threadtime > "$evidence/art/$candidate-after.logcat.txt" 2>&1
  cat "$evidence/art/$candidate.stdout.txt" "$evidence/art/$candidate.stderr.txt"
  if (candidate === 'positive') {
    if (status !== 0) { echo 'FAIL Activity state ART process; inspect checkpoints Throwable and logcat' >&2; exit 1 }
    rg -x -F 'PASS private Activity IORef state and receiver isolation' "$evidence/art/$candidate.stdout.txt"
  } else {
    if (status !== 93) { echo 'FAIL missing designated Activity state source mutation rejection; inspect retained process evidence' >&2; exit 1 }
    rg -x -F 'FAIL private Activity IORef state and receiver isolation' "$evidence/art/$candidate.stderr.txt"
  }
}
printf 'private_Activity_IORef_ART\tPASS\nuninitialized_getter\tPASS\nactual_listener_dispatch\tPASS\nchecked_resume_destroy_source_exports\tPASS\nper_instance_receiver_isolation\tPASS\nwrong_runtime_receiver_rejected\tPASS\ncompiled_source_mutants_rejected\tPASS\nframework_lifecycle\tNOT_RUN\nAPK\tNOT_RUN\nphysical_device\tNOT_RUN\n' > "$evidence/art/result.tsv"
printf '\033[32mPASS\033[0m private Activity IORef source state and receiver isolation on ART\n'
