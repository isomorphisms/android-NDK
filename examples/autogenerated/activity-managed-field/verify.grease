#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 7) {
  echo 'usage: grease verify.grease REPOSITORY FRONTEND DRIVER_LAUNCHER BACKEND_TTC BAKSMALI SMALI FRESH_OUTPUT' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var driver_app = driver ++ '_app'
var modules = ARGV[3]
var baksmali = ARGV[4]
var smali = ARGV[5]
var output = ARGV[6]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused Activity-field evidence' >&2; exit 1 }
test $(git -C "$frontend" rev-parse HEAD) = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
var source = "$repository/examples/autogenerated/activity-managed-field"
var compiler = "$frontend/_/build/exec/idris2"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = modules
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
mkdir -p "$output"
printf 'backend\t%s\nfrontend\t%s\n' $(git -C "$repository" rev-parse HEAD) \
  $(git -C "$frontend" rev-parse HEAD) > "$output/inputs.tsv"
git -C "$repository" diff --binary HEAD > "$output/local.patch"
sha256sum "$repository/dex/idric/src/Backend/DEX/ManagedActivityField.idr" \
  "$repository/dex/idric/src/Backend/DEX/Codegen.idr" \
  "$source/ActivityFieldSource.idric" "$source/ActivityFieldPlanChecks.idric" \
  "$source/ActivityFieldRunner.smali" "$driver" "$driver_app/idric-dex.so" \
  "$driver_app/idric-dex.ss" > "$output/source-artifacts.sha256"

proc clean_log(log) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" }
  var status = _error.code
  if (status === 0) { echo 'FAIL Activity-field source diagnostic' >&2; exit 1 }
  if (status !== 1) { echo 'FAIL Activity-field diagnostic checker' >&2; exit 1 }
}
mkdir -p "$output/plans"
try {
  "$compiler" -p idris2 --source-dir "$source" --build-dir "$output/plans/build" \
    --output-dir "$output/plans" "$source/ActivityFieldPlanChecks.idric" -o plans \
    > "$output/plans/compiler.txt" 2>&1
}
var plan_status = _error.code
cat "$output/plans/compiler.txt"
test "$plan_status" = 0
clean_log "$output/plans/compiler.txt"
cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$output/plans/plans_app/"
"$output/plans/plans" > "$output/plans/result.txt" 2>&1
rg -x -F 'PASS checked Activity field plans and source-type refusals' "$output/plans/result.txt"

proc emit(directory, module, destination) {
  mkdir -p "$destination"
  try {
    "$driver" --cg dex --directive managed-exports --source-dir "$directory" \
      --build-dir "$destination/build" --output-dir "$destination" \
      "$directory/$module.idric" -o candidate > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$destination/compiler.exit"
  cat "$destination/compiler.txt"
  if (status !== 0) { return 1 }
  clean_log "$destination/compiler.txt"
  test -s "$destination/candidate.dex"
  java -jar "$baksmali" disassemble "$destination/candidate.dex" -o "$destination/decoded"
}
emit "$source" ActivityFieldSource "$output/positive"
emit "$source" ActivityFieldSource "$output/repeat"
cmp "$output/positive/candidate.dex" "$output/repeat/candidate.dex"
rg -x -F '.field private state:Ljava/util/ArrayList;' "$output/positive/decoded/Idric/Generated.smali"
rg -F 'iget-object' "$output/positive/decoded/Idric/Generated.smali" | rg -F 'LIdric/Generated;->state:Ljava/util/ArrayList;'
rg -F 'iput-object' "$output/positive/decoded/Idric/Generated.smali" | rg -F 'LIdric/Generated;->state:Ljava/util/ArrayList;'
rg -F 'is uninitialized' "$output/positive/decoded/Idric/Generated.smali"
rg -F 'cannot store null' "$output/positive/decoded/Idric/Generated.smali"
rg -F 'Ljava/util/Objects;->requireNonNull(Ljava/lang/Object;Ljava/lang/String;)Ljava/lang/Object;' "$output/positive/decoded/Idric/Generated.smali"
rg -F 'managed-activity-fields' "$output/positive/candidate.runtime.tsv"
rg -F 'ActivityFieldSource.AppState' "$output/positive/candidate.field-types.tsv"

for mutant in click-mutant resume-mutant destroy-mutant history-mutant {
  var directory = "$output/$mutant-source"
  mkdir -p "$directory"
  if (mutant === 'click-mutant') {
    sed 's/":click"/":wrong"/' "$source/ActivityFieldSource.idric" > "$directory/ActivityFieldSource.idric"
  } elif (mutant === 'resume-mutant') {
    sed 's/":resume"/":wrong"/' "$source/ActivityFieldSource.idric" > "$directory/ActivityFieldSource.idric"
  } elif (mutant === 'destroy-mutant') {
    sed 's/writeIORef cell Closed/writeIORef cell (Active "wrong" ["wrong"])/' "$source/ActivityFieldSource.idric" > "$directory/ActivityFieldSource.idric"
  } else {
    sed 's/(value :: history)/[]/' "$source/ActivityFieldSource.idric" > "$directory/ActivityFieldSource.idric"
  }
  if cmp -s "$source/ActivityFieldSource.idric" "$directory/ActivityFieldSource.idric" {
    echo 'FAIL unchanged Activity state source mutation' >&2; exit 1
  }
  emit "$directory" ActivityFieldSource "$output/$mutant"
  if cmp -s "$output/positive/candidate.dex" "$output/$mutant/candidate.dex" {
    echo 'FAIL unchanged Activity state source mutation bytes' >&2; exit 1
  }
}

for refusal in wrong-owner wrong-receiver ordinary-getter missing-setter duplicate-field {
  var directory = "$output/$refusal-source"
  mkdir -p "$directory"
  if (refusal === 'wrong-owner') {
    sed 's/managed-field LIdric\/Generated;/managed-field Landroid\/app\/Activity;/' "$source/ActivityFieldSource.idric" > "$directory/ActivityFieldSource.idric"
  } elif (refusal === 'wrong-receiver') {
    sed 's/Landroid\/app\/Activity;:getTaskId/Landroid\/view\/View;:getId/' "$source/ActivityFieldSource.idric" > "$directory/ActivityFieldSource.idric"
  } elif (refusal === 'ordinary-getter') {
    sed 's/state ActivityFieldSource.get_state ActivityFieldSource.set_state/state ActivityFieldSource.read_state ActivityFieldSource.set_state/' "$source/ActivityFieldSource.idric" > "$directory/ActivityFieldSource.idric"
  } elif (refusal === 'missing-setter') {
    sed 's/ActivityFieldSource.set_state$/ActivityFieldSource.missing_setter/' "$source/ActivityFieldSource.idric" > "$directory/ActivityFieldSource.idric"
  } else {
    cp "$source/ActivityFieldSource.idric" "$directory/ActivityFieldSource.idric"
    printf '\n%%cg dex managed-field LIdric/Generated; otherstate ActivityFieldSource.get_state ActivityFieldSource.set_state\n' >> "$directory/ActivityFieldSource.idric"
  }
  mkdir -p "$output/$refusal"
  cp "$output/positive/candidate.dex" "$output/$refusal/candidate.dex"
  cp "$output/positive/candidate.field-types.tsv" "$output/$refusal/candidate.field-types.tsv"
  try { emit "$directory" ActivityFieldSource "$output/$refusal" }
  var status = _error.code
  if (status === 0) { echo 'FAIL expected Activity field source refusal' >&2; exit 1 }
  test $(cat "$output/$refusal/compiler.exit") = 1
  test ! -e "$output/$refusal/candidate.dex"
  test ! -e "$output/$refusal/candidate.field-types.tsv"
  if (refusal === 'wrong-owner') {
    rg -F 'Managed Activity field requires Generated owner' "$output/$refusal/compiler.txt"
  } elif (refusal === 'wrong-receiver') {
    rg -F 'same validated Activity source receiver' "$output/$refusal/compiler.txt"
  } elif (refusal === 'duplicate-field') {
    rg -F 'field names and accessor endpoints must be unique' "$output/$refusal/compiler.txt"
  } else {
    rg -F 'endpoint must be a checked %extern' "$output/$refusal/compiler.txt"
  }
}
for module in DependentFieldRefusal MismatchedFieldRefusal ForeignFieldProbe {
  try { emit "$source" "$module" "$output/refusal-$module" }
  var status = _error.code
  if (status === 0) { echo 'FAIL expected managed field type refusal' >&2; exit 1 }
  test $(cat "$output/refusal-$module/compiler.exit") = 1
  test ! -e "$output/refusal-$module/candidate.dex"
  if (module === 'DependentFieldRefusal') {
    rg -F 'payload must be closed' "$output/refusal-$module/compiler.txt"
  } elif (module === 'MismatchedFieldRefusal') {
    rg -F 'payload source types differ' "$output/refusal-$module/compiler.txt"
  } else {
    rg -F 'dex foreign argument types do not match' "$output/refusal-$module/compiler.txt"
  }
}
try { emit "$repository/examples/autogenerated/managed-ioref" IORefPublicBoundary "$output/public-cell-refusal" }
var public_status = _error.code
if (public_status === 0) { echo 'FAIL public managed cell ABI was widened' >&2; exit 1 }
test $(cat "$output/public-cell-refusal/compiler.exit") = 1
test ! -e "$output/public-cell-refusal/candidate.dex"
rg -F 'unsupported applied or dependent source value type' "$output/public-cell-refusal/compiler.txt"

java -jar "$smali" assemble "$source/ActivityFieldRunner.smali" -o "$output/runner.dex"
sha256sum "$output/positive/candidate.dex" "$output/click-mutant/candidate.dex" \
  "$output/resume-mutant/candidate.dex" "$output/destroy-mutant/candidate.dex" \
  "$output/history-mutant/candidate.dex" "$output/runner.dex" > "$output/candidates.sha256"
printf 'checked_source\tPASS\nfull_source_type_validation\tPASS\nprivate_instance_field_emission\tPASS\nindependent_decode\tPASS\nsource_mutations\tBUILT\nsource_refusals\tPASS\nART\tPENDING\nframework_lifecycle\tPENDING\nAPK\tNOT_RUN\nphysical_device\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m checked Activity field source types, emission, decode, mutations and refusals; ART pending\n'
