module MismatchedFieldRefusal

import Data.IORef

data ActivityReference : Type where [external]
data ReadState = ReadPayload Text
data WriteState = WritePayload Text

%extern
get_state : ActivityReference → PrimIO (IORef ReadState)

%extern
set_state : ActivityReference → IORef WriteState → PrimIO ()

%foreign "dex:virtual:Landroid/app/Activity;:getTaskId:()I"
activity_identity : ActivityReference → PrimIO Int32

%cg dex extends Landroid/app/Activity;
%cg dex managed-field LIdric/Generated; state MismatchedFieldRefusal.get_state MismatchedFieldRefusal.set_state

%export "dex:initialize_mismatched"
initialize_mismatched : ActivityReference → IO ()
initialize_mismatched activity = do
  ignored ← primIO (activity_identity activity)
  cell ← newIORef (WritePayload "write")
  primIO (set_state activity cell)

%export "dex:read_mismatched"
read_mismatched : ActivityReference → IO Text
read_mismatched activity = do
  cell ← primIO (get_state activity)
  ReadPayload value ← readIORef cell
  pure value

main : IO ()
main = pure ()
