#!/usr/bin/env grease
if (len(ARGV) !== 4) { echo 'usage: grease prepare.grease REPOSITORY DRIVER BAKSMALI EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var driver = ARGV[1]
var baksmali = ARGV[2]
var evidence = ARGV[3]
var source = "$repository/examples/autogenerated/icu-runtime"
if test -e "$evidence" { echo 'FAIL evidence already exists' >&2; exit 1 }
mkdir -p "$evidence/repeated" "$evidence/mutant-source" "$evidence/mutant" "$evidence/unknown"
"$driver" --cg dex --source-dir "$source" --build-dir "$evidence/build" \
  --output-dir "$evidence" "$source/CheckedArguments.idric" -o arguments > "$evidence/compile.txt" 2>&1
test -s "$evidence/arguments.dex"
"$driver" --cg dex --source-dir "$source" --build-dir "$evidence/repeated-build" \
  --output-dir "$evidence/repeated" "$source/CheckedArguments.idric" -o arguments > "$evidence/repeated.txt" 2>&1
cmp "$evidence/arguments.dex" "$evidence/repeated/arguments.dex"
java -jar "$baksmali" disassemble "$evidence/arguments.dex" -o "$evidence/decoded"
rg -F '.method public static main([Ljava/lang/String;)V' "$evidence/decoded/Idric/Generated.smali"
rg -F '.method public static __idricArgCount()J' "$evidence/decoded/Idric/Generated.smali"
if rg -F '.method public static __idricIntExact(' "$evidence/decoded/Idric/Generated.smali" {
  echo 'FAIL argument-only candidate retained unused JNI int narrowing' >&2; exit 1
}
rg -F '.method public static __idricApply(Ljava/lang/Object;Ljava/lang/Object;)Ljava/lang/Object;' "$evidence/decoded/Idric/Generated.smali"
if rg 'Ljava/math/BigInteger;->(int|long)ValueExact' "$evidence/decoded/Idric/Generated.smali" {
  echo 'FAIL candidate requires API 31 narrowing on the API 29 lane' >&2; exit 1
}
rg -F 'throw ' "$evidence/decoded/Idric/Generated.smali"
sed 's/arg:/wrong:/' "$source/CheckedArguments.idric" > "$evidence/mutant-source/CheckedArguments.idric"
"$driver" --cg dex --source-dir "$evidence/mutant-source" --build-dir "$evidence/mutant-build" \
  --output-dir "$evidence/mutant" "$evidence/mutant-source/CheckedArguments.idric" -o arguments > "$evidence/mutant.txt" 2>&1
if cmp -s "$evidence/arguments.dex" "$evidence/mutant/arguments.dex" { echo 'FAIL ineffective checked-source mutation' >&2; exit 1 }
try {
  "$driver" --cg dex --source-dir "$source" --build-dir "$evidence/unknown-build" \
    --output-dir "$evidence/unknown" "$source/UnknownForeign.idric" -o unknown > "$evidence/unknown.txt" 2>&1
}
var rejected = _error.code
test "$rejected" -ne 0
rg -F 'unsupported checked foreign declaration' "$evidence/unknown.txt"
test ! -e "$evidence/unknown/unknown.dex"
sha256sum "$source/CheckedArguments.idric" "$source/UnknownForeign.idric" "$source/icu-jni.tsv" \
  "$evidence/arguments.dex" "$evidence/mutant/arguments.dex" > "$evidence/artifacts.sha256"
printf 'checked_argument_emission\tPASS\ndeterminism\tPASS\nindependent_decode\tPASS\nunknown_foreign\tREJECTED\nART\tNOT_RUN\nICU_HTTPS\tNOT_RUN\nphysical_A1\tNOT_RUN\nphysical_C67\tNOT_RUN\n' > "$evidence/host-receipt.tsv"
"$driver" --cg dex --source-dir "$source" --build-dir "$evidence/characters-build" \
  --output-dir "$evidence" "$source/CharacterCasts.idric" -o characters > "$evidence/characters.txt" 2>&1
test -s "$evidence/characters.dex"
printf '\033[32mPASS\033[0m checked argument source, deterministic DEX, independent decode and unsupported-foreign refusal\n'
