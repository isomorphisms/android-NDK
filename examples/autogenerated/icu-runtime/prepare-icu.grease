#!/usr/bin/env grease
if (len(ARGV) !== 10) { echo 'usage: grease prepare-icu.grease REPOSITORY FRONTEND ICU NET OPENSSL SDK ICK OBSERVER BAKSMALI EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var icu = ARGV[2]
var net = ARGV[3]
var openssl = ARGV[4]
var sdk = ARGV[5]
var ick = ARGV[6]
var observer = ARGV[7]
var baksmali = ARGV[8]
var evidence = ARGV[9]
test "$(git -C "$frontend" rev-parse HEAD)" = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
test "$(git -C "$icu" rev-parse HEAD)" = b1c19dc281e5e7d3d326c9275093fb379bafd4bd
test "$(git -C "$net" rev-parse HEAD)" = b21801b72acb8ab835c297bbe298af8599550134
test "$(git -C "$observer" rev-parse HEAD)" = bd834cd7ac965f050493c072f83f221c4b400dd3
var compiler = "$frontend/_/build/exec/idris2"
var driver = "$repository/dex/idric/build/exec/idric-dex"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
if test -e "$evidence" { echo 'FAIL refusing reused ICU evidence' >&2; exit 1 }
mkdir -p "$evidence"
cd "$net"
"$compiler" --install idric-net.ipkg > "$evidence/net-build.txt" 2>&1
cd "$icu"
"$driver" --cg dex -p idric_net --directive "jni-map=$repository/examples/autogenerated/icu-runtime/icu-jni.tsv" \
  --source-dir "$icu/src" --build-dir "$evidence/build" --output-dir "$evidence" \
  --dumpanf "$evidence/icu.anf" "$icu/src/Main.idric" -o icu > "$evidence/compile.txt" 2>&1
test -s "$evidence/icu.dex"
java -jar "$baksmali" disassemble "$evidence/icu.dex" -o "$evidence/decoded"
rg -F '.method public static native icuSendHttp(Ljava/lang/String;ILjava/lang/String;Ljava/lang/String;I)I' "$evidence/decoded/Idric/Generated.smali"
rg -F '.method public static native icuSendHttps(Ljava/lang/String;ILjava/lang/String;Ljava/lang/String;I)I' "$evidence/decoded/Idric/Generated.smali"
rg -F '.method static constructor <clinit>()V' "$evidence/decoded/Idric/Generated.smali"
sed 's/(Ljava\/lang\/String;I/(II/' "$repository/examples/autogenerated/icu-runtime/icu-jni.tsv" > "$evidence/wrong-jni.tsv"
try {
  "$driver" --cg dex -p idric_net --directive "jni-map=$evidence/wrong-jni.tsv" \
    --source-dir "$icu/src" --build-dir "$evidence/wrong-build" --output-dir "$evidence/wrong" \
    "$icu/src/Main.idric" -o icu > "$evidence/wrong-jni.txt" 2>&1
}
test "$[_error.code]" -ne 0
rg -F 'Managed JNI argument cannot cross' "$evidence/wrong-jni.txt"
test ! -e "$evidence/wrong/icu.dex"
make -f "$icu/android/Makefile" all tests ANDROID_ABI=x86_64 \
  "ANDROID_NDK_HOME=$sdk/ndk/27.2.12479018" "OPENSSL_SOURCE=$openssl" \
  > "$evidence/native-build.txt" 2>&1
cp "$icu/build/android/x86_64/libicu_transport.so" "$icu/build/android/x86_64/jni-tests" \
  "$icu/build/android/x86_64/framing-tests" "$evidence/"
cp "$icu/build/android/x86_64/native-receipt.tsv" "$icu/build/android/x86_64/elf-header.txt" \
  "$icu/build/android/x86_64/dynamic.txt" "$evidence/"
"$ick" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Werror \
  "$observer/icu/fixture.c" -lssl -lcrypto -o "$evidence/fixture" > "$evidence/fixture-build.txt" 2>&1
git -C "$icu" diff --exit-code -- src/Main.idric src/Transport.idric android/jni_transport.c native/transport.c
sha256sum "$icu/src/Main.idric" "$icu/src/Transport.idric" "$icu/android/jni_transport.c" \
  "$icu/native/transport.c" "$observer/icu/fixture.c" "$repository/examples/autogenerated/icu-runtime/icu-jni.tsv" \
  "$evidence/icu.dex" "$evidence/libicu_transport.so" "$evidence/fixture" > "$evidence/artifacts.sha256"
printf 'frontend\t740bbf2b1d9e811fd00c719c3473eede17ceea3b\nicu\tb1c19dc281e5e7d3d326c9275093fb379bafd4bd\nnetwork\tb21801b72acb8ab835c297bbe298af8599550134\nobserver\tbd834cd7ac965f050493c072f83f221c4b400dd3\nICU_Main_unchanged\tPASS\nchecked_DEX_emission\tPASS\nindependent_decode\tPASS\nwrong_JNI_signature\tREJECTED\nART\tNOT_RUN\nphysical_A1\tNOT_RUN\nphysical_C67\tNOT_RUN\n' > "$evidence/producer-receipt.tsv"
printf '\033[32mPASS\033[0m unchanged checked ICU emitted and decoded; native JNI transport built separately\n'
