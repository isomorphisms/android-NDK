#!/usr/bin/env grease
# Black-box observation against the separately pinned AICI HTTP/TLS server.
if (len(ARGV) !== 4) { echo 'usage: grease observe-icu.grease ADB SERIAL INPUT EVIDENCE' >&2; exit 2 }
var adb = ARGV[0]
var serial = ARGV[1]
var input = ARGV[2]
var evidence = ARGV[3]
if test -e "$evidence" { echo 'FAIL refusing reused ART evidence' >&2; exit 1 }
mkdir -p "$evidence"
var pids = []
proc cleanup {
  for pid in (pids) { try { kill "$pid" }; try { wait "$pid" } }
}
trap --add EXIT { cleanup }
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
"$adb" -s "$serial" shell getprop > "$evidence/device-properties.txt"
"$adb" -s "$serial" shell id > "$evidence/native-identity.txt"
"$adb" -s "$serial" shell ls -ld / /data /data/local /data/local/tmp > "$evidence/native-directories.txt"
openssl req -x509 -newkey rsa:2048 -nodes -keyout "$evidence/key.pem" -out "$evidence/cert.pem" \
  -days 1 -subj /CN=localhost -addext subjectAltName=DNS:localhost > "$evidence/certificate.stdout" 2> "$evidence/certificate.stderr"
fork { "$input/fixture" http 28080 "$evidence/http.ready" > "$evidence/http.stdout" 2> "$evidence/http.stderr" }
setvar pids = pids ++ ["$!"]
fork { "$input/fixture" tls 28443 "$evidence/tls.ready" "$evidence/cert.pem" "$evidence/key.pem" > "$evidence/tls.stdout" 2> "$evidence/tls.stderr" }
setvar pids = pids ++ ["$!"]
var attempt = 0
while (attempt < 100) {
  if test -s "$evidence/http.ready" { if test -s "$evidence/tls.ready" { break } }
  sleep 0.1
  setvar attempt += 1
}
test -s "$evidence/http.ready"
test -s "$evidence/tls.ready"
"$adb" -s "$serial" reverse tcp:28080 tcp:28080
"$adb" -s "$serial" reverse tcp:28443 tcp:28443
"$adb" -s "$serial" shell mkdir -p /data/local/tmp/idric-icu-runtime
"$adb" -s "$serial" push "$input/icu.dex" /data/local/tmp/idric-icu-runtime/icu.dex
"$adb" -s "$serial" push "$input/libicu_transport.so" /data/local/tmp/idric-icu-runtime/libicu_transport.so
"$adb" -s "$serial" push "$input/libicu_transport-original.so" /data/local/tmp/idric-icu-runtime/libicu_transport-original.so
"$adb" -s "$serial" push "$evidence/cert.pem" /data/local/tmp/idric-icu-runtime/cert.pem
"$adb" -s "$serial" push "$input/jni-tests" /data/local/tmp/idric-icu-runtime/jni-tests
"$adb" -s "$serial" push "$input/framing-tests" /data/local/tmp/idric-icu-runtime/framing-tests
for name in framing-tests-original capture-path-original capture-path-repaired {
  "$adb" -s "$serial" push "$input/$name" "/data/local/tmp/idric-icu-runtime/$name"
}
proc native_test(name, expected_status) {
  "$adb" -s "$serial" shell chmod 755 "/data/local/tmp/idric-icu-runtime/$name"
  try {
    timeout 60 "$adb" -s "$serial" shell -T "/data/local/tmp/idric-icu-runtime/$name" > "$evidence/$name.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/$name.status"
  cat "$evidence/$name.txt"
  if (status !== int(expected_status)) { echo "FAIL native $name status $status (expected $expected_status)" >&2; exit 1 }
}
native_test capture-path-original 0
rg -x 'capture_paths_valid\t0' "$evidence/capture-path-original.txt"
native_test framing-tests-original 1
rg -x -F 'FAIL line 96' "$evidence/framing-tests-original.txt"
native_test capture-path-repaired 0
rg -x 'capture_paths_valid\t1' "$evidence/capture-path-repaired.txt"
native_test jni-tests 0
native_test framing-tests 0
proc run_with_library (label, command, expected_status, library) {
  try {
    timeout 60 "$adb" -s "$serial" shell -T "SSL_CERT_FILE=/data/local/tmp/idric-icu-runtime/cert.pem CLASSPATH=/data/local/tmp/idric-icu-runtime/icu.dex app_process -Dicu.library=/data/local/tmp/idric-icu-runtime/$library /system/bin Idric.Generated $command" > "$evidence/$label.stdout" 2> "$evidence/$label.stderr"
  }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/$label.status"
  if (status !== int(expected_status)) { echo "FAIL $label status $status (expected $expected_status)" >&2; cat "$evidence/$label.stdout" "$evidence/$label.stderr" >&2; exit 1 }
}
proc run (label, command, expected_status) {
  run_with_library "$label" "$command" "$expected_status" libicu_transport.so
}
# Same checked DEX and independent server; only the native candidate changes.
# Preserve the original wrong outcomes as evidence, never as repaired behavior.
run_with_library original-http-error 'get http://127.0.0.1:28080/status/500' 0 libicu_transport-original.so
run_with_library original-malformed 'get http://127.0.0.1:28080/malformed' 7 libicu_transport-original.so
printf '%s' hello > "$evidence/hello.expected"
cmp "$evidence/hello.expected" "$evidence/original-http-error.stdout"
run usage '' 1
rg -x 'usage:' "$evidence/usage.stdout"
run invalid-url 'get ftp://localhost/plain' 1
rg -F 'URL must begin with http:// or https://' "$evidence/invalid-url.stdout"
run get 'get http://127.0.0.1:28080/plain' 0
cmp "$evidence/hello.expected" "$evidence/get.stdout"
run post 'post http://127.0.0.1:28080/post café' 0
printf '%s' posted > "$evidence/posted.expected"
cmp "$evidence/posted.expected" "$evidence/post.stdout"
run tls-get 'get https://localhost:28443/plain' 0
cmp "$evidence/hello.expected" "$evidence/tls-get.stdout"
run tls-post 'post https://localhost:28443/post café' 0
cmp "$evidence/posted.expected" "$evidence/tls-post.stdout"
run wrong-identity 'get https://127.0.0.1:28443/plain' 5
test ! -s "$evidence/wrong-identity.stdout"
run redirect '--http1.1 get http://127.0.0.1:28080/version-redirect' 0
printf '%s' HTTP/1.1 > "$evidence/version.expected"
cmp "$evidence/version.expected" "$evidence/redirect.stdout"
run http-error 'get http://127.0.0.1:28080/status/500' 10
cmp "$evidence/hello.expected" "$evidence/http-error.stdout"
run malformed 'get http://127.0.0.1:28080/malformed' 13
run duplicate-length 'get http://127.0.0.1:28080/duplicate-length' 13
run truncated 'get http://127.0.0.1:28080/truncated' 9
run length-extra 'get http://127.0.0.1:28080/length-extra' 9
run bad-length 'get http://127.0.0.1:28080/bad-length' 13
run bad-nul 'get http://127.0.0.1:28080/bad-nul' 13
run status-digits 'get http://127.0.0.1:28080/status-digits' 13
run bad-redirect-frame 'get http://127.0.0.1:28080/bad-redirect-frame' 13
run binary 'get http://127.0.0.1:28080/binary' 0
printf '\000\001\002\377\012\015\000\200' > "$evidence/binary.expected"
cmp "$evidence/binary.expected" "$evidence/binary.stdout"
run chunked 'get http://127.0.0.1:28080/chunk-valid' 0
cmp "$evidence/hello.expected" "$evidence/chunked.stdout"
for name in chunk-truncated chunk-trailer chunk-extra chunk-extension chunk-duplicate chunk-conflict {
  run "$name" "get http://127.0.0.1:28080/$name" 13
}
run chunk-overflow 'get http://127.0.0.1:28080/chunk-overflow' 12
if cmp -s "$evidence/posted.expected" "$evidence/get.stdout" { echo 'FAIL observer accepted deliberately wrong expected bytes' >&2; exit 1 }
"$adb" -s "$serial" pull /data/local/tmp/idric-icu-runtime/icu.dex "$evidence/received.dex"
"$adb" -s "$serial" pull /data/local/tmp/idric-icu-runtime/libicu_transport.so "$evidence/received.so"
cmp "$input/icu.dex" "$evidence/received.dex"
cmp "$input/libicu_transport.so" "$evidence/received.so"
sha256sum "$input/icu.dex" "$input/libicu_transport.so" "$input/fixture" > "$evidence/artifacts.sha256"
printf 'checked_ICU_ART_JNI\tPASS\nhttp_get\tPASS\nhttp_post_utf8\tPASS\nhttps_get\tPASS\nhttps_post_utf8\tPASS\ninvalid_TLS_identity\tREJECTED\nredirect\tPASS\nhttp_failure_status\tPASS\nmalformed_framing\tREJECTED\ntruncated\tREJECTED\nbinary_stdout\tPASS\nchunked\tPASS\nwrong_expected_bytes\tREJECTED\nphysical_A1\tNOT_RUN\nphysical_C67\tNOT_RUN\n' > "$evidence/receipt.tsv"
printf 'original_private_path_failure\tREPRODUCED\nrepaired_native_framing_55\tPASS\nJNI_UTF8_checks_10\tPASS\noriginal_HTTP_status_loss\tREPRODUCED\noriginal_malformed_status_loss\tREPRODUCED\nHTTP_failure_exit_10\tPASS\nmalformed_exit_13\tPASS\nhostile_length_and_chunk_cases\tREJECTED\n' >> "$evidence/receipt.tsv"
printf '\033[32mPASS\033[0m unchanged checked ICU through DEX, ART and maintained JNI transport on x86_64 emulator\n'
