#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) { echo 'usage: grease observe.grease ADB SERIAL INPUT NEW_EVIDENCE' >&2; exit 2 }
var adb = ARGV[0]
var serial = ARGV[1]
var input = ARGV[2]
var evidence = ARGV[3]
if test -e "$evidence" { echo 'FAIL reused recursive ART evidence' >&2; exit 2 }
mkdir -p "$evidence"
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
var api = $("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')
if (api !== ENV.AICI_EXPECTED_ANDROID_API or (api !== '29' and api !== '34')) { exit 1 }
var remote = "/data/local/tmp/idric-recursive-$(sha256sum "$input/recursion/reader.dex" | cut -d ' ' -f 1)"
"$adb" -s "$serial" shell test ! -e "$remote"
"$adb" -s "$serial" shell mkdir "$remote"
printf '%s\n' depth=12007 list=72006000 siblings=6765 mutual=48018 > "$evidence/expected.txt"
for lane in recursion recursion-depth-mutant recursion-list-mutant recursion-siblings-mutant recursion-mutual-mutant {
  "$adb" -s "$serial" push "$input/$lane/reader.dex" "$remote/$lane.dex"
  "$adb" -s "$serial" shell chmod 444 "$remote/$lane.dex"
  "$adb" -s "$serial" pull "$remote/$lane.dex" "$evidence/$lane.received.dex"
  cmp "$input/$lane/reader.dex" "$evidence/$lane.received.dex"
  try { timeout 180 "$adb" -s "$serial" shell -T "dalvikvm -cp $remote/$lane.dex Idric.Generated" > "$evidence/$lane.actual" 2> "$evidence/$lane.stderr" }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/$lane.exit"
  cat "$evidence/$lane.actual"
  cat "$evidence/$lane.stderr"
  if (status !== 0) { echo 'FAIL recursive runtime exception is not a valid mutation rejection' >&2; exit 1 }
  if (lane === 'recursion') {
    cmp "$evidence/expected.txt" "$evidence/$lane.actual"
  } else {
    if cmp -s "$evidence/expected.txt" "$evidence/$lane.actual" { echo 'FAIL compiled recursive source mutant accepted' >&2; exit 1 }
    var wrong = 'depth=12009'
    if (lane === 'recursion-list-mutant') { setvar wrong = 'list=0' }
    if (lane === 'recursion-siblings-mutant') { setvar wrong = 'siblings=0' }
    if (lane === 'recursion-mutual-mutant') { setvar wrong = 'mutual=48020' }
    rg -x -F "$wrong" "$evidence/$lane.actual"
  }
}
printf 'schema\tidric-non-tail-recursion-v1\napi\t%s\nnon_tail_12000_depth\tPASS\n12000_constructor_results\tPASS\nsibling_call_live_values\tPASS\nmutual_varying_arity_12000_depth\tPASS\nfour_compiled_source_mutants\tREJECTED\nphysical_TAB_P10\tNOT_RUN\n' "$api" > "$evidence/receipt.tsv"
cat "$evidence/receipt.tsv"
