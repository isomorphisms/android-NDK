#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 5) { echo 'usage: grease prepare.grease NDK IB FRONTEND BAKSMALI NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var ib = ARGV[1]
var frontend = ARGV[2]
var baksmali = ARGV[3]
var evidence = ARGV[4]
for path in "$repository" "$ib" "$frontend" "$baksmali" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused recursive-consumer evidence' >&2; exit 2 }
mkdir -p "$evidence/source"
var observed_ib = $(git -C "$ib" rev-parse HEAD)
if (observed_ib !== 'a7349efc8041b4c41ff158afca7f13079c8df1c2') { echo 'FAIL changed maintained IB source input' >&2; exit 1 }
var prefix = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PREFIX = prefix
setglobal ENV.IDRIS2_PACKAGE_PATH = "$prefix/idris2-0.8.0"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/support/c"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
var driver = "$repository/dex/idric/build/exec/idric-dex"
cp -R "$ib/src/IB" "$evidence/source/IB"
cp "$ib/examples/autogenerated/tabp10-reader/ReaderProjection.idric" "$evidence/source/"
proc emit(directory, module, lane, managed) {
  var output = "$evidence/$lane"
  mkdir -p "$output"
  var directives = []
  if (managed) { setvar directives = ['--directive', 'managed-exports'] }
  try {
    "$driver" --cg dex @directives --source-dir "$directory" \
      --build-dir "$output/build" --output-dir "$output" \
      "$directory/$module.idric" -o reader > "$output/compiler.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$output/compiler.exit"
  cat "$output/compiler.txt"
  if (status !== 0) {
    test ! -e "$output/reader.dex"
    echo "FAIL checked recursive consumer: $lane" >&2
    exit 1
  }
  if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$output/compiler.txt" { exit 1 }
  java -jar "$baksmali" disassemble "$output/reader.dex" -o "$output/decoded"
  sha256sum "$output/reader.dex" > "$output/output.sha256"
}
emit "$evidence/source" ReaderProjection prepaint true
emit "$evidence/source" ReaderProjection prepaint-repeat true
cmp "$evidence/prepaint/reader.dex" "$evidence/prepaint-repeat/reader.dex"
cp -R "$evidence/source" "$evidence/mutant-source"
sed 's/case source_identity_reason admission of/case the (Maybe String) Nothing of/' \
  "$evidence/source/IB/HtmlPrepaint.idric" > "$evidence/mutant-source/IB/HtmlPrepaint.idric"
if cmp -s "$evidence/source/IB/HtmlPrepaint.idric" "$evidence/mutant-source/IB/HtmlPrepaint.idric" { exit 1 }
emit "$evidence/mutant-source" ReaderProjection prepaint-decoding-gate-mutant true
if cmp -s "$evidence/prepaint/reader.dex" "$evidence/prepaint-decoding-gate-mutant/reader.dex" { exit 1 }
var recursive_source = "$repository/examples/autogenerated/runtime-recursion"
emit "$recursive_source" NonTailRecursion recursion false
emit "$recursive_source" NonTailRecursion recursion-repeat false
cmp "$evidence/recursion/reader.dex" "$evidence/recursion-repeat/reader.dex"
rg -F '__idricRecursiveGroup_' "$evidence/recursion/decoded/Idric/Generated.smali" > "$evidence/recursive-group-methods.txt"
for mutation in depth list siblings mutual {
  var changed = "$evidence/recursion-$mutation-source"
  mkdir -p "$changed"
  var original = "$recursive_source/NonTailRecursion.idric"
  var destination = "$changed/NonTailRecursion.idric"
  if (mutation === 'depth') {
    sed 's/if remaining == 0 then 7/if remaining == 0 then 9/' "$original" > "$destination"
  } elif (mutation === 'list') {
    sed 's/else remaining :: make_list/else 0 :: make_list/' "$original" > "$destination"
  } elif (mutation === 'siblings') {
    sed 's/if remaining <= 1 then remaining/if remaining <= 1 then 0/' "$original" > "$destination"
  } else {
    sed 's/then first + second$/then first + second + 2/' "$original" > "$destination"
  }
  if cmp -s "$original" "$destination" { echo 'FAIL unchanged recursive source mutation' >&2; exit 1 }
  emit "$changed" NonTailRecursion "recursion-$mutation-mutant" false
  if cmp -s "$evidence/recursion/reader.dex" "$evidence/recursion-$mutation-mutant/reader.dex" { exit 1 }
}
git -C "$repository" rev-parse HEAD > "$evidence/compiler-source.txt"
git -C "$ib" rev-parse HEAD > "$evidence/IB-source.txt"
sha256sum "$evidence/source/ReaderProjection.idric" "$recursive_source/NonTailRecursion.idric" \
  "$evidence/source/IB/Reader/Document.idric" "$evidence/source/IB/SourceDecoding.idric" \
  "$evidence/source/IB/HtmlPrepaint.idric" "$driver" > "$evidence/inputs.sha256"
printf 'checked_source_compilation\tPASS\nindependent_decode\tPASS\ndeterminism\tPASS\nART_recursive_semantics\tNOT_RUN\nactual_IB_84007_byte_projection\tNOT_RUN\nphysical_TAB_P10\tNOT_RUN\n' > "$evidence/receipt.tsv"
