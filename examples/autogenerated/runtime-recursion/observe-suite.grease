#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 7) { echo 'usage: grease observe-suite.grease NDK ADB SERIAL INPUT SMALI AICI NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var adb = ARGV[1]
var serial = ARGV[2]
var input = ARGV[3]
var smali = ARGV[4]
var aici = ARGV[5]
var evidence = ARGV[6]
if test -e "$evidence" { echo 'FAIL reused consumer suite evidence' >&2; exit 2 }
mkdir -p "$evidence"
try {
  grease "$repository/examples/autogenerated/runtime-recursion/observe.grease" \
    "$adb" "$serial" "$input" "$evidence/recursive"
}
var recursive_status = _error.code
try {
  grease "$aici/ib-source/reader/observe-large-source.grease" \
    "$aici" "$input" "$smali" "$adb" "$serial" "$evidence/large"
}
var large_status = _error.code
printf 'recursive_exit\t%s\nlarge_consumer_exit\t%s\n' "$recursive_status" "$large_status" > "$evidence/required.tsv"
cat "$evidence/required.tsv"
if (recursive_status !== 0 or large_status !== 0) { exit 1 }
