module NonTailRecursion

import Data.List
import System

%default covering

%noinline
depth : Integer → Integer
depth remaining =
  if remaining == 0 then 7 else 1 + depth (remaining - 1)

%noinline
make_list : Integer → List Integer
make_list remaining =
  if remaining == 0 then [] else remaining :: make_list (remaining - 1)

sum_list : List Integer → Integer → Integer
sum_list [] total = total
sum_list (first :: rest) total = sum_list rest (total + first)

%noinline
fibonacci : Integer → Integer
fibonacci remaining =
  if remaining <= 1 then remaining
    else fibonacci (remaining - 1) + fibonacci (remaining - 2)

mutual
  %noinline
  descend : Integer → Integer → Integer → Integer
  descend remaining first second =
    if remaining == 0 then first + second
      else first + ascend (remaining - 1) second

  %noinline
  ascend : Integer → Integer → Integer
  ascend remaining seed =
    if remaining == 0 then seed
      else 3 + descend (remaining - 1) seed 5

%export "dex:non_tail_cases"
main : IO ()
main = do
  putStrLn ("depth=" ++ cast (depth 12000))
  putStrLn ("list=" ++ cast (sum_list (make_list 12000) 0))
  putStrLn ("siblings=" ++ cast (fibonacci 20))
  putStrLn ("mutual=" ++ cast (descend 12000 7 11))
