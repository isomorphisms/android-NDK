#!/usr/bin/env grease
if (len(ARGV) !== 6) { echo 'usage: verify.grease REPOSITORY CORE BACKEND_TTC DEXDUMP BAKSMALI NEW_OUTPUT'; exit 2 }
var repository = ARGV[0]
var core = ARGV[1]
var modules = ARGV[2]
var dexdump = ARGV[3]
var baksmali = ARGV[4]
var output = ARGV[5]
for path in "$repository" "$core" "$modules" "$dexdump" "$baksmali" "$output" {
  if (len(path) === 0 or path[0] !== '/') { echo 'absolute path required'; exit 2 }
}
if test -e "$output" { echo 'refusing reused callback evidence'; exit 1 }
mkdir -p "$output"
var compiler = "$core/_/build/exec/idris2"
var prefix = "$core/_/bootstrap-build"
var source = "$repository/examples/autogenerated/native-view-callback"
var libraries = "$prefix/idris2-0.8.0/base-0.8.0:$prefix/idris2-0.8.0/prelude-0.8.0"
env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$modules:$core/_/build/ttc:$libraries" \
  CHEZ="$core/_/.tools/bin/scheme" "$compiler" --cg chez --source-dir "$source" \
  --build-dir "$output/build" --output-dir "$output" "$source/ClickListener.idric" \
  -o native-callback > "$output/compile.txt" 2>&1
try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$output/compile.txt" }
if (_error.code !== 1) { cat "$output/compile.txt"; exit 1 }
test -x "$output/native-callback"
cp "$core/_/build/exec/idris2_app/libidris2_support.so" "$output/native-callback_app/"
env CHEZ="$core/_/.tools/bin/scheme" "$output/native-callback" "$output/classes.dex" > "$output/run.txt"
env CHEZ="$core/_/.tools/bin/scheme" "$output/native-callback" "$output/repeat.dex" > "$output/repeat.txt"
cmp "$output/classes.dex" "$output/repeat.dex"
"$dexdump" -c "$output/classes.dex" > "$output/checksum.txt"
"$dexdump" -d "$output/classes.dex" > "$output/disassembly.txt"
java -jar "$baksmali" disassemble "$output/classes.dex" -o "$output/smali"
rg -q -x -F '.implements Landroid/view/View$OnClickListener;' "$output/smali/org/isomorphisms/NativeClickListener.smali"
rg -q -x -F '.method public native onClick(Landroid/view/View;)V' "$output/smali/org/isomorphisms/NativeClickListener.smali"
rg -q -x -F '.super Landroid/app/NativeActivity;' "$output/smali/org/isomorphisms/NativeViewActivity.smali"
rg -q -x -F '.method public native onNewIntent(Landroid/content/Intent;)V' "$output/smali/org/isomorphisms/NativeViewActivity.smali"
rg -q -x -F '.method public native onActivityResult(IILandroid/content/Intent;)V' "$output/smali/org/isomorphisms/NativeViewActivity.smali"
cp "$baksmali" "$output/baksmali.jar"
sha256sum "$output/classes.dex" "$output/baksmali.jar" > "$output/sha256.txt"
git -C "$repository" rev-parse HEAD > "$output/backend-revision.txt"
git -C "$core" rev-parse HEAD > "$output/compiler-revision.txt"
echo 'PASS pinned native callback compilation, refusal controls, deterministic DEX and independent decoding' > "$output/result.txt"
echo 'NOT_RUN fresh ART/JNI callback execution; packaging is a separate job' >> "$output/result.txt"
cat "$output/result.txt"
