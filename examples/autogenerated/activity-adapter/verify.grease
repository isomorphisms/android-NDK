#!/usr/bin/env grease

if (len(ARGV) !== 4) {
  echo 'usage: grease verify.grease ANDROID_NDK CORE SCHEME NEW_EVIDENCE' >&2
  exit 2
}
var repository = ARGV[0]
var core = ARGV[1]
var scheme = ARGV[2]
var evidence = ARGV[3]
for path in "$repository" "$core" "$scheme" "$evidence" {
  if (path[0] !== '/') { echo 'absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'refusing reused evidence' >&2; exit 1 }
var compiler = "$core/_/build/exec/idris2"
var prefix = "$core/_/bootstrap-build"
var api = "$core/_/build/ttc"
var libraries = "$prefix/idris2-0.8.0/base-0.8.0:$prefix/idris2-0.8.0/prelude-0.8.0:$prefix/idris2-0.8.0/network-0.8.0:$prefix/idris2-0.8.0/linear-0.8.0"
var source = "$repository/examples/autogenerated/activity-adapter"
var backend = "$repository/dex/idric/src"
test -x "$compiler"
test -x "$scheme"
mkdir -p "$evidence/backend/exec" "$evidence/host" "$evidence/candidate"
git -C "$repository" rev-parse HEAD > "$evidence/backend-revision.txt"
git -C "$repository" diff --binary HEAD > "$evidence/backend.patch"
git -C "$core" rev-parse HEAD > "$evidence/core-revision.txt"
sha256sum "$compiler" "$core/_/build/exec/idris2_app/idris2.so" > "$evidence/compiler-inputs.txt"
echo 'UNQUALIFIED inherited Chez compiler bootstrap; this is source/backend evidence, not ICK/NDK producer acceptance' > "$evidence/build-policy.txt"

proc clean_log(path) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$path" }
  if (_error.code !== 1) { echo 'FAIL compiler diagnostics' >&2; return 1 }
}

env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$api:$libraries" CHEZ="$scheme" \
  "$compiler" --cg chez --source-dir "$backend" \
  --build-dir "$evidence/backend/build" --output-dir "$evidence/backend/exec" \
  "$backend/Backend/DEX/Main.idr" -o idric-dex > "$evidence/backend/compile.txt" 2>&1
clean_log "$evidence/backend/compile.txt"
var modules = "$evidence/backend/build/ttc"
var driver = "$evidence/backend/exec/idric-dex"
test -x "$driver"
cp "$core/_/build/exec/idris2_app/libidris2_support.so" "$evidence/backend/exec/idric-dex_app/"

env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$modules:$api:$libraries" CHEZ="$scheme" \
  "$compiler" --cg chez --source-dir "$source" --build-dir "$evidence/host/build" \
  --output-dir "$evidence/host" "$source/ActivityPlanChecks.idric" -o activity-plans \
  > "$evidence/host/compile.txt" 2>&1
clean_log "$evidence/host/compile.txt"
test -x "$evidence/host/activity-plans"
cp "$core/_/build/exec/idris2_app/libidris2_support.so" "$evidence/host/activity-plans_app/"
env CHEZ="$scheme" "$evidence/host/activity-plans" > "$evidence/host/run.txt" 2>&1
rg -q -x -F 'PASS Activity typed-plan controls' "$evidence/host/run.txt"

env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$modules:$libraries" CHEZ="$scheme" \
  "$driver" --cg dex --source-dir "$source" --build-dir "$evidence/candidate/build" \
  --output-dir "$evidence/candidate" "$source/ActivitySource.idric" -o activity \
  > "$evidence/candidate/compile.txt" 2>&1
clean_log "$evidence/candidate/compile.txt"
for suffix in dex dex.plan checked.anf smali { test -s "$evidence/candidate/activity.$suffix" }
sha256sum "$evidence/candidate/activity.dex" > "$evidence/candidate/sha256.txt"
cat "$evidence/host/run.txt"
echo 'PASS checked Activity source emits direct DEX'
echo 'NOT_RUN independent parser, ART lifecycle, APK, physical C67'

# Preserve the existing interface-only receiver exclusion and foreign ABI.
for name in callback foreign {
  var check_source = "$repository/examples/autogenerated/interface-callback"
  var check_file = 'CallbackPlanChecks.idric'
  if (name === 'foreign') {
    setvar check_source = "$repository/dex/idric/tests/dex"
    setvar check_file = 'ForeignSpecTest.idr'
  }
  var check_output = "$evidence/$name"
  mkdir -p "$check_output"
  env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$modules:$api:$libraries" CHEZ="$scheme" \
    "$compiler" --cg chez --source-dir "$check_source" --build-dir "$check_output/build" \
    --output-dir "$check_output" "$check_source/$check_file" -o checks \
    > "$check_output/compile.txt" 2>&1
  clean_log "$check_output/compile.txt"
  test -x "$check_output/checks"
  cp "$core/_/build/exec/idris2_app/libidris2_support.so" "$check_output/checks_app/"
  env CHEZ="$scheme" "$check_output/checks" > "$check_output/run.txt" 2>&1
  cat "$check_output/run.txt"
}
