#!/usr/bin/env grease
if (len(ARGV) !== 6) {
  echo 'usage: grease verify.grease REPOSITORY FRONTEND IB BAKSMALI SMALI FRESH_EVIDENCE' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var ib = ARGV[2]
var baksmali = ARGV[3]
var smali = ARGV[4]
var evidence = ARGV[5]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL refusing reused evidence' >&2; exit 1 }
var frontend_ref = $(git -C "$frontend" rev-parse HEAD)
var ib_ref = $(git -C "$ib" rev-parse HEAD)
if (frontend_ref !== '740bbf2b1d9e811fd00c719c3473eede17ceea3b') { echo 'FAIL frontend pin' >&2; exit 1 }
if (ib_ref !== '59716dabd375f0d49b8fb67a18dfd604b33a923a') { echo 'FAIL unchanged IB pin' >&2; exit 1 }
git -C "$ib" diff --quiet -- src examples/autogenerated/native-source-projection
printf '%s  %s\n' '37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f' "$baksmali" | sha256sum -c -
printf '%s  %s\n' '32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a' "$smali" | sha256sum -c -
var backend = "$repository/dex/idric"
var driver = "$backend/build/exec/idric-dex"
var example = "$repository/examples/autogenerated/pure-text-export"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$backend/build/ttc"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/support/c"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
mkdir -p "$evidence/source" "$evidence/fixtures" "$evidence/mutant-source"
cp -a "$ib/src/." "$evidence/source/"
var original = "$ib/examples/autogenerated/native-source-projection/NativeSourceProjection.idric"
cp "$original" "$evidence/source/NativeSourceProjection.idric"
cmp "$original" "$evidence/source/NativeSourceProjection.idric"
cp "$example/HostTitleGoldens.idric" "$evidence/source/HostTitleGoldens.idric"
cp "$example/CopyText.idric" "$example/PrependText.idric" "$example/WrongBoundary.idric" "$example/NameCollision.idric" "$example/EffectEscape.idric" "$example/FrameworkEscape.idric" "$evidence/fixtures/"
printf 'backend\t%s\nfrontend\t%s\nib\t%s\n' $(git -C "$repository" rev-parse HEAD) "$frontend_ref" "$ib_ref" > "$evidence/inputs.tsv"
git -C "$repository" status --porcelain -- dex/idric/src > "$evidence/backend-dirty.txt"
find "$backend/src/Backend/DEX" -maxdepth 1 -type f -name '*.idr' -exec sha256sum '{}' '+' > "$evidence/backend-sources.sha256"
sha256sum "$driver" "${driver}_app/idric-dex.so" "$original" "$ib/src/IB/Information.idric" "$ib/src/IB/RecoveredInformation.idric" > "$evidence/inputs.sha256"

proc emit(name, directory, file) {
  mkdir -p "$evidence/$name"
  printf '\033[36mACTION\033[0m compile %s\n' "$name"
  "$driver" --cg dex --source-dir "$directory" --build-dir "$evidence/$name/build" \
    --output-dir "$evidence/$name" "$directory/$file" -o candidate \
    > "$evidence/$name/compiler.txt" 2>&1
  if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$evidence/$name/compiler.txt" {
    echo 'FAIL compiler returned success with a diagnostic' >&2
    exit 1
  }
  test -s "$evidence/$name/candidate.dex"
  java -jar "$baksmali" disassemble "$evidence/$name/candidate.dex" -o "$evidence/$name/decoded"
  sha256sum "$evidence/$name/candidate.dex" > "$evidence/$name/sha256.txt"
}
proc refuse(name, file, diagnostic) {
  mkdir -p "$evidence/$name"
  try {
    "$driver" --cg dex --source-dir "$evidence/fixtures" --build-dir "$evidence/$name/build" \
      --output-dir "$evidence/$name" "$evidence/fixtures/$file" -o candidate \
      > "$evidence/$name/compiler.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/$name/compiler.exit"
  if (status !== 1) { echo "FAIL expected compiler refusal: $name" >&2; exit 1 }
  test ! -e "$evidence/$name/candidate.dex"
  rg -F "$diagnostic" "$evidence/$name/compiler.txt"
}

# Execute the actual IB helper graph on the host to check these source goldens;
# this reference result remains separate from later ART execution of DEX.
"$frontend/_/build/exec/idris2" --source-dir "$evidence/source" \
  --build-dir "$evidence/host-build" "$evidence/source/HostTitleGoldens.idric" \
  -o title-goldens > "$evidence/host-build.txt" 2>&1
if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$evidence/host-build.txt" {
  echo 'FAIL host compiler returned success with a diagnostic' >&2
  exit 1
}
cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$evidence/host-build/exec/title-goldens_app/"
"$evidence/host-build/exec/title-goldens" > "$evidence/host.txt" 2>&1
rg -x -F 'PASS host reference for actual IB source-title goldens' "$evidence/host.txt"

emit positive "$evidence/source" NativeSourceProjection.idric
emit repeat "$evidence/source" NativeSourceProjection.idric
cmp "$evidence/positive/candidate.dex" "$evidence/repeat/candidate.dex"
var decoded = "$evidence/positive/decoded/Idric/Generated.smali"
sed -n '/^\.method public static source_title(/,/^\.end method$/p' "$decoded" > "$evidence/positive/wrapper.smali"
rg -x -F '.method public static source_title(Ljava/lang/String;)Ljava/lang/String;' "$evidence/positive/wrapper.smali"
rg 'invoke-static.*LIdric/Generated;->__idricManaged[0-9]+\(Ljava/lang/Object;\)Ljava/lang/Object;' "$evidence/positive/wrapper.smali"
rg -F 'check-cast v0, Ljava/lang/String;' "$evidence/positive/wrapper.smali"
if rg '__idric_arguments|__idricArgCount|\.method public static main\(' "$decoded" {
  echo 'FAIL pure source acquired the command argument adapter' >&2
  exit 1
}
emit copy "$evidence/fixtures" CopyText.idric
if rg '__idricManaged' "$evidence/copy/decoded/Idric/Generated.smali" {
  echo 'FAIL view-only roundtrip was gratuitously rerouted' >&2
  exit 1
}
emit marker "$evidence/fixtures" PrependText.idric
rg -x -F '.method public static prepend_marker(Ljava/lang/String;)Ljava/lang/String;' "$evidence/marker/decoded/Idric/Generated.smali"
rg -q '__idricManaged' "$evidence/marker/decoded/Idric/Generated.smali"
emit scalar "$backend/examples" DexArithmetic.idric
emit command "$repository/examples/autogenerated/icu-runtime" CheckedArguments.idric
refuse wrong-boundary WrongBoundary.idric 'dex rejected source ABI'
refuse name-collision NameCollision.idric 'method name collision'
refuse effect-escape EffectEscape.idric 'cannot acquire an IO foreign service'
refuse framework-escape FrameworkEscape.idric 'cannot declare a framework adapter'

# The wrong-title fixture changes the actual exported body, not the oracle.
cp -a "$ib/src/." "$evidence/mutant-source/"
sed '/^source_title source = view_title$/,/^  (information_from_log /c\source_title source = "wrong-title"' \
  "$original" > "$evidence/mutant-source/NativeSourceProjection.idric"
rg -x -F 'source_title source = "wrong-title"' "$evidence/mutant-source/NativeSourceProjection.idric"
if cmp -s "$original" "$evidence/mutant-source/NativeSourceProjection.idric" { echo 'FAIL unchanged mutant' >&2; exit 1 }
emit mutant "$evidence/mutant-source" NativeSourceProjection.idric
java -jar "$smali" assemble "$example/PureTextSourceRunner.smali" -o "$evidence/runner.dex"
test -s "$evidence/runner.dex"
sha256sum "$evidence/runner.dex" > "$evidence/runner.sha256"
printf 'source_emission\tPASS\nexternal_Text_ABI\tPASS\ndeterminism\tPASS\nnegative_source_controls\tPASS\nART\tNOT_RUN\nActivity\tNOT_RUN\nphysical_A1\tNOT_RUN\nphysical_C67\tNOT_RUN\n' > "$evidence/result.tsv"
printf '\033[32mPASS\033[0m unchanged pure source emission, decoded ABI and source refusals; ART separate\n'
