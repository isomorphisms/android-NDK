module CheckedHelpers

public export
bump : Int32 -> Int32
bump value = value + 7

public export
choose_text : Int32 -> Text -> Text
choose_text count text = if count < 1 then "♭𝄪" else text

public export
weighted : Int32 -> Int32 -> Int32 -> Int32 -> Int32 -> Int32 -> Int32
weighted a b c d e f = a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6
