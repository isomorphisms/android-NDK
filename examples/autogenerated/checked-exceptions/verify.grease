#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 10) {
  echo 'usage: grease verify.grease REPOSITORY FRONTEND_SOURCE FRONTEND_RUNTIME DRIVER_SO BACKEND_TTC SCHEME HEAPS BAKSMALI SMALI FRESH_OUTPUT' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var runtime = ARGV[2]
var driver = ARGV[3]
var modules = ARGV[4]
var scheme = ARGV[5]
var heaps = ARGV[6]
var baksmali = ARGV[7]
var smali = ARGV[8]
var output = ARGV[9]
for path in (ARGV) { if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 } }
if test -e "$output" { echo 'FAIL refusing reused exception evidence' >&2; exit 1 }
test $(git -C "$frontend" rev-parse HEAD) = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
var source = "$repository/examples/autogenerated/checked-exceptions"
var compiler = "$runtime/_/build/exec/idris2_app/idris2.so"
setglobal ENV.IDRIS2_PREFIX = "$runtime/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$runtime/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = modules
setglobal ENV.CHEZ = scheme
setglobal ENV.SCHEMEHEAPDIRS = heaps
setglobal ENV.LD_LIBRARY_PATH = "$runtime/_/build/exec/idris2_app"
mkdir -p "$output/plans"
printf 'backend\t%s\nfrontend\t%s\n' $(git -C "$repository" rev-parse HEAD) \
  $(git -C "$frontend" rev-parse HEAD) > "$output/inputs.tsv"
git -C "$repository" diff --binary HEAD > "$output/local.patch"
sha256sum "$compiler" "$driver" "$source/CheckedExceptions.idric" \
  "$source/ExceptionPlans.idric" "$source/ExceptionRunner.smali" \
  "$repository/dex/idric/src/Backend/DEX/IR.idr" \
  "$repository/dex/idric/src/Backend/DEX/Encode.idr" \
  "$repository/dex/idric/src/Backend/DEX/ManagedExceptions.idr" \
  "$repository/dex/idric/src/Backend/DEX/Foreign.idr" > "$output/inputs.sha256"

proc clean_log(log) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" }
  if (_error.code !== 1) { echo 'FAIL source diagnostics or diagnostic checker' >&2; exit 1 }
}
"$scheme" --program "$compiler" -p idris2 --source-dir "$source" \
  --build-dir "$output/plans/build" --output-dir "$output/plans" \
  "$source/ExceptionPlans.idric" -o plans > "$output/plans/compiler.txt" 2>&1
clean_log "$output/plans/compiler.txt"
"$scheme" --program "$output/plans/plans_app/plans.so" > "$output/plans/result.txt" 2>&1
cat "$output/plans/result.txt"
rg -x -F 'PASS checked exception actions, protected regions and handler entry refusals' "$output/plans/result.txt"

proc emit(directory, module, destination) {
  mkdir -p "$destination"
  try {
    "$scheme" --program "$driver" --cg dex --directive managed-exports --source-dir "$directory" \
      --build-dir "$destination/build" --output-dir "$destination" \
      "$directory/$module.idric" -o candidate > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$destination/compiler.exit"
  if (status !== 0) { return 1 }
  clean_log "$destination/compiler.txt"
  test -s "$destination/candidate.dex"
  java -jar "$baksmali" disassemble "$destination/candidate.dex" -o "$destination/decoded"
}
emit "$source" CheckedExceptions "$output/positive"
emit "$source" CheckedExceptions "$output/repeat"
cmp "$output/positive/candidate.dex" "$output/repeat/candidate.dex"
var decoded = "$output/positive/decoded/Idric/Generated.smali"
rg -x -F '.method public static exercise_checked_exceptions(Ljava/lang/StringBuilder;I)Ljava/lang/String;' "$decoded"
rg -x -F '.method public static rethrow_checked_reference(Ljava/lang/Throwable;)V' "$decoded"
rg -F '.catch Ljava/lang/Throwable;' "$decoded"
rg -F 'move-exception' "$decoded"
rg -F 'throw ' "$decoded"
# Reassemble only the compiler's readable output as an independent oracle.
# Candidate bytes above always come from the checked writer.
java -jar "$smali" assemble "$output/positive/candidate.smali" -o "$output/readable-oracle.dex"
java -jar "$baksmali" disassemble "$output/readable-oracle.dex" -o "$output/readable-oracle-decoded"
diff -ru "$output/positive/decoded" "$output/readable-oracle-decoded"

mkdir -p "$output/cleanup-mutant-source" "$output/handler-mutant-source" "$output/rethrow-mutant-source"
sed 's/append sink "cleanup|"/append sink "skipped|"/g' "$source/CheckedExceptions.idric" \
  > "$output/cleanup-mutant-source/CheckedExceptions.idric"
sed 's/"caught:"/"changed:"/g' "$source/CheckedExceptions.idric" \
  > "$output/handler-mutant-source/CheckedExceptions.idric"
sed 's/rethrow_checked_reference failure = primIO (throw_failure failure)/rethrow_checked_reference failure = raise "replacement"/' \
  "$source/CheckedExceptions.idric" > "$output/rethrow-mutant-source/CheckedExceptions.idric"
for mutant in cleanup handler rethrow {
  try { cmp -s "$source/CheckedExceptions.idric" "$output/$mutant-mutant-source/CheckedExceptions.idric" }
  if (_error.code !== 1) { echo 'FAIL unchanged source mutant or comparison failure' >&2; exit 1 }
  emit "$output/$mutant-mutant-source" CheckedExceptions "$output/$mutant-mutant"
  try { cmp -s "$output/positive/candidate.dex" "$output/$mutant-mutant/candidate.dex" }
  if (_error.code !== 1) { echo 'FAIL unchanged compiled exception mutant' >&2; exit 1 }
}
for refusal in WrongAction WrongHandler WrongResult OrdinaryThrowable PureCatch {
  "$scheme" --program "$compiler" --check --source-dir "$source" \
    --build-dir "$output/$refusal-check" "$source/$refusal.idric" > "$output/$refusal-check.txt" 2>&1
  clean_log "$output/$refusal-check.txt"
  try { emit "$source" "$refusal" "$output/$refusal" }
  var status = _error.code
  if (status === 0) { echo 'FAIL unsupported checked exception signature admitted' >&2; exit 1 }
  test $(cat "$output/$refusal/compiler.exit") = 1
  if test -e "$output/$refusal/candidate.dex" { echo 'FAIL refused exception source published DEX' >&2; exit 1 }
  if (refusal === 'OrdinaryThrowable') {
    rg -F 'ordinary algebraic data, not an external reference' "$output/$refusal/compiler.txt"
  } else {
    rg -F 'DEX checked exception operation' "$output/$refusal/compiler.txt"
  }
}
java -jar "$smali" assemble "$source/ExceptionRunner.smali" -o "$output/runner.dex"
java -jar "$baksmali" disassemble "$output/runner.dex" -o "$output/runner-decoded"
sha256sum "$output/positive/candidate.dex" "$output/repeat/candidate.dex" \
  "$output/cleanup-mutant/candidate.dex" "$output/handler-mutant/candidate.dex" \
  "$output/rethrow-mutant/candidate.dex" "$output/runner.dex" > "$output/candidates.sha256"
printf 'checked_exception_source\tPASS\nshared_handler_writer\tPASS\nsource_refusals\tPASS\ncompiled_mutants\tGENERATED\nART\tNOT_RUN\nActivity\tNOT_RUN\nphysical_device\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m checked exception source, protected writer, independent decode, mutations and refusals; ART separate\n'
