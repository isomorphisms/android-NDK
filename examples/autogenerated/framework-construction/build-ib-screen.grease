#!/usr/bin/env grease
# Independent consumer: IB owns every app source/resource; this host supplies
# the exact checked driver and explicitly pinned existing public test signer.
set -eu -o pipefail
if (len(ARGV) !== 7) {
  echo 'usage: grease build-ib-screen.grease BACKEND CORE UPSTREAM IB SDK ORACLES FRESH_EVIDENCE' >&2
  exit 2
}
var repository = ARGV[0]
var core = ARGV[1]
var upstream = ARGV[2]
var ib = ARGV[3]
var sdk = ARGV[4]
var oracles = ARGV[5]
var evidence = ARGV[6]
var runtime_bin = "$repository/.tools/runtime/.build/grease/bin"
test -x "$runtime_bin/grease"
setglobal ENV.PATH = runtime_bin ++ ':' ++ ENV.PATH
for path in "$repository" "$core" "$upstream" "$ib" "$sdk" "$oracles" "$evidence" {
  if (path[0] !== '/') { exit 2 }
}
if test -e "$evidence" { echo 'FAIL refusing reused IB consumer evidence' >&2; exit 1 }
mkdir -p "$evidence"
test "$(git -C "$ib" rev-parse HEAD)" = e53df40034f7e0413f07b5f34b0510f17ae52fd2
curl -fsSL --retry 3 --max-time 60 \
  https://raw.githubusercontent.com/isomorphismes/wegert/89dcfb840cec1a66ee04c7f7404954cbd6c09839/_/build/app/wegert-debug.keystore \
  -o "$evidence/public-test-keystore"
printf 'd83f7a36a205e49b4c755f37d27a0ded02779acc0da82a22e19d458dc6e5a89a  %s\n' "$evidence/public-test-keystore" | sha256sum -c -
grease "$ib/examples/autogenerated/material-reader-screen/build.grease" "$ib" "$repository" "$core" \
  "$upstream/backend/exec/idric-dex" "$upstream/backend/ttc" "$sdk" \
  "$evidence/public-test-keystore" "$oracles/baksmali-3.0.10.jar" "$evidence/build"
grease "$repository/examples/autogenerated/framework-construction/verify-package.grease" \
  "$repository" "$sdk" "$ib/android-material-reader/AndroidManifest.xml" "$ib/android-material-reader/res" \
  "$evidence/build/positive/classes.dex" "$evidence/public-test-keystore" "$evidence/package-controls"
echo 'PASS pinned actual IB native Activity/resources and explicit public test signer; Android UI NOT_RUN' > "$evidence/result.txt"
cat "$evidence/result.txt"
