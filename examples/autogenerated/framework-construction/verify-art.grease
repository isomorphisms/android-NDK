#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) {
  echo 'usage: grease verify-art.grease BACKEND EVIDENCE SMALI_JAR ADB' >&2
  exit 2
}
var repository = ARGV[0]
var evidence = ARGV[1]
var smali = ARGV[2]
var adb = ARGV[3]
for path in "$repository" "$evidence" "$smali" "$adb" {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
rg -q -x -F 'PASS constructor/lifecycle typed controls, inherited regressions, checked source, independent decoding, refusals, two production mutants and deterministic recovery' "$evidence/result.txt"
sha256sum -c "$evidence/input-sha256.txt"
printf '32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a  %s\n' "$smali" | sha256sum -c -
if test -e "$evidence/art" { echo 'FAIL refusing reused constructor ART evidence' >&2; exit 1 }
mkdir -p "$evidence/art"
"$adb" -s emulator-5554 emu avd name > "$evidence/art/emulator.txt"
"$adb" -s emulator-5554 shell getprop ro.build.version.sdk > "$evidence/art/sdk.txt"
"$adb" -s emulator-5554 shell getprop ro.product.cpu.abi > "$evidence/art/abi.txt"
test "$(tr -d '\r' < "$evidence/art/sdk.txt")" = 34
test "$(tr -d '\r' < "$evidence/art/abi.txt")" = x86_64
var observer = "$repository/examples/autogenerated/framework-construction/ConstructionObserver.smali"
java -jar "$smali" assemble "$observer" -o "$evidence/art/observer.dex" > "$evidence/art/observer-compile.txt" 2>&1
test -s "$evidence/art/observer.dex"
sha256sum "$observer" "$evidence/art/observer.dex" > "$evidence/art/observer-sha256.txt"
var remote_base = $("$adb" -s emulator-5554 shell mktemp -d /data/local/tmp/idric-construction-XXXXXXXX)
if (not remote_base.startsWith('/data/local/tmp/idric-construction-')) { exit 1 }
for name in positive recovery {
  var candidate = "$evidence/$name/candidate.dex"
  sha256sum -c "$evidence/$name/sha256.txt"
  var remote = "$remote_base/$name"
  "$adb" -s emulator-5554 shell mkdir "$remote"
  "$adb" -s emulator-5554 push "$candidate" "$remote/candidate.dex" > "$evidence/art/$name-push.txt" 2>&1
  "$adb" -s emulator-5554 push "$evidence/art/observer.dex" "$remote/observer.dex" >> "$evidence/art/$name-push.txt" 2>&1
  "$adb" -s emulator-5554 shell chmod 444 "$remote/candidate.dex" "$remote/observer.dex"
  "$adb" -s emulator-5554 pull "$remote/candidate.dex" "$evidence/art/$name-received.dex" > "$evidence/art/$name-pull.txt" 2>&1
  "$adb" -s emulator-5554 pull "$remote/observer.dex" "$evidence/art/$name-observer-received.dex" >> "$evidence/art/$name-pull.txt" 2>&1
  cmp "$candidate" "$evidence/art/$name-received.dex"
  cmp "$evidence/art/observer.dex" "$evidence/art/$name-observer-received.dex"
  try {
    "$adb" -s emulator-5554 shell app_process -Xmx128m -cp "$remote/candidate.dex:$remote/observer.dex" \
      /system/bin --nice-name=idric-construction-oracle ConstructionObserver > "$evidence/art/$name.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/art/$name.status"
  "$adb" -s emulator-5554 logcat -b all -d > "$evidence/art/$name-logcat.txt"
  test "$status" = 0
  rg -q -x -F 'PASS checked TextView construction, exact native text, selection, empty replacement and width reflow' "$evidence/art/$name.txt"
  cat "$evidence/art/$name.txt"
}
echo 'PASS checked source constructor original/recovery, native text selection and width reflow on Android 14 x86_64' > "$evidence/art/result.txt"
echo 'App lifecycle/resources, APK, physical devices and arbitrary subclass/heap support remain separate' >> "$evidence/art/result.txt"
cat "$evidence/art/result.txt"
