#!/usr/bin/env grease
# Fresh source and backend controls; these do not assert Android execution.
set -eu -o pipefail
if (len(ARGV) !== 7) {
  echo 'usage: grease verify.grease BACKEND CORE DRIVER MODULES IB BAKSMALI FRESH_EVIDENCE' >&2
  exit 2
}
var repository = ARGV[0]
var core = ARGV[1]
var driver = ARGV[2]
var modules = ARGV[3]
var ib = ARGV[4]
var baksmali = ARGV[5]
var evidence = ARGV[6]
for path in "$repository" "$core" "$driver" "$modules" "$ib" "$baksmali" "$evidence" {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
test -x "$driver"
test -x "$core/_/build/exec/idris2"
printf '37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f  %s\n' "$baksmali" | sha256sum -c -
if test -e "$evidence" { echo 'FAIL refusing reused construction evidence' >&2; exit 1 }
mkdir -p "$evidence"
var fixtures = "$repository/examples/autogenerated/framework-construction"
var prefix = "$core/_/bootstrap-build"
var scheme = "$core/_/.tools/bin/scheme"
var compiler = "$core/_/build/exec/idris2"
var api = "$core/_/build/ttc"
var driver_object = "${driver}_app/idric-dex.so"
git -C "$repository" rev-parse HEAD > "$evidence/backend-base.txt"
git -C "$repository" diff --binary HEAD > "$evidence/backend.patch"
git -C "$core" rev-parse HEAD > "$evidence/compiler.txt"
sha256sum "$fixtures/ConstructionChecks.idric" "$fixtures/FrameworkConstructionSource.idric" \
  "$ib/src/IB/Android/ReaderText.idric" "$driver" "$driver_object" \
  "$core/_/build/exec/idris2_app/idris2.so" "$baksmali" > "$evidence/input-sha256.txt"

proc host_suite(source, source_root, name) {
  var output = "$evidence/$name"
  mkdir -p "$output"
  env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$api:$modules" CHEZ="$scheme" \
    "$compiler" -p network --cg chez --source-dir "$source_root" --build-dir "$output/build" \
    --output-dir "$output" "$source" -o controls > "$output/compile.txt" 2>&1
  test -x "$output/controls"
  cp "$core/_/build/exec/idris2_app/libidris2_support.so" "$output/controls_app/"
  env CHEZ="$scheme" "$output/controls" "$output/high-construction.dex" > "$output/result.txt" 2>&1
  cat "$output/result.txt"
}
host_suite "$fixtures/ConstructionChecks.idric" "$fixtures" construction-controls
rg -q -x -F 'PASS checked framework constructor controls' "$evidence/construction-controls/result.txt"
java -jar "$baksmali" disassemble "$evidence/construction-controls/high-construction.dex" \
  -o "$evidence/high-decoded"
rg -q -F 'new-instance v0, Landroid/widget/TextView;' "$evidence/high-decoded/Idric/HighConstruction.smali"
rg -q -F 'invoke-direct/range {v302 .. v303}' "$evidence/high-decoded/Idric/HighConstruction.smali"
host_suite "$repository/examples/autogenerated/interface-callback/CallbackPlanChecks.idric" \
  "$repository/examples/autogenerated/interface-callback" inherited-callback
host_suite "$repository/dex/idric/tests/dex/ForeignSpecTest.idr" "$repository/dex/idric/tests/dex" inherited-foreign
host_suite "$repository/dex/idric/tests/dex/EncoderSelfTest.idr" "$repository/dex/idric/tests/dex" inherited-encoder
host_suite "$repository/dex/idric/tests/dex/FinalizedLayoutCheck.idr" "$repository/dex/idric/tests/dex" inherited-layout

proc source_candidate(name, mode) {
  var refusal = mode === 'refuse'
  var directory = "$evidence/$name-source"
  var output = "$evidence/$name"
  mkdir -p "$directory/IB/Android" "$output"
  cp "$ib/src/IB/Android/ReaderText.idric" "$directory/IB/Android/"
  if (name === 'text-mutant') {
    sed 's/platform_characters text 0 character_units/platform_characters text 0 0/' \
      "$ib/src/IB/Android/ReaderText.idric" > "$directory/IB/Android/ReaderText.idric"
  } elif (name === 'reflow-mutant') {
    sed 's/set_reader_horizontal_scrolling view 0/set_reader_horizontal_scrolling view 1/' \
      "$ib/src/IB/Android/ReaderText.idric" > "$directory/IB/Android/ReaderText.idric"
  } elif (name === 'selection-mutant') {
    sed 's/set_reader_selection view 1/set_reader_selection view 0/' \
      "$ib/src/IB/Android/ReaderText.idric" > "$directory/IB/Android/ReaderText.idric"
  }
  if (name === 'text-mutant' or name === 'reflow-mutant' or name === 'selection-mutant') {
    if cmp -s "$ib/src/IB/Android/ReaderText.idric" "$directory/IB/Android/ReaderText.idric" { echo 'FAIL unchanged reader mutant' >&2; exit 1 }
  }
  var original = "$fixtures/FrameworkConstructionSource.idric"
  var target = "$directory/FrameworkConstructionSource.idric"
  if (name === 'wrong-name') {
    sed 's/:<init>:/:factory:/' "$original" > "$target"
  } elif (name === 'nonvoid') {
    sed 's/(Landroid\/content\/Context;)V/(Landroid\/content\/Context;)I/' "$original" > "$target"
  } else { cp "$original" "$target" }
  env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$api" CHEZ="$scheme" \
    "$compiler" --check --source-dir "$directory" --build-dir "$output/check" \
    "$target" > "$output/check.txt" 2>&1
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$output/check.txt" }
  if (_error.code !== 1) { cat "$output/check.txt"; exit 1 }
  try {
    env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$modules" CHEZ="$scheme" \
      "$driver" --cg dex --source-dir "$directory" --build-dir "$output/build" \
      --output-dir "$output" "$target" -o candidate > "$output/compile.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$output/status.txt"
  if (refusal) {
    if test -e "$output/candidate.dex" { echo 'FAIL refused source emitted DEX' >&2; exit 1 }
    if (name === 'wrong-name') { rg -q -F 'DEX construction requires the <init> method' "$output/compile.txt" }
    if (name === 'nonvoid') { rg -q -F 'DEX construction requires PrimIO and a void JVM constructor result' "$output/compile.txt" }
  } else {
    test -s "$output/candidate.dex"
    try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$output/compile.txt" }
    if (_error.code !== 1) { cat "$output/compile.txt"; exit 1 }
    java -jar "$baksmali" disassemble "$output/candidate.dex" -o "$output/decoded"
    rg -q -F 'new-instance' "$output/decoded/Idric/Generated.smali"
    rg -q -F 'Landroid/widget/TextView;-><init>(Landroid/content/Context;)V' "$output/decoded/Idric/Generated.smali"
    sha256sum "$output/candidate.dex" > "$output/sha256.txt"
  }
}
source_candidate positive accept
source_candidate wrong-name refuse
source_candidate nonvoid refuse
source_candidate recovery accept
source_candidate text-mutant accept
source_candidate reflow-mutant accept
source_candidate selection-mutant accept
for name in text-mutant reflow-mutant selection-mutant {
  if cmp -s "$evidence/positive/candidate.dex" "$evidence/$name/candidate.dex" { echo 'FAIL reader mutant DEX unchanged' >&2; exit 1 }
}
cmp "$evidence/positive/candidate.dex" "$evidence/recovery/candidate.dex"
# Compile actual backend mutations without the original backend TTC path.
for mutation in allocation parent-arguments {
  var directory = "$evidence/$mutation-source"
  var output = "$evidence/$mutation-control"
  mkdir -p "$directory" "$output"
  cp -R "$repository/dex/idric/src/Backend" "$directory/"
  cp "$fixtures/ConstructionChecks.idric" "$directory/"
  if (mutation === 'allocation') {
    sed 's/Right (destination.number > 255, 0)/Right (False, 0)/' \
      "$repository/dex/idric/src/Backend/DEX/Placement.idr" > "$directory/Backend/DEX/Placement.idr"
    if cmp -s "$repository/dex/idric/src/Backend/DEX/Placement.idr" "$directory/Backend/DEX/Placement.idr" { exit 1 }
  } else {
    sed 's/InvokeSuper call_parent incoming Nothing/InvokeSuper call_parent (take 1 incoming) Nothing/' \
      "$repository/dex/idric/src/Backend/DEX/Callback.idr" > "$directory/Backend/DEX/Callback.idr"
    if cmp -s "$repository/dex/idric/src/Backend/DEX/Callback.idr" "$directory/Backend/DEX/Callback.idr" { exit 1 }
  }
  env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$api" CHEZ="$scheme" \
    "$compiler" -p network --cg chez --source-dir "$directory" --build-dir "$output/build" \
    --output-dir "$output" "$directory/ConstructionChecks.idric" -o controls > "$output/compile.txt" 2>&1
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$output/compile.txt" }
  if (_error.code !== 1) { cat "$output/compile.txt"; exit 1 }
  test -x "$output/controls"
  cp "$core/_/build/exec/idris2_app/libidris2_support.so" "$output/controls_app/"
  try { env CHEZ="$scheme" "$output/controls" "$output/rejected.dex" > "$output/result.txt" 2>&1 }
  var status = _error.code
  printf '%s\n' "$status" > "$output/status.txt"
  test "$status" = 1
  if (mutation === 'allocation') { rg -q -x -F 'DEX new-instance requires a destination in v0..v255' "$output/result.txt" }
  if (mutation === 'parent-arguments') { rg -q -x -F 'FAIL Bundle and receiver forwarded to parent' "$output/result.txt" }
  if test -e "$output/rejected.dex" { echo 'FAIL production mutant wrote accepted DEX' >&2; exit 1 }
}
echo 'PASS constructor/lifecycle typed controls, inherited regressions, checked source, independent decoding, refusals, two production mutants and deterministic recovery' > "$evidence/result.txt"
echo 'Construction/runtime and APK/physical acceptance remain separate' >> "$evidence/result.txt"
cat "$evidence/result.txt"
