#!/usr/bin/env grease
# Source-generated candidate and independent smali observer remain separate APKs.
# Normal Android instrumentation owns Application/UID/provider/font setup.
set -eu -o pipefail
if (len(ARGV) !== 6) {
  echo 'usage: grease verify-instrumentation.grease BACKEND EVIDENCE SMALI_JAR SDK TEST_KEYSTORE ADB' >&2
  exit 2
}
var repository = ARGV[0]
var evidence = ARGV[1]
var smali = ARGV[2]
var sdk = ARGV[3]
var keystore = ARGV[4]
var adb = ARGV[5]
for path in "$repository" "$evidence" "$smali" "$sdk" "$keystore" "$adb" {
  if (path[0] !== '/') { exit 2 }
}
var controls = "$repository/examples/autogenerated/framework-construction/instrumentation"
var tools = "$sdk/build-tools/35.0.0"
var certificate = 'de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9'
sha256sum -c "$evidence/input-sha256.txt"
printf '32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a  %s\n' "$smali" | sha256sum -c -
if test -e "$evidence/instrumentation" { echo 'FAIL refusing reused instrumentation evidence' >&2; exit 1 }
var output = "$evidence/instrumentation"
mkdir -p "$output"
java -jar "$smali" assemble "$controls" -o "$output/observer.dex"
sha256sum "$controls/ReaderChecks.smali" "$controls/ReaderInstrumentation.smali" \
  "$output/observer.dex" "$keystore" > "$output/observer-inputs-sha256.txt"
"$adb" -s emulator-5554 emu avd name > "$output/emulator.txt"
"$adb" -s emulator-5554 shell getprop ro.build.version.sdk > "$output/sdk.txt"
"$adb" -s emulator-5554 shell getprop ro.product.cpu.abi > "$output/abi.txt"
test "$(tr -d '\r' < "$output/sdk.txt")" = 34
test "$(tr -d '\r' < "$output/abi.txt")" = x86_64
for package in org.isomorphisms.idric.construct.test org.isomorphisms.idric.construct.oracle {
  "$adb" -s emulator-5554 shell pm list packages "$package" > "$output/$package-prior.txt"
  if rg -q -x -F "package:$package" "$output/$package-prior.txt" { echo 'FAIL qualification namespace already installed' >&2; exit 1 }
}

proc package_fixture(manifest, dex, directory) {
  mkdir -p "$directory"
  "$tools/aapt2" link -I "$sdk/platforms/android-34/android.jar" --manifest "$manifest" -o "$directory/base.apk"
  cp "$directory/base.apk" "$directory/unaligned.apk"
  cp "$dex" "$directory/classes.dex"
  forkwait {
    cd "$directory"
    zip -q unaligned.apk classes.dex
  }
  "$tools/zipalign" -f -p 4 "$directory/unaligned.apk" "$directory/aligned.apk"
  "$tools/apksigner" sign --ks "$keystore" --ks-key-alias wegert-debug \
    --ks-pass pass:wegert-debug --key-pass pass:wegert-debug --out "$directory/fixture.apk" "$directory/aligned.apk"
  "$tools/apksigner" verify --print-certs "$directory/fixture.apk" > "$directory/signature.txt"
  rg -q -x -F "Signer #1 certificate SHA-256 digest: $certificate" "$directory/signature.txt"
  unzip -p "$directory/fixture.apk" classes.dex > "$directory/received.dex"
  cmp "$dex" "$directory/received.dex"
}
package_fixture "$controls/oracle-manifest.xml" "$output/observer.dex" "$output/oracle"
"$adb" -s emulator-5554 install "$output/oracle/fixture.apk" > "$output/oracle-install.txt" 2>&1
rg -q -x -F Success "$output/oracle-install.txt"
for name in positive text-mutant reflow-mutant selection-mutant recovery {
  var candidate = "$evidence/$name/candidate.dex"
  sha256sum -c "$evidence/$name/sha256.txt"
  var directory = "$output/$name"
  package_fixture "$controls/target-manifest.xml" "$candidate" "$directory"
  if (name === 'positive') {
    "$adb" -s emulator-5554 install "$directory/fixture.apk" > "$directory/install.txt" 2>&1
  } else {
    "$adb" -s emulator-5554 install -r "$directory/fixture.apk" > "$directory/install.txt" 2>&1
  }
  rg -q -x -F Success "$directory/install.txt"
  var installed = $("$adb" -s emulator-5554 shell pm path org.isomorphisms.idric.construct.test | tr -d '\r' | sed 's/^package://')
  if (not installed.startsWith('/data/app/') or not installed.endsWith('/base.apk')) { exit 1 }
  "$adb" -s emulator-5554 pull "$installed" "$directory/installed.apk" > "$directory/pull.txt" 2>&1
  cmp "$directory/fixture.apk" "$directory/installed.apk"
  "$adb" -s emulator-5554 shell am instrument -w -r \
    org.isomorphisms.idric.construct.oracle/Idric.ReaderInstrumentation > "$directory/runtime.txt" 2>&1
  "$adb" -s emulator-5554 logcat -b all -d > "$directory/logcat.txt"
  cat "$directory/runtime.txt"
  if (name === 'positive' or name === 'recovery') {
    rg -q -x -F 'INSTRUMENTATION_CODE: 0' "$directory/runtime.txt"
    rg -q -x -F 'INSTRUMENTATION_RESULT: stream=PASS checked TextView construction, exact native text, selection, empty replacement and width reflow' "$directory/runtime.txt"
  } else {
    rg -q -x -F 'INSTRUMENTATION_CODE: 73' "$directory/runtime.txt"
    if (name === 'text-mutant') { rg -q -x -F 'INSTRUMENTATION_RESULT: stream=FAIL exact native reader text' "$directory/runtime.txt" }
    if (name === 'reflow-mutant') { rg -q -x -F 'INSTRUMENTATION_RESULT: stream=FAIL native reader width reflow' "$directory/runtime.txt" }
    if (name === 'selection-mutant') { rg -q -x -F 'INSTRUMENTATION_RESULT: stream=FAIL native reader selection' "$directory/runtime.txt" }
  }
}
echo 'PASS registered Android constructor/text/selection/reflow; three production mutants rejected; recovery passed' > "$output/result.txt"
echo 'Native app UI and physical acceptance are separate; observer never supplies candidate DEX' >> "$output/result.txt"
cat "$output/result.txt"
