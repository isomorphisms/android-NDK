module CallbackResultPlanChecks

import Backend.DEX.Callback
import Backend.DEX.Encode
import Backend.DEX.IR
import Backend.DEX.Smali
import Data.List
import Data.Text
import System

%default covering

activity : FrameworkValueType
activity = ReferenceValue (MkTypeReference "Landroid/app/Activity;")
view : FrameworkValueType
view = ReferenceValue (MkTypeReference "Landroid/view/View;")
insets : FrameworkValueType
insets = ReferenceValue (MkTypeReference "Landroid/view/WindowInsets;")

boolean_source : MethodPlan
boolean_source = MkMethodPlan "checked Boolean source" "predicate" 1 [view]
  (ExistingValue BooleanValue) 2 [IntegerConstant (MkRegister 0) 1, ReturnInteger (MkRegister 0)]

reference_source : MethodPlan
reference_source = MkMethodPlan "checked reference source" "reference" 2 [view, insets]
  insets 2 [ReturnObject (MkRegister 1)]

receiver_boolean_source : MethodPlan
receiver_boolean_source = { parameter_types := [activity, view], parameter_count := 2,
  register_count := 3 } boolean_source

receiver_reference_source : MethodPlan
receiver_reference_source = { parameter_types := [activity, view, insets], parameter_count := 3,
  register_count := 3, instructions := [ReturnObject (MkRegister 2)] } reference_source

text_source : MethodPlan
text_source = MkMethodPlan "checked Text source" "text" 0 [] (ExistingValue TextValue) 1
  [TextConstant (MkRegister 0) "value", ReturnObject (MkRegister 0)]

wide_argument_source : MethodPlan
wide_argument_source = { parameter_types := [activity, LongValue, ExistingValue IntegerValue],
  parameter_count := 3, register_count := 5 } boolean_source

boolean_directive : Text
boolean_directive = "callback Landroid/view/View$OnLongClickListener; onLongClick (Landroid/view/View;)Z predicate"
reference_directive : Text
reference_directive = "callback Landroid/view/View$OnApplyWindowInsetsListener; onApplyWindowInsets (Landroid/view/View;Landroid/view/WindowInsets;)Landroid/view/WindowInsets; reference"
parent : Text
parent = "extends Landroid/app/Activity;"

same_return : Instruction → Instruction → Bool
same_return ReturnVoid ReturnVoid = True
same_return (ReturnInteger left) (ReturnInteger right) = left ≟ right
same_return (ReturnObject left) (ReturnObject right) = left ≟ right
same_return _ _ = False

bridge_has_result : MethodPlan → Text → FrameworkValueType →
                    List Register → Instruction → Bool
bridge_has_result source declaration result expected returned =
  case with_interface_callbacks "LIdric/Generated;" [source] [declaration] of
    Left _ ⇒ False
    Right plan ⇒ case filter (\method ⇒ method.mode ≟ InstanceMethod) plan.methods of
      [bridge] ⇒ bridge.result_type ≟ result &&
        case bridge.instructions of
          [InvokeMethod invocation, actual_return] ⇒
            invocation.kind ≟ InvokeStatic && invocation.arguments ≟ expected &&
            invocation.result_register ≟ Just (MkRegister 0) && same_return actual_return returned
          _ ⇒ False
      _ ⇒ False

receiver_bridge : MethodPlan → Text → FrameworkValueType → List Register → Bool
receiver_bridge source declaration result expected =
  case with_interface_callbacks "LIdric/Generated;" [source] [parent, declaration] of
    Left _ ⇒ False
    Right plan ⇒ plan.superclass ≟ MkTypeReference "Landroid/app/Activity;" &&
      case filter (\method ⇒ method.mode ≟ InstanceMethod) plan.methods of
        [bridge] ⇒ bridge.result_type ≟ result &&
          case bridge.instructions of
            [InvokeMethod invocation, returned] ⇒
              invocation.arguments ≟ expected && invocation.result_register ≟ Just (MkRegister 0) &&
              invocation.method.argument_types ≟ source.parameter_types
            _ ⇒ False
        _ ⇒ False

refuses : Either Text value → Bool
refuses (Left _) = True
refuses (Right _) = False

encodes : Bool
encodes = case with_interface_callbacks "LIdric/Generated;"
  [receiver_boolean_source, receiver_reference_source]
  [parent, "callback receiver Landroid/view/View$OnLongClickListener; onLongClick (Landroid/view/View;)Z predicate",
    "callback receiver Landroid/view/View$OnApplyWindowInsetsListener; onApplyWindowInsets (Landroid/view/View;Landroid/view/WindowInsets;)Landroid/view/WindowInsets; reference"] of
  Left _ ⇒ False
  Right plan ⇒ case finalize_file_plan plan of
    Left _ ⇒ False
    Right frozen ⇒ case encode_finalized_dex frozen of
      Left _ ⇒ False
      Right bytes ⇒ not (null bytes) &&
        isInfixOf ".method public onLongClick(Landroid/view/View;)Z" (render_finalized_smali frozen) &&
        isInfixOf ".method public onApplyWindowInsets(Landroid/view/View;Landroid/view/WindowInsets;)Landroid/view/WindowInsets;" (render_finalized_smali frozen)

checks : List (Text, Bool)
checks =
  [ ("Boolean-result-is-returned", bridge_has_result boolean_source boolean_directive
      (ExistingValue BooleanValue) [MkRegister 2] (ReturnInteger (MkRegister 0)))
  , ("reference-result-is-returned", bridge_has_result reference_source reference_directive
      insets [MkRegister 2, MkRegister 3] (ReturnObject (MkRegister 0)))
  , ("Text-result-is-returned", bridge_has_result text_source
      "callback LFixture/TextListener; getText ()Ljava/lang/String; text"
      (ExistingValue TextValue) [] (ReturnObject (MkRegister 0)))
  , ("Activity-receiver-is-first-Boolean-source-argument", receiver_bridge receiver_boolean_source
      "callback receiver Landroid/view/View$OnLongClickListener; onLongClick (Landroid/view/View;)Z predicate"
      (ExistingValue BooleanValue) [MkRegister 1, MkRegister 2])
  , ("Activity-receiver-is-first-reference-source-argument", receiver_bridge receiver_reference_source
      "callback receiver Landroid/view/View$OnApplyWindowInsetsListener; onApplyWindowInsets (Landroid/view/View;Landroid/view/WindowInsets;)Landroid/view/WindowInsets; reference"
      insets [MkRegister 1, MkRegister 2, MkRegister 3])
  , ("wide-argument-keeps-next-register-after-pair", receiver_bridge wide_argument_source
      "callback receiver LFixture/WideListener; receive (JI)Z predicate"
      (ExistingValue BooleanValue) [MkRegister 1, MkRegister 2, MkRegister 4])
  , ("receiver-without-Activity-refuses", refuses (with_interface_callbacks "LIdric/Generated;"
      [receiver_boolean_source] ["callback receiver Landroid/view/View$OnLongClickListener; onLongClick (Landroid/view/View;)Z predicate"]))
  , ("wrong-receiver-source-type-refuses", refuses (with_interface_callbacks "LIdric/Generated;"
      [{ parameter_types := [ExistingValue ObjectValue, view] } receiver_boolean_source]
      [parent, "callback receiver Landroid/view/View$OnLongClickListener; onLongClick (Landroid/view/View;)Z predicate"]))
  , ("wrong-source-result-refuses", refuses (with_interface_callbacks "LIdric/Generated;"
      [{ result_type := VoidValue } boolean_source] [boolean_directive]))
  , ("Int32-callback-result-remains-unqualified", refuses (with_interface_callbacks "LIdric/Generated;"
      [{ result_type := ExistingValue IntegerValue } boolean_source]
      ["callback LFixture/IntListener; getInt (Landroid/view/View;)I predicate"]))
  , ("Int64-callback-result-remains-unqualified", refuses (with_interface_callbacks "LIdric/Generated;"
      [{ result_type := LongValue } boolean_source]
      ["callback LFixture/LongListener; getLong (Landroid/view/View;)J predicate"]))
  , ("floating-callback-result-remains-unqualified", refuses (with_interface_callbacks "LIdric/Generated;"
      [{ result_type := ExistingValue DoubleValue } boolean_source]
      ["callback LFixture/DoubleListener; getDouble (Landroid/view/View;)D predicate"]))
  , ("array-callback-result-remains-unqualified", refuses (with_interface_callbacks "LIdric/Generated;"
      [{ result_type := ReferenceValue (MkTypeReference "[I") } boolean_source]
      ["callback LFixture/ArrayListener; getArray (Landroid/view/View;)[I predicate"]))
  , ("finalized-Activity-interface-results-encode", encodes)
  ]

main : IO ()
main = do
  traverse_ (\(name, passed) ⇒ putStrLn ((if passed then "PASS " else "FAIL ") ++ name)) checks
  if all snd checks then putStrLn "PASS checked callback result plans" else exitFailure
