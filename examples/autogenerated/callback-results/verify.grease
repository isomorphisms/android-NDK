#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 7) {
  echo 'usage: grease verify.grease REPOSITORY FRONTEND DRIVER BACKEND_TTC BAKSMALI SMALI FRESH_OUTPUT' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var modules = ARGV[3]
var baksmali = ARGV[4]
var smali = ARGV[5]
var output = ARGV[6]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused callback-result evidence' >&2; exit 1 }
test $(git -C "$frontend" rev-parse HEAD) = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
var source = "$repository/examples/autogenerated/callback-results"
var compiler = "$frontend/_/build/exec/idris2"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = modules
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
mkdir -p "$output"
printf 'backend\t%s\nfrontend\t%s\n' $(git -C "$repository" rev-parse HEAD) \
  $(git -C "$frontend" rev-parse HEAD) > "$output/inputs.tsv"
git -C "$repository" diff --binary HEAD > "$output/local.patch"
sha256sum "$repository/dex/idric/src/Backend/DEX/Callback.idr" \
  "$source/CallbackResultSource.idric" "$source/CallbackResultPlanChecks.idric" \
  "$source/CallbackResultRunner.smali" "$driver" > "$output/source-artifacts.sha256"

proc clean_log(log) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" }
  var status = _error.code
  if (status === 0) { echo 'FAIL callback-result source diagnostic' >&2; exit 1 }
  if (status !== 1) { echo 'FAIL callback-result diagnostic checker' >&2; exit 1 }
}
proc host_check(directory, module, destination) {
  mkdir -p "$destination"
  try {
    "$compiler" -p idris2 --source-dir "$directory" --build-dir "$destination/build" \
      --output-dir "$destination" "$directory/$module.idric" -o plans > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  cat "$destination/compiler.txt"
  if (status !== 0) { echo 'FAIL callback typed-plan compilation' >&2; exit 1 }
  clean_log "$destination/compiler.txt"
  cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$destination/plans_app/"
  "$destination/plans" > "$destination/result.txt" 2>&1
  cat "$destination/result.txt"
}
host_check "$source" CallbackResultPlanChecks "$output/host"
rg -x -F 'PASS checked callback result plans' "$output/host/result.txt"
host_check "$repository/examples/autogenerated/interface-callback" CallbackPlanChecks "$output/legacy-host"
rg -x -F 'PASS callback typed-plan controls' "$output/legacy-host/result.txt"

proc emit(directory, destination) {
  mkdir -p "$destination"
  try {
    "$driver" --cg dex --directive managed-exports --source-dir "$directory" \
      --build-dir "$destination/build" --output-dir "$destination" \
      "$directory/CallbackResultSource.idric" -o candidate > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  cat "$destination/compiler.txt"
  printf '%s\n' "$status" > "$destination/compiler.exit"
  if (status !== 0) { echo 'FAIL checked callback-result emission' >&2; return 1 }
  clean_log "$destination/compiler.txt"
  test -s "$destination/candidate.dex"
  java -jar "$baksmali" disassemble "$destination/candidate.dex" -o "$destination/decoded"
}
emit "$source" "$output/positive"
emit "$source" "$output/repeat"
cmp "$output/positive/candidate.dex" "$output/repeat/candidate.dex"
rg -x -F '.super Landroid/app/Activity;' "$output/positive/decoded/Idric/Generated.smali"
rg -x -F '.method public onLongClick(Landroid/view/View;)Z' "$output/positive/decoded/Idric/Generated.smali"
rg -x -F '.method public onApplyWindowInsets(Landroid/view/View;Landroid/view/WindowInsets;)Landroid/view/WindowInsets;' "$output/positive/decoded/Idric/Generated.smali"
mkdir -p "$output/boolean-mutant-source" "$output/reference-mutant-source"
sed 's/identity ≟ 101/identity ≟ 102/' "$source/CallbackResultSource.idric" > "$output/boolean-mutant-source/CallbackResultSource.idric"
sed 's/action ≟ "consume"/action ≟ "ignore"/' "$source/CallbackResultSource.idric" > "$output/reference-mutant-source/CallbackResultSource.idric"
if cmp -s "$source/CallbackResultSource.idric" "$output/boolean-mutant-source/CallbackResultSource.idric" {
  echo 'FAIL unchanged Boolean source mutation' >&2; exit 1
}
if cmp -s "$source/CallbackResultSource.idric" "$output/reference-mutant-source/CallbackResultSource.idric" {
  echo 'FAIL unchanged reference source mutation' >&2; exit 1
}
emit "$output/boolean-mutant-source" "$output/boolean-mutant"
emit "$output/reference-mutant-source" "$output/reference-mutant"
if cmp -s "$output/positive/candidate.dex" "$output/boolean-mutant/candidate.dex" {
  echo 'FAIL unchanged Boolean mutant bytes' >&2; exit 1
}
if cmp -s "$output/positive/candidate.dex" "$output/reference-mutant/candidate.dex" {
  echo 'FAIL unchanged reference mutant bytes' >&2; exit 1
}
java -jar "$smali" assemble "$source/CallbackResultRunner.smali" -o "$output/runner.dex"
sha256sum "$output/positive/candidate.dex" "$output/boolean-mutant/candidate.dex" \
  "$output/reference-mutant/candidate.dex" "$output/runner.dex" > "$output/candidates.sha256"

for refusal in missing-export wrong-result implicit-receiver no-parent array-result {
  var directory = "$output/$refusal-source"
  mkdir -p "$directory"
  if (refusal === 'missing-export') {
    sed 's/)Z receive_long_click/)Z absent_export/' "$source/CallbackResultSource.idric" > "$directory/CallbackResultSource.idric"
  } elif (refusal === 'wrong-result') {
    sed 's/onLongClick (Landroid\/view\/View;)Z/onLongClick (Landroid\/view\/View;)Ljava\/lang\/String;/' "$source/CallbackResultSource.idric" > "$directory/CallbackResultSource.idric"
  } elif (refusal === 'implicit-receiver') {
    sed 's/callback receiver Landroid\/view\/View\$OnLongClickListener;/callback Landroid\/view\/View$OnLongClickListener;/' "$source/CallbackResultSource.idric" > "$directory/CallbackResultSource.idric"
  } elif (refusal === 'no-parent') {
    sed '/%cg dex extends Landroid\/app\/Activity;/d' "$source/CallbackResultSource.idric" > "$directory/CallbackResultSource.idric"
  } else {
    sed 's/)Landroid\/view\/WindowInsets; receive_insets/)[I receive_insets/' "$source/CallbackResultSource.idric" > "$directory/CallbackResultSource.idric"
  }
  "$compiler" --check --source-dir "$directory" --build-dir "$output/$refusal-check" \
    "$directory/CallbackResultSource.idric" > "$output/$refusal-check.txt" 2>&1
  clean_log "$output/$refusal-check.txt"
  try { emit "$directory" "$output/$refusal" }
  var status = _error.code
  if (status === 0) { echo 'FAIL unsupported callback source was admitted' >&2; exit 1 }
  test $(cat "$output/$refusal/compiler.exit") = 1
  if test -e "$output/$refusal/candidate.dex" { echo 'FAIL refused callback emitted DEX' >&2; exit 1 }
  if (refusal === 'missing-export') {
    rg -F 'DEX callback has no unique checked static export' "$output/$refusal/compiler.txt"
  } elif (refusal === 'no-parent') {
    rg -F 'DEX receiver callback requires a checked Activity superclass' "$output/$refusal/compiler.txt"
  } elif (refusal === 'array-result') {
    rg -F 'DEX callback result must be void, Boolean, Text or a non-array object reference' "$output/$refusal/compiler.txt"
  } else {
    rg -F 'DEX callback signature disagrees with checked export' "$output/$refusal/compiler.txt"
  }
}
printf 'callback_result_source\tPASS\nlegacy_callback_plans\tPASS\nsource_refusals\tPASS\ndeterministic_bytes\tPASS\nART\tNOT_RUN\nAPK\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m checked callback results/receivers, source refusals and direct DEX; ART separate\n'
