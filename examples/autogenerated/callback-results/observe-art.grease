#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 3) { echo 'usage: grease observe-art.grease ADB SERIAL EVIDENCE' >&2; exit 2 }
var adb = ARGV[0]
var serial = ARGV[1]
var evidence = ARGV[2]
if (adb[0] !== '/' or evidence[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
if test -e "$evidence/art" { echo 'FAIL refusing reused callback-result ART evidence' >&2; exit 1 }
mkdir -p "$evidence/art"
"$adb" -s "$serial" emu avd name > "$evidence/art/emulator.txt"
"$adb" -s "$serial" shell getprop ro.build.version.sdk > "$evidence/art/sdk.txt"
"$adb" -s "$serial" shell getprop ro.product.cpu.abi > "$evidence/art/abi.txt"
for candidate in positive boolean-mutant reference-mutant {
  var remote = "/data/local/tmp/idric-callback-results-$candidate"
  "$adb" -s "$serial" shell mkdir -p "$remote"
  "$adb" -s "$serial" push "$evidence/$candidate/candidate.dex" "$remote/candidate.dex"
  "$adb" -s "$serial" push "$evidence/runner.dex" "$remote/runner.dex"
  "$adb" -s "$serial" shell chmod 444 "$remote/candidate.dex" "$remote/runner.dex"
  "$adb" -s "$serial" pull "$remote/candidate.dex" "$evidence/art/$candidate-received.dex"
  "$adb" -s "$serial" pull "$remote/runner.dex" "$evidence/art/$candidate-runner-received.dex"
  cmp "$evidence/$candidate/candidate.dex" "$evidence/art/$candidate-received.dex"
  cmp "$evidence/runner.dex" "$evidence/art/$candidate-runner-received.dex"
  try {
    "$adb" -s "$serial" shell "CLASSPATH=$remote/candidate.dex:$remote/runner.dex app_process /system/bin CallbackResultRunner" \
      > "$evidence/art/$candidate.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/art/$candidate.exit"
  cat "$evidence/art/$candidate.txt"
  if (candidate === 'positive') {
    if (status !== 0) { echo 'FAIL actual callback-result ART execution' >&2; exit 1 }
    rg -x -F 'PASS checked callback results and actual Activity receivers' "$evidence/art/$candidate.txt"
  } else {
    if (status !== 91) { echo 'FAIL missing designated callback source mutation rejection' >&2; exit 1 }
    rg -x -F 'FAIL checked callback results and actual Activity receivers' "$evidence/art/$candidate.txt"
  }
}
printf 'Boolean_callback_ART\tPASS\nreference_callback_ART\tPASS\nactual_Activity_receivers\tPASS\ncompiled_Boolean_source_mutant_rejected\tPASS\ncompiled_reference_source_mutant_rejected\tPASS\nprivate_captured_state\tNOT_IMPLEMENTED\nAPK\tNOT_RUN\nphysical_device\tNOT_RUN\n' > "$evidence/art/result.tsv"
printf '\033[32mPASS\033[0m checked Boolean/reference callback results and actual Activity receivers on ART\n'
