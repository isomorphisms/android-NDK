#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 3) { echo 'usage: grease observe-art.grease ADB SERIAL EVIDENCE' >&2; exit 2 }
var adb = ARGV[0]
var serial = ARGV[1]
var evidence = ARGV[2]
if (adb[0] !== '/' or evidence[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
if test -e "$evidence/art" { echo 'FAIL refusing reused callback-result ART evidence' >&2; exit 1 }
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
var api = $("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')
if (api !== ENV.AICI_EXPECTED_ANDROID_API or (api !== '29' and api !== '34')) {
  echo 'FAIL unexpected callback-result ART API' >&2; exit 1
}
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
mkdir -p "$evidence/art"
"$adb" -s "$serial" emu avd name > "$evidence/art/emulator.txt"
"$adb" -s "$serial" shell getprop ro.build.version.sdk > "$evidence/art/sdk.txt"
"$adb" -s "$serial" shell getprop ro.product.cpu.abi > "$evidence/art/abi.txt"
for candidate in positive boolean-mutant reference-mutant {
  var remote = "/data/local/tmp/idric-callback-results-$candidate"
  "$adb" -s "$serial" shell mkdir -p "$remote"
  "$adb" -s "$serial" push "$evidence/$candidate/candidate.dex" "$remote/candidate.dex"
  "$adb" -s "$serial" push "$evidence/runner.dex" "$remote/runner.dex"
  "$adb" -s "$serial" shell chmod 444 "$remote/candidate.dex" "$remote/runner.dex"
  "$adb" -s "$serial" pull "$remote/candidate.dex" "$evidence/art/$candidate-received.dex"
  "$adb" -s "$serial" pull "$remote/runner.dex" "$evidence/art/$candidate-runner-received.dex"
  cmp "$evidence/$candidate/candidate.dex" "$evidence/art/$candidate-received.dex"
  cmp "$evidence/runner.dex" "$evidence/art/$candidate-runner-received.dex"
  # Keep bounded snapshots without clearing unrelated process diagnostics.
  try {
    "$adb" -s "$serial" logcat -b all -d -v threadtime -t 2000 \
      > "$evidence/art/$candidate.before.logcat" 2> "$evidence/art/$candidate.before-logcat.stderr"
  }
  var before_logcat_status = _error.code
  try {
    timeout 60 "$adb" -s "$serial" shell -T \
      "CLASSPATH=$remote/candidate.dex:$remote/runner.dex app_process -Xcheck:jni /system/bin --nice-name=idric-callback-results-$candidate CallbackResultRunner" \
      > "$evidence/art/$candidate.stdout" 2> "$evidence/art/$candidate.stderr"
  }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/art/$candidate.exit"
  # Capture before testing the process result, including Killed/timeout paths.
  try {
    "$adb" -s "$serial" logcat -b all -d -v threadtime -t 2000 \
      > "$evidence/art/$candidate.after.logcat" 2> "$evidence/art/$candidate.after-logcat.stderr"
  }
  var after_logcat_status = _error.code
  printf 'process_exit\t%s\nbefore_logcat_exit\t%s\nafter_logcat_exit\t%s\n' \
    "$status" "$before_logcat_status" "$after_logcat_status" > "$evidence/art/$candidate.status.tsv"
  if (status === 124) {
    printf 'termination\thost_timeout_60s\n' >> "$evidence/art/$candidate.status.tsv"
  } elif (status >= 128 and status <= 192) {
    printf 'termination\tsignal_style_shell_status\ninferred_signal_number\t%s\n' "$[status - 128]" \
      >> "$evidence/art/$candidate.status.tsv"
  } else {
    printf 'termination\tprocess_exit\n' >> "$evidence/art/$candidate.status.tsv"
  }
  cat "$evidence/art/$candidate.stdout" "$evidence/art/$candidate.stderr" > "$evidence/art/$candidate.txt"
  cat "$evidence/art/$candidate.txt"
  cat "$evidence/art/$candidate.status.tsv"
  try { rg -n -e 'CallbackResultRunner|idric-callback-results|AndroidRuntime|FATAL|Fatal signal|SIG[A-Z]+|lmkd|lowmemorykiller|avc: denied' \
    "$evidence/art/$candidate.after.logcat" > "$evidence/art/$candidate.diagnostics.txt" }
  var diagnostic_status = _error.code
  if (diagnostic_status > 1) { echo 'FAIL callback diagnostic extraction' >&2; exit 1 }
  cat "$evidence/art/$candidate.diagnostics.txt"
  if (before_logcat_status !== 0 or after_logcat_status !== 0) {
    echo 'FAIL missing callback-result logcat evidence' >&2; exit 1
  }
  if (candidate === 'positive') {
    if (status !== 0) { echo 'FAIL actual callback-result ART execution' >&2; exit 1 }
    rg -x -F 'PASS checked callback results and actual Activity receivers' "$evidence/art/$candidate.txt"
  } else {
    if (status !== 91) { echo 'FAIL missing designated callback source mutation rejection' >&2; exit 1 }
    rg -x -F 'FAIL checked callback results and actual Activity receivers' "$evidence/art/$candidate.txt"
  }
}
printf 'Boolean_callback_ART\tPASS\nreference_callback_ART\tPASS\nactual_Activity_receivers\tPASS\ncompiled_Boolean_source_mutant_rejected\tPASS\ncompiled_reference_source_mutant_rejected\tPASS\nprivate_captured_state\tNOT_IMPLEMENTED\nAPK\tNOT_RUN\nphysical_device\tNOT_RUN\n' > "$evidence/art/result.tsv"
printf '\033[32mPASS\033[0m checked Boolean/reference callback results and actual Activity receivers on ART\n'
