module LifecycleExtensionChecks

import Backend.DEX.Callback
import Backend.DEX.IR
import Backend.DEX.Encode
import Backend.DEX.Placement
import Data.List
import Data.Text
import System

%default covering

activity : FrameworkValueType
activity = ReferenceValue (MkTypeReference "Landroid/app/Activity;")

bundle : FrameworkValueType
bundle = ReferenceValue (MkTypeReference "Landroid/os/Bundle;")

intent : FrameworkValueType
intent = ReferenceValue (MkTypeReference "Landroid/content/Intent;")

integer : FrameworkValueType
integer = ExistingValue IntegerValue

handler : List FrameworkValueType → MethodPlan
handler arguments = MkMethodPlan "checked source lifecycle" "receive_lifecycle"
  (cast (length arguments)) arguments VoidValue (max 1 (cast (length arguments))) [ReturnVoid]

plan_for : Text → List FrameworkValueType → Either Text FilePlan
plan_for directive arguments = with_interface_callbacks "LIdric/Generated;" [handler arguments]
  ["extends Landroid/app/Activity;", directive ++ " receive_lifecycle"]

registers : List FrameworkValueType → List Register
registers arguments = map MkRegister [1 .. cast (length arguments)]

exact_forwarding : Text → Text → List FrameworkValueType → Bool → Bool
exact_forwarding directive event arguments before_parent =
  case plan_for directive (activity :: arguments) of
    Left _ ⇒ False
    Right plan ⇒ case filter (\method ⇒ method.method_name ≟ event) plan.methods of
      [bridge] ⇒ bridge.mode ≟ InstanceMethod &&
        bridge.parameter_count ≟ cast (length arguments) &&
        bridge.parameter_types ≟ arguments && bridge.result_type ≟ VoidValue &&
        bridge.register_count ≟ cast (length arguments) + 2 &&
        case bridge.instructions of
          [InvokeMethod first, InvokeMethod second, ReturnVoid] ⇒
            let parent = if before_parent then second else first
                source = if before_parent then first else second
                incoming = registers (activity :: arguments)
            in parent.kind ≟ InvokeSuper &&
               parent.method.owner ≟ MkTypeReference "Landroid/app/Activity;" &&
               parent.method.name ≟ event && parent.method.argument_types ≟ arguments &&
               parent.method.result ≟ VoidValue && parent.arguments ≟ incoming &&
               parent.result_register ≟ Nothing && source.kind ≟ InvokeStatic &&
               source.method.owner ≟ MkTypeReference "LIdric/Generated;" &&
               source.method.name ≟ "receive_lifecycle" &&
               source.method.argument_types ≟ (activity :: arguments) &&
               source.method.result ≟ VoidValue && source.arguments ≟ incoming &&
               source.result_register ≟ Nothing
          _ ⇒ False
      _ ⇒ False

encodes : Text → List FrameworkValueType → Bool
encodes directive arguments = case plan_for directive (activity :: arguments) of
  Left _ ⇒ False
  Right plan ⇒ case finalize_file_plan plan of
    Left _ ⇒ False
    Right finalized ⇒ case encode_finalized_dex finalized of
      Left _ ⇒ False
      Right bytes ⇒ length bytes > 112

refuses : Either Text value → Bool
refuses (Left _) = True
refuses (Right _) = False

create_compatibility : Bool
create_compatibility = case plan_for "override onCreate (Landroid/os/Bundle;)V" [activity] of
  Left _ ⇒ False
  Right plan ⇒ case filter (\method ⇒ method.method_name ≟ "onCreate") plan.methods of
    [bridge] ⇒ case bridge.instructions of
      [InvokeMethod parent, InvokeMethod source, ReturnVoid] ⇒
        parent.kind ≟ InvokeSuper && parent.arguments ≟ [MkRegister 1, MkRegister 2] &&
        source.kind ≟ InvokeStatic && source.arguments ≟ [MkRegister 1]
      _ ⇒ False
    _ ⇒ False

-- The picker exposed a method with a high 22t operand and no other operation
-- requiring staging. Checking only invocations left this valid plan unplaced.
bare_branch : Int → MethodPlan
bare_branch first = MkMethodPlan "branch-only incoming parameters" "branch_only"
  2 [integer, integer] integer (first + 2)
  [ IntegerBranch EqualInteger (MkRegister first) (MkRegister (first + 1)) (MkLabel 0)
  , IntegerConstant (MkRegister 0) 0, ReturnInteger (MkRegister 0)
  , Mark (MkLabel 0), IntegerConstant (MkRegister 0) 1, ReturnInteger (MkRegister 0)
  ]

bare_branch_encodes : Int → Bool
bare_branch_encodes first = case finalize_file_plan (MkFilePlan "LIdric/BareBranch;" [bare_branch first]) of
  Left _ ⇒ False
  Right finalized ⇒ case encode_finalized_dex finalized of
    Left _ ⇒ False
    Right bytes ⇒ length bytes > 112

low_branch_unchanged : Bool
low_branch_unchanged = case prepare_method_invocations (bare_branch 14) of
  Left _ ⇒ False
  Right placed ⇒ placed.register_count ≟ 16 &&
    map show placed.instructions ≟ map show (bare_branch 14).instructions

cases : List (Text, Bool)
cases =
  [ ("pause-parent-first-original-receiver", exact_forwarding "override onPause ()V" "onPause" [] False)
  , ("save-parent-first-original-bundle", exact_forwarding "override onSaveInstanceState (Landroid/os/Bundle;)V" "onSaveInstanceState" [bundle] False)
  , ("picker-parent-first-all-original-arguments", exact_forwarding "override onActivityResult (IILandroid/content/Intent;)V" "onActivityResult" [integer, integer, intent] False)
  , ("destroy-explicit-source-before-real-parent", exact_forwarding "override before-parent onDestroy ()V" "onDestroy" [] True)
  , ("destroy-default-remains-parent-first", exact_forwarding "override onDestroy ()V" "onDestroy" [] False)
  , ("resume-default-remains-parent-first", exact_forwarding "override onResume ()V" "onResume" [] False)
  , ("intent-default-remains-parent-first", exact_forwarding "override onNewIntent (Landroid/content/Intent;)V" "onNewIntent" [intent] False)
  , ("create-full-arguments-remain-parent-first", exact_forwarding "override onCreate (Landroid/os/Bundle;)V" "onCreate" [bundle] False)
  , ("receiver-only-create-compatibility", create_compatibility)
  , ("pause-final-plan-encodes", encodes "override onPause ()V" [])
  , ("save-final-plan-encodes", encodes "override onSaveInstanceState (Landroid/os/Bundle;)V" [bundle])
  , ("picker-final-plan-encodes", encodes "override onActivityResult (IILandroid/content/Intent;)V" [integer, integer, intent])
  , ("before-parent-destroy-final-plan-encodes", encodes "override before-parent onDestroy ()V" [])
  , ("low-22t-plan-keeps-original-placement", low_branch_unchanged)
  , ("bare-22t-nibble-boundary-encodes", bare_branch_encodes 15)
  , ("bare-22t-high-inputs-without-invocations-encode", bare_branch_encodes 255)
  , ("pause-receiver-required", refuses (plan_for "override onPause ()V" []))
  , ("save-original-bundle-required", refuses (plan_for "override onSaveInstanceState (Landroid/os/Bundle;)V" [activity]))
  , ("picker-original-codes-required", refuses (plan_for "override onActivityResult (IILandroid/content/Intent;)V" [activity, intent]))
  , ("picker-exact-intent-required", refuses (plan_for "override onActivityResult (IILandroid/content/Intent;)V" [activity, integer, integer, bundle]))
  , ("picker-exact-int32-codes-required", refuses (plan_for "override onActivityResult (IILandroid/content/Intent;)V" [activity, LongValue, integer, intent]))
  , ("pause-wrong-platform-signature-refused", refuses (plan_for "override onPause (Landroid/os/Bundle;)V" [activity, bundle]))
  , ("save-wrong-platform-signature-refused", refuses (plan_for "override onSaveInstanceState (Landroid/content/Intent;)V" [activity, intent]))
  , ("picker-wrong-platform-result-refused", refuses (plan_for "override onActivityResult (IILandroid/content/Intent;)I" [activity, integer, integer, intent]))
  , ("before-parent-pause-refused", refuses (plan_for "override before-parent onPause ()V" [activity]))
  , ("before-parent-save-refused", refuses (plan_for "override before-parent onSaveInstanceState (Landroid/os/Bundle;)V" [activity, bundle]))
  , ("before-parent-picker-refused", refuses (plan_for "override before-parent onActivityResult (IILandroid/content/Intent;)V" [activity, integer, integer, intent]))
  , ("before-parent-destroy-arguments-refused", refuses (plan_for "override before-parent onDestroy (Landroid/os/Bundle;)V" [activity, bundle]))
  , ("unknown-order-refused", refuses (plan_for "override after-parent onDestroy ()V" [activity]))
  , ("unknown-event-refused", refuses (plan_for "override onStop ()V" [activity]))
  , ("missing-superclass-refused", refuses (with_interface_callbacks "LIdric/Generated;" [handler [activity]]
      ["override onPause ()V receive_lifecycle"]))
  , ("duplicate-event-orders-refused", refuses (with_interface_callbacks "LIdric/Generated;" [handler [activity]]
      ["extends Landroid/app/Activity;", "override onDestroy ()V receive_lifecycle", "override before-parent onDestroy ()V receive_lifecycle"]))
  , ("missing-source-export-refused", refuses (with_interface_callbacks "LIdric/Generated;" []
      ["extends Landroid/app/Activity;", "override onPause ()V absent"]))
  , ("nonstatic-source-export-refused", refuses (with_interface_callbacks "LIdric/Generated;"
      [{ mode := InstanceMethod } (handler [activity])]
      ["extends Landroid/app/Activity;", "override onPause ()V receive_lifecycle"]))
  , ("nonvoid-source-export-refused", refuses (with_interface_callbacks "LIdric/Generated;"
      [{ result_type := ExistingValue BooleanValue } (handler [activity])]
      ["extends Landroid/app/Activity;", "override onPause ()V receive_lifecycle"]))
  ]

main : IO ()
main = do
  traverse_ (\(name, passed) ⇒ putStrLn ((if passed then "PASS " else "FAIL ") ++ name)) cases
  if all snd cases then putStrLn "PASS exact Activity lifecycle extension plans" else exitFailure
