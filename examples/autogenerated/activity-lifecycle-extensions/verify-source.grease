#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 6) { echo 'usage: grease verify-source.grease REPOSITORY FRONTEND_ROOT DRIVER_PROGRAM BACKEND_TTC BAKSMALI FRESH_OUTPUT' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var modules = ARGV[3]
var baksmali = ARGV[4]
var output = ARGV[5]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused lifecycle source evidence' >&2; exit 1 }
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
var source = "$repository/examples/autogenerated/activity-lifecycle-extensions"
var scheme = "$frontend/.tools/bin/scheme"
var compiler = "$frontend/build/exec/idris2_app/idris2.so"
setglobal ENV.IDRIS2_PREFIX = "$frontend/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = modules
setglobal ENV.IDRIS2_INC_SRC = "$frontend/build/exec/idris2_app"
setglobal ENV.LD_LIBRARY_PATH = "$frontend/build/exec/idris2_app"
setglobal ENV.CHEZ = scheme
setglobal ENV.PATH = "$frontend/.tools/bin:" ++ ENV.PATH
mkdir -p "$output"
proc clean_log(log) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" }
  var status = _error.code
  if (status === 0) { echo 'FAIL lifecycle source diagnostic' >&2; exit 1 }
  if (status !== 1) { echo 'FAIL lifecycle diagnostic checker' >&2; exit 1 }
}
proc source_check(directory, module, destination) {
  mkdir -p "$destination"
  "$scheme" --program "$compiler" --check --source-dir "$directory" \
    --build-dir "$destination/check-build" "$directory/$module.idric" \
    > "$destination/typecheck.txt" 2>&1
  clean_log "$destination/typecheck.txt"
}
proc emit(directory, module, destination) {
  mkdir -p "$destination"
  try {
    "$scheme" --program "$driver" --cg dex --source-dir "$directory" \
      --build-dir "$destination/build" --output-dir "$destination" \
      "$directory/$module.idric" -o candidate > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$destination/compiler.exit"
  cat "$destination/compiler.txt"
  if (status !== 0) { return 1 }
  clean_log "$destination/compiler.txt"
  test -s "$destination/candidate.dex"
  java -jar "$baksmali" disassemble "$destination/candidate.dex" -o "$destination/decoded"
}
printf '\033[36mACTION\033[0m qualify exact lifecycle source declarations\n'
for module in PauseLifecycle SaveStateLifecycle PickerLifecycle DestroyBeforeParent {
  source_check "$source" "$module" "$output/$module"
  emit "$source" "$module" "$output/$module"
  emit "$source" "$module" "$output/$module-repeat"
  cmp "$output/$module/candidate.dex" "$output/$module-repeat/candidate.dex"
}
rg -x -F '.method public onPause()V' "$output/PauseLifecycle/decoded/Idric/Generated.smali"
rg -F 'Landroid/app/Activity;->onPause()V' "$output/PauseLifecycle/decoded/Idric/Generated.smali"
rg -x -F '.method public onSaveInstanceState(Landroid/os/Bundle;)V' "$output/SaveStateLifecycle/decoded/Idric/Generated.smali"
rg -F 'Landroid/app/Activity;->onSaveInstanceState(Landroid/os/Bundle;)V' "$output/SaveStateLifecycle/decoded/Idric/Generated.smali"
rg -x -F '.method public onActivityResult(IILandroid/content/Intent;)V' "$output/PickerLifecycle/decoded/Idric/Generated.smali"
rg -F 'Landroid/app/Activity;->onActivityResult(IILandroid/content/Intent;)V' "$output/PickerLifecycle/decoded/Idric/Generated.smali"
proc decoded_before(first, second, file) {
  var first_line = $(rg -n -F "$first" "$file")
  var second_line = $(rg -n -F "$second" "$file")
  test $(printf '%s\n' "$first_line" | cut -d : -f 1) -lt $(printf '%s\n' "$second_line" | cut -d : -f 1)
}
decoded_before 'Landroid/app/Activity;->onPause()V' \
  'LIdric/Generated;->receive_pause(Landroid/app/Activity;)V' "$output/PauseLifecycle/decoded/Idric/Generated.smali"
decoded_before 'Landroid/app/Activity;->onSaveInstanceState(Landroid/os/Bundle;)V' \
  'LIdric/Generated;->receive_save_state(Landroid/app/Activity;Landroid/os/Bundle;)V' "$output/SaveStateLifecycle/decoded/Idric/Generated.smali"
decoded_before 'Landroid/app/Activity;->onActivityResult(IILandroid/content/Intent;)V' \
  'LIdric/Generated;->receive_picker(Landroid/app/Activity;IILandroid/content/Intent;)V' "$output/PickerLifecycle/decoded/Idric/Generated.smali"
# Independent decoded-line order must agree with the explicit source form.
decoded_before 'LIdric/Generated;->receive_destroy(Landroid/app/Activity;)V' \
  'Landroid/app/Activity;->onDestroy()V' "$output/DestroyBeforeParent/decoded/Idric/Generated.smali"

for lane in receiverless-pause missing-bundle dropped-picker-codes wrong-picker-code before-parent-pause wrong-save-signature missing-parent duplicate-destroy {
  var module = 'PauseLifecycle'
  var directory = "$output/$lane-source"
  mkdir -p "$directory" "$output/$lane"
  if (lane === 'receiverless-pause') {
    sed 's/receive_pause : ActivityReference → IO ()/receive_pause : IO ()/; s/receive_pause activity = primIO (set_title activity "Paused")/receive_pause = pure ()/' \
      "$source/PauseLifecycle.idric" > "$directory/$module.idric"
  } elif (lane === 'missing-bundle') {
    setvar module = 'SaveStateLifecycle'
    sed 's/ActivityReference → BundleReference → IO ()/ActivityReference → IO ()/; s/receive_save_state activity bundle = do/receive_save_state activity = do/; /primIO (save_formula bundle/d' \
      "$source/$module.idric" > "$directory/$module.idric"
  } elif (lane === 'dropped-picker-codes') {
    setvar module = 'PickerLifecycle'
    sed 's/ActivityReference → Int32 → Int32 → IntentReference/ActivityReference → IntentReference/; s/receive_picker activity request result intent =/receive_picker activity intent =/; s/request ≟ 1 \&\& result ≟ (-1) \&\& //' \
      "$source/$module.idric" > "$directory/$module.idric"
  } elif (lane === 'wrong-picker-code') {
    setvar module = 'PickerLifecycle'
    sed 's/ActivityReference → Int32 → Int32/ActivityReference → Int64 → Int32/' \
      "$source/$module.idric" > "$directory/$module.idric"
  } elif (lane === 'before-parent-pause') {
    sed 's/override onPause/override before-parent onPause/' "$source/PauseLifecycle.idric" > "$directory/$module.idric"
  } elif (lane === 'wrong-save-signature') {
    setvar module = 'SaveStateLifecycle'
    sed 's/override onSaveInstanceState (Landroid\/os\/Bundle;)V/override onSaveInstanceState (Landroid\/content\/Intent;)V/' \
      "$source/$module.idric" > "$directory/$module.idric"
  } elif (lane === 'missing-parent') {
    sed '/%cg dex extends Landroid\/app\/Activity;/d' "$source/PauseLifecycle.idric" > "$directory/$module.idric"
  } else {
    setvar module = 'DestroyBeforeParent'
    cp "$source/$module.idric" "$directory/$module.idric"
    printf '\n%%cg dex override onDestroy ()V receive_destroy\n' >> "$directory/$module.idric"
  }
  if cmp -s "$source/$module.idric" "$directory/$module.idric" { echo 'FAIL unchanged lifecycle refusal source' >&2; exit 1 }
  source_check "$directory" "$module" "$output/$lane"
  cp "$output/$module/candidate.dex" "$output/$lane/candidate.dex"
  try { emit "$directory" "$module" "$output/$lane" }
  var status = _error.code
  if (status !== 1) { echo 'FAIL missing designated lifecycle source refusal' >&2; exit 1 }
  test $(cat "$output/$lane/compiler.exit") = 1
  test ! -e "$output/$lane/candidate.dex"
  if (lane === 'before-parent-pause') {
    rg -F 'DEX before-parent lifecycle admits onDestroy() only' "$output/$lane/compiler.txt"
  } elif (lane === 'wrong-save-signature') {
    rg -F 'DEX checked lifecycle admits' "$output/$lane/compiler.txt"
  } elif (lane === 'missing-parent') {
    rg -F 'DEX lifecycle override requires its Activity superclass' "$output/$lane/compiler.txt"
  } elif (lane === 'duplicate-destroy') {
    rg -F 'DEX class has repeated lifecycle overrides' "$output/$lane/compiler.txt"
  } else {
    rg -F 'DEX lifecycle signature must include its checked Activity receiver' "$output/$lane/compiler.txt"
  }
}
mkdir -p "$output/destroy-mutant-source"
sed 's/activity "Destroyed"/activity "Wrong"/' "$source/DestroyBeforeParent.idric" > "$output/destroy-mutant-source/DestroyBeforeParent.idric"
if cmp -s "$source/DestroyBeforeParent.idric" "$output/destroy-mutant-source/DestroyBeforeParent.idric" { echo 'FAIL unchanged destroy behavior mutation' >&2; exit 1 }
emit "$output/destroy-mutant-source" DestroyBeforeParent "$output/destroy-mutant"
if cmp -s "$output/DestroyBeforeParent/candidate.dex" "$output/destroy-mutant/candidate.dex" { echo 'FAIL unchanged destroy mutation DEX' >&2; exit 1 }
sha256sum "$repository/dex/idric/src/Backend/DEX/Callback.idr" "$driver" "$compiler" \
  "$output/PauseLifecycle/candidate.dex" "$output/SaveStateLifecycle/candidate.dex" \
  "$output/PickerLifecycle/candidate.dex" "$output/DestroyBeforeParent/candidate.dex" \
  "$output/destroy-mutant/candidate.dex" > "$output/inputs-candidates.sha256"
printf 'checked_source\tPASS\nindependent_decode\tPASS\ndeterministic_repeat\tPASS\nsource_refusals\tPASS\nstale_DEX_after_refusal\tABSENT\ndestroy_source_mutant\tBUILT\nframework_lifecycle\tPENDING\nphysical_device\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m exact lifecycle source generation, forwarding decode and refusals; framework execution pending\n'
