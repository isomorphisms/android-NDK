#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) { echo 'usage: grease verify-plans.grease REPOSITORY FRONTEND_ROOT BACKEND_TTC FRESH_OUTPUT' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var modules = ARGV[2]
var output = ARGV[3]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused lifecycle plan evidence' >&2; exit 1 }
var scheme = "$frontend/.tools/bin/scheme"
var compiler = "$frontend/build/exec/idris2_app/idris2.so"
var source = "$repository/examples/autogenerated/activity-lifecycle-extensions"
setglobal ENV.IDRIS2_PREFIX = "$frontend/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = modules
setglobal ENV.IDRIS2_DATA = "$frontend/bootstrap-build/idris2-0.8.0/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/bootstrap-build/idris2-0.8.0/support/c"
setglobal ENV.IDRIS2_INC_SRC = "$frontend/build/exec/idris2_app"
setglobal ENV.LD_LIBRARY_PATH = "$frontend/build/exec/idris2_app"
setglobal ENV.CHEZ = scheme
setglobal ENV.PATH = "$frontend/.tools/bin:" ++ ENV.PATH
mkdir -p "$output"
proc clean_log(log) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" }
  var status = _error.code
  if (status === 0) { echo 'FAIL lifecycle source diagnostic' >&2; exit 1 }
  if (status !== 1) { echo 'FAIL lifecycle diagnostic checker' >&2; exit 1 }
}
printf '\033[36mACTION\033[0m check the actual Callback source without a driver build\n'
"$scheme" --program "$compiler" -p idris2 --check \
  --source-dir "$repository/dex/idric/src" --build-dir "$output/backend" \
  "$repository/dex/idric/src/Backend/DEX/Callback.idr" > "$output/backend.txt" 2>&1
clean_log "$output/backend.txt"
# A single module directory prevents duplicate-path priority from selecting an
# old Callback while the qualifier appears to test the changed source.
cp -a "$modules" "$output/module-overlay"
cp -a "$output/backend/ttc/." "$output/module-overlay/"
cmp "$output/backend/ttc/2025081600/Backend/DEX/Callback.ttc" \
  "$output/module-overlay/2025081600/Backend/DEX/Callback.ttc"
setglobal ENV.IDRIS2_PATH = "$output/module-overlay"
for lane in extension compatibility {
  var directory = source
  var module = 'LifecycleExtensionChecks'
  var marker = 'PASS exact Activity lifecycle extension plans'
  if (lane === 'compatibility') {
    setvar directory = "$repository/examples/autogenerated/activity-lifecycle"
    setvar module = 'LifecyclePlanChecks'
    setvar marker = 'PASS checked zero-argument lifecycle plans'
  }
  mkdir -p "$output/$lane"
  "$scheme" --program "$compiler" -p idris2 --source-dir "$directory" \
    --build-dir "$output/$lane/build" --output-dir "$output/$lane" \
    "$directory/$module.idric" -o plan-check > "$output/$lane/compiler.txt" 2>&1
  clean_log "$output/$lane/compiler.txt"
  "$scheme" --program "$output/$lane/plan-check_app/plan-check.so" > "$output/$lane/result.txt" 2>&1
  cat "$output/$lane/result.txt"
  rg -x -F "$marker" "$output/$lane/result.txt"
}
sha256sum "$repository/dex/idric/src/Backend/DEX/Callback.idr" \
  "$source/LifecycleExtensionChecks.idric" "$output/module-overlay/2025081600/Backend/DEX/Callback.ttc" \
  "$compiler" > "$output/inputs.sha256"
printf 'Callback_source_check\tPASS\nexact_forwarding_and_order\tPASS\nencoder\tPASS\nbounded_plan_refusals\tPASS\nexisting_lifecycle_compatibility\tPASS\ndriver_build\tNOT_RUN\nsource_DEX\tPENDING\nframework_lifecycle\tPENDING\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m exact lifecycle plans and existing compatibility; source DEX pending\n'
