#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 7) {
  echo 'usage: grease verify.grease REPOSITORY FRONTEND DRIVER BACKEND_TTC BAKSMALI SMALI FRESH_OUTPUT' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var modules = ARGV[3]
var baksmali = ARGV[4]
var smali = ARGV[5]
var output = ARGV[6]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused reference-null evidence' >&2; exit 1 }
test $(git -C "$frontend" rev-parse HEAD) = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
var source = "$repository/examples/autogenerated/reference-null"
var compiler = "$frontend/_/build/exec/idris2"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = modules
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
mkdir -p "$output"
printf 'backend\t%s\nfrontend\t%s\n' $(git -C "$repository" rev-parse HEAD) \
  $(git -C "$frontend" rev-parse HEAD) > "$output/inputs.tsv"
git -C "$repository" diff --binary HEAD > "$output/local.patch"
sha256sum "$repository/dex/idric/src/Backend/DEX/ReferenceNull.idr" \
  "$repository/dex/idric/src/Backend/DEX/Foreign.idr" \
  "$repository/dex/idric/src/Backend/DEX/IR.idr" \
  "$repository/dex/idric/src/Backend/DEX/Placement.idr" \
  "$repository/dex/idric/src/Backend/DEX/Encode.idr" \
  "$repository/dex/idric/src/Backend/DEX/Lower.idr" \
  "$repository/dex/idric/src/Backend/DEX/ManagedBoundary.idr" \
  "$source/ReferenceNullSource.idric" "$source/ReferenceNullPlanCheck.idric" \
  "$source/ReferenceNullRunner.smali" "$driver" \
  "$repository/dex/idric/build/exec/idric-dex_app/idric-dex.so" > "$output/source-artifacts.sha256"

proc clean_log(log) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" }
  var status = _error.code
  if (status === 0) { echo 'FAIL reference-null source diagnostic' >&2; exit 1 }
  if (status !== 1) { echo 'FAIL reference-null diagnostic checker' >&2; exit 1 }
}
mkdir -p "$output/plans"
try {
  "$compiler" -p idris2 --source-dir "$source" --build-dir "$output/plans/build" \
    --output-dir "$output/plans" "$source/ReferenceNullPlanCheck.idric" -o host \
    > "$output/plans/compiler.txt" 2>&1
}
var host_compile_status = _error.code
printf '%s\n' "$host_compile_status" > "$output/plans/compiler.exit"
cat "$output/plans/compiler.txt"
test "$host_compile_status" = 0
clean_log "$output/plans/compiler.txt"
cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$output/plans/host_app/"
try { "$output/plans/host" > "$output/plans/result.txt" 2>&1 }
var host_status = _error.code
printf '%s\n' "$host_status" > "$output/plans/host.exit"
cat "$output/plans/result.txt"
test "$host_status" = 0
rg -x -F 'PASS reference-null parser encoder placement and widening checks' "$output/plans/result.txt"

proc emit(directory, module, destination, mode) {
  mkdir -p "$destination"
  try {
    if (mode === 'managed') {
      "$driver" --cg dex --directive managed-exports --source-dir "$directory" \
        --build-dir "$destination/build" --output-dir "$destination" \
        "$directory/$module.idric" -o candidate > "$destination/compiler.txt" 2>&1
    } else {
      "$driver" --cg dex --source-dir "$directory" \
        --build-dir "$destination/build" --output-dir "$destination" \
        "$directory/$module.idric" -o candidate > "$destination/compiler.txt" 2>&1
    }
  }
  var status = _error.code
  printf '%s\n' "$status" > "$destination/compiler.exit"
  cat "$destination/compiler.txt"
  if (status !== 0) { return 1 }
  clean_log "$destination/compiler.txt"
  test -s "$destination/candidate.dex"
  java -jar "$baksmali" disassemble "$destination/candidate.dex" -o "$destination/decoded"
}
mkdir -p "$output/mutant-source"
sed 's/object_null = reference_is_null/object_null value = 1 - reference_is_null value/' \
  "$source/ReferenceNullSource.idric" > "$output/mutant-source/ReferenceNullSource.idric"
if cmp -s "$source/ReferenceNullSource.idric" "$output/mutant-source/ReferenceNullSource.idric" {
  echo 'FAIL unchanged reference-null source mutation' >&2; exit 1
}
for mode in direct managed {
  emit "$source" ReferenceNullSource "$output/$mode" "$mode"
  emit "$source" ReferenceNullSource "$output/$mode-repeat" "$mode"
  cmp "$output/$mode/candidate.dex" "$output/$mode-repeat/candidate.dex"
  var decoded = "$output/$mode/decoded/Idric/Generated.smali"
  rg -F 'object_null(Ljava/lang/Object;)I' "$decoded"
  rg -F 'key_event_null(Landroid/view/KeyEvent;)I' "$decoded"
  rg -F 'intent_null(Landroid/content/Intent;)I' "$decoded"
  rg -F 'uri_null(Landroid/net/Uri;)I' "$decoded"
  rg -F 'stream_null(Ljava/io/OutputStream;)I' "$decoded"
  rg -e 'if-eqz v[0-9]+, :cond_' "$decoded"
  # Managed entry validation already uses API19 requireNonNull. Only the
  # API24 null predicates would violate this intrinsic's API23 contract.
  try { rg -e 'Ljava/util/Objects;->(isNull|nonNull)\(' "$decoded" }
  var forbidden_status = _error.code
  if (forbidden_status !== 1) { echo 'FAIL API24 Objects predicate or checker error' >&2; exit 1 }
  emit "$output/mutant-source" ReferenceNullSource "$output/$mode-mutant" "$mode"
  if cmp -s "$output/$mode/candidate.dex" "$output/$mode-mutant/candidate.dex" {
    echo 'FAIL unchanged reference-null source mutant bytes' >&2; exit 1
  }
}
for module in OrdinaryReferenceRefusal ConflictingReferenceRefusal WrongSignatureRefusal EffectfulReferenceRefusal {
  try { emit "$source" "$module" "$output/refusal-$module" direct }
  var status = _error.code
  if (status === 0) { echo 'FAIL expected reference-null source refusal' >&2; exit 1 }
  test $(cat "$output/refusal-$module/compiler.exit") = 1
  test ! -e "$output/refusal-$module/candidate.dex"
  if (module === 'OrdinaryReferenceRefusal') {
    rg -F 'is ordinary algebraic data, not an external reference' "$output/refusal-$module/compiler.txt"
  } elif (module === 'ConflictingReferenceRefusal') {
    rg -F 'has conflicting descriptors' "$output/refusal-$module/compiler.txt"
  } else {
    rg -F 'DEX reference-is-null requires exactly one external Object domain and a pure Int32 result' \
      "$output/refusal-$module/compiler.txt"
  }
}
java -jar "$smali" assemble "$source/ReferenceNullRunner.smali" -o "$output/runner.dex"
java -jar "$baksmali" disassemble "$output/runner.dex" -o "$output/runner-decoded"
sha256sum "$output/direct/candidate.dex" "$output/managed/candidate.dex" \
  "$output/direct-mutant/candidate.dex" "$output/managed-mutant/candidate.dex" \
  "$output/runner.dex" > "$output/candidates.sha256"
printf 'checked_source\tPASS\nshared_typed_reference_branch\tPASS\nindependent_decode\tPASS\ndeterministic_repeat\tPASS\nsource_mutants\tBUILT\nsource_refusals\tPASS\nART_API23\tPENDING\nART_other_API\tPENDING\nwhole_Activity\tNOT_RUN\nphysical_device\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m checked reference-null source, branches, repeats and refusals; ART pending\n'
