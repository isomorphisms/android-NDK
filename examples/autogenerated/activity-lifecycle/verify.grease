#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) { echo 'requires BACKEND FRONTEND BAKSMALI NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var baksmali = ARGV[2]
var evidence = ARGV[3]
for path in "$repository" "$frontend" "$baksmali" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused Activity lifecycle evidence' >&2; exit 2 }
mkdir -p "$evidence/mutant-source"
var source = "$repository/examples/autogenerated/activity-lifecycle"
var driver = "$repository/dex/idric/build/exec/idric-dex"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$repository/dex/idric/build/ttc"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.LD_LIBRARY_PATH = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
var frontend_compiler = "$frontend/_/build/exec/idris2"
"$frontend_compiler" -p idris2 --source-dir "$source" --build-dir "$evidence/host-build" \
  "$source/LifecyclePlanChecks.idric" -o lifecycle-checks > "$evidence/host-compile.txt" 2>&1
if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/host-compile.txt" { exit 1 }
"$evidence/host-build/exec/lifecycle-checks" > "$evidence/host.txt" 2>&1
cat "$evidence/host.txt"
rg -x -F 'PASS checked zero-argument lifecycle plans' "$evidence/host.txt"
proc compile(lane, directory) {
  mkdir -p "$evidence/$lane"
  "$driver" --cg dex --source-dir "$directory" \
    --build-dir "$evidence/$lane/build" --output-dir "$evidence/$lane" \
    "$directory/LifecycleActivity.idric" -o candidate > "$evidence/$lane/compiler.txt" 2>&1
  if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/$lane/compiler.txt" { return 1 }
  test -s "$evidence/$lane/candidate.dex"
  java -jar "$baksmali" disassemble "$evidence/$lane/candidate.dex" -o "$evidence/$lane/decoded"
}
compile positive "$source"
compile repeat "$source"
cmp "$evidence/positive/candidate.dex" "$evidence/repeat/candidate.dex"
for event in onResume onDestroy {
  rg -F ".method public $event()V" "$evidence/positive/decoded/Idric/Generated.smali"
  rg -F "Landroid/app/Activity;->$event()V" "$evidence/positive/decoded/Idric/Generated.smali"
}
for lane in resume-mutant destroy-mutant {
  mkdir "$evidence/$lane-source"
  if (lane === 'resume-mutant') {
    sed 's/activity "Resumed"/activity "Wrong"/' "$source/LifecycleActivity.idric" > "$evidence/$lane-source/LifecycleActivity.idric"
  } else {
    sed 's/activity "Destroyed"/activity "Wrong"/' "$source/LifecycleActivity.idric" > "$evidence/$lane-source/LifecycleActivity.idric"
  }
  if cmp -s "$source/LifecycleActivity.idric" "$evidence/$lane-source/LifecycleActivity.idric" { exit 1 }
  compile "$lane" "$evidence/$lane-source"
  if cmp -s "$evidence/positive/candidate.dex" "$evidence/$lane/candidate.dex" { exit 1 }
}
for lane in receiverless wrong-signature unknown-lifecycle {
  mkdir "$evidence/$lane-source" "$evidence/$lane"
  if (lane === 'receiverless') {
    sed -e 's/resume_lifecycle_reader : ActivityReference → IO ()/resume_lifecycle_reader : IO ()/' \
      -e 's/resume_lifecycle_reader activity = primIO (set_lifecycle_title activity "Resumed")/resume_lifecycle_reader = pure ()/' \
      "$source/LifecycleActivity.idric" > "$evidence/$lane-source/LifecycleActivity.idric"
  } elif (lane === 'wrong-signature') {
    sed 's/override onResume ()V/override onResume (Landroid\/os\/Bundle;)V/' \
      "$source/LifecycleActivity.idric" > "$evidence/$lane-source/LifecycleActivity.idric"
  } else {
    sed 's/override onResume ()V/override onStop ()V/' \
      "$source/LifecycleActivity.idric" > "$evidence/$lane-source/LifecycleActivity.idric"
  }
  "$driver" --source-dir "$evidence/$lane-source" --build-dir "$evidence/$lane-check" \
    --check "$evidence/$lane-source/LifecycleActivity.idric" > "$evidence/$lane-typecheck.txt" 2>&1
  cp "$evidence/positive/candidate.dex" "$evidence/$lane/candidate.dex"
  try { compile "$lane" "$evidence/$lane-source" }
  var status = _error.code
  if (status !== 1) { echo "FAIL $lane escaped its designated compiler refusal" >&2; exit 1 }
  test ! -e "$evidence/$lane/candidate.dex"
  if (lane === 'receiverless') {
    rg -F 'DEX lifecycle signature must include its checked Activity receiver' "$evidence/$lane/compiler.txt"
  } else {
    rg -F 'DEX checked lifecycle admits' "$evidence/$lane/compiler.txt"
  }
}
git -C "$repository" rev-parse HEAD > "$evidence/backend-commit.txt"
git -C "$frontend" rev-parse HEAD > "$evidence/frontend-commit.txt"
sha256sum "$repository/dex/idric/src/Backend/DEX/Callback.idr" "$driver" "${driver}_app/idric-dex.so" \
  "$source/LifecycleActivity.idric" "$source/LifecyclePlanChecks.idric" \
  "$evidence/positive/candidate.dex" "$evidence/resume-mutant/candidate.dex" "$evidence/destroy-mutant/candidate.dex" > "$evidence/sha256.txt"
printf 'source_checked\tPASS\nindependent_decode\tPASS\ndeterminism\tPASS\nbounded_lifecycle_refusals\tPASS\nstale_DEX_after_refusal\tABSENT\nART\tNOT_RUN\nphysical_TAB_P10\tNOT_RUN\n' > "$evidence/receipt.tsv"
