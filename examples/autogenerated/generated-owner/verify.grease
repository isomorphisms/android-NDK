#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 7) {
  echo 'usage: grease verify.grease REPOSITORY FRONTEND DRIVER_LAUNCHER BACKEND_TTC BAKSMALI SMALI FRESH_OUTPUT' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var driver_app = driver ++ '_app'
var modules = ARGV[3]
var baksmali = ARGV[4]
var smali = ARGV[5]
var output = ARGV[6]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute generated-owner paths required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused generated-owner output' >&2; exit 1 }
test $(git -C "$frontend" rev-parse HEAD) = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
var source = "$repository/examples/autogenerated/generated-owner"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = modules
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.SCHEMEHEAPDIRS = "$frontend/_/.tools/chez-10.4.1/lib/csv10.4.1/ta6le"
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
mkdir -p "$output"
git -C "$repository" rev-parse HEAD > "$output/repository-head.txt"
git -C "$repository" diff --binary HEAD > "$output/local.patch"
sha256sum "$repository/dex/idric/src/Backend/DEX/GeneratedOwner.idr" \
  "$repository/dex/idric/src/Backend/DEX/Codegen.idr" \
  "$source/GeneratedOwnerSource.idric" "$source/owner-jni.tsv" \
  "$driver" "$driver_app/idric-dex.so" > "$output/inputs.sha256"

proc emit(name, owner) {
  var destination = "$output/$name"
  mkdir -p "$destination"
  var selection = []
  if (owner !== '') { setvar selection = ['--directive', 'generated-owner=' ++ owner] }
  try {
    "$driver" --cg dex --directive managed-exports @selection \
      --directive "jni-map=$source/owner-jni.tsv" --source-dir "$source" \
      --build-dir "$destination/build" --output-dir "$destination" \
      "$source/GeneratedOwnerSource.idric" -o candidate > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$destination/compiler.exit"
  cat "$destination/compiler.txt"
  if (status !== 0) { return 1 }
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$destination/compiler.txt" }
  if (_error.code !== 1) { echo 'FAIL generated-owner source diagnostic or checker' >&2; exit 1 }
  test -s "$destination/candidate.dex"
  java -jar "$baksmali" disassemble "$destination/candidate.dex" -o "$destination/decoded"
}
printf '\033[36mACTION\033[0m compile actual Activity field/native/captured-action source with selected owner\n'
emit default ''
emit selected 'Lorg/algebraicvarietyexplorer/AVEActivity;'
emit repeated 'Lorg/algebraicvarietyexplorer/AVEActivity;'
cmp "$output/selected/candidate.dex" "$output/repeated/candidate.dex"
var generated = "$output/selected/decoded/org/algebraicvarietyexplorer/AVEActivity.smali"
var captured = "$output/selected/decoded/org/algebraicvarietyexplorer/AVEActivity\$CapturedRunnable.smali"
test -s "$captured"
rg -x -F '.super Landroid/app/Activity;' "$generated"
rg -x -F '.field private state:Ljava/util/ArrayList;' "$generated"
rg -x -F '.method public static native identity(I)I' "$generated"
rg -F 'Lorg/algebraicvarietyexplorer/AVEActivity;->state:Ljava/util/ArrayList;' "$generated"
rg -F 'Lorg/algebraicvarietyexplorer/AVEActivity;->__idricApply' "$captured"
rg -F 'Lorg/algebraicvarietyexplorer/AVEActivity$CapturedRunnable;' "$generated"
rg -F '.catch Ljava/lang/Throwable;' "$generated"
rg -F 'const-string' "$generated" | rg -F '"LIdric/Generated;"'
try { rg -n 'LIdric/Generated[^" ]*;->|new-instance .*LIdric/Generated|check-cast .*LIdric/Generated|[[:space:]]LIdric/Generated[^" ]*;$' "$output/selected/decoded" }
if (_error.code !== 1) { echo 'FAIL selected owner left a typed legacy self-reference or checker failed' >&2; exit 1 }
test -s "$output/default/decoded/Idric/Generated.smali"
test -s "$output/default/decoded/Idric/Generated\$CapturedRunnable.smali"
java -jar "$smali" assemble "$output/selected/decoded" -o "$output/selected/roundtrip.dex"

for invalid in 'Idric.Generated' 'LIdric/Generated;' 'LGenerated;' 'Lorg//Activity;' \
  'Lorg/1Activity;' 'Landroid/app/Activity;' '[Lorg/example/Activity;' \
  'Lorg/example/Activity;trailing' 'Lorg/example/Activity;' 'Lorg/example/Conflicting;' {
  var destination = "$output/refusal-" ++ $(printf '%s' "$invalid" | od -An -tx1 | tr -d ' \n')
  mkdir -p "$destination"
  cp "$output/selected/candidate.dex" "$destination/candidate.dex"
  try {
    if (invalid === 'Lorg/example/Activity;' or invalid === 'Lorg/example/Conflicting;') {
      "$driver" --cg dex --directive managed-exports \
        --directive 'generated-owner=Lorg/example/Activity;' --directive "generated-owner=$invalid" \
        --directive "jni-map=$source/owner-jni.tsv" --source-dir "$source" \
        --build-dir "$destination/build" --output-dir "$destination" \
        "$source/GeneratedOwnerSource.idric" -o candidate > "$destination/compiler.txt" 2>&1
    } else {
      "$driver" --cg dex --directive managed-exports --directive "generated-owner=$invalid" \
        --directive "jni-map=$source/owner-jni.tsv" --source-dir "$source" \
        --build-dir "$destination/build" --output-dir "$destination" \
        "$source/GeneratedOwnerSource.idric" -o candidate > "$destination/compiler.txt" 2>&1
    }
  }
  var status = _error.code
  test "$status" = 1
  test ! -e "$destination/candidate.dex"
  rg -F 'dex rejected generated owner:' "$destination/compiler.txt"
}
sha256sum "$output/default/candidate.dex" "$output/selected/candidate.dex" \
  "$output/repeated/candidate.dex" "$output/selected/roundtrip.dex" > "$output/artifacts.sha256"
printf 'actual_source_to_DEX\tPASS\nselected_owner_primary_and_companion\tPASS\nmanaged_field_native_catch_self_calls\tPASS\nunchanged_literal_data\tPASS\nindependent_decode_and_reassembly\tPASS\nrepeated_bytes\tPASS\ninvalid_duplicate_owner_refusals\tPASS\nART_APK_installation\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m checked generated owner source and binary structure; installed application separate\n'
