#!/usr/bin/env grease
if (len(ARGV) !== 7) { echo 'usage: grease prepare-native.grease REPOSITORY FRONTEND DRIVER BAKSMALI QUALIFIED_CC NDK EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var baksmali = ARGV[3]
var compiler = ARGV[4]
var ndk = ARGV[5]
var evidence = ARGV[6]
var source = "$repository/examples/autogenerated/jni-contracts"
var toolchain = "$ndk/toolchains/llvm/prebuilt/linux-x86_64"
if test -e "$evidence" { echo 'FAIL native evidence already exists' >&2; exit 1 }
mkdir -p "$evidence"
test -x "$compiler"
test -x "$toolchain/bin/ld.lld"
test -s "$toolchain/sysroot/usr/include/jni.h"
"$compiler" --version > "$evidence/native-compiler-version.txt"
# NDK supplies target headers, bionic's link stub and linker; the qualified ICK
# driver compiles C. libc is used only for an independent native-entry marker.
"$compiler" --target=x86_64-linux-android29 --sysroot="$toolchain/sysroot" \
  -fPIC -ffreestanding -fno-stack-protector -shared -nostdlib \
  -fuse-ld="$toolchain/bin/ld.lld" -Wl,--no-undefined -Wl,-soname,libcontract.so \
  "$source/native_contract_fixture.c" "-L$toolchain/sysroot/usr/lib/x86_64-linux-android/29" \
  -lc -o "$evidence/libcontract.so" > "$evidence/native-build.txt" 2>&1
"$toolchain/bin/llvm-readelf" -h "$evidence/libcontract.so" > "$evidence/native-elf-header.txt"
rg -F 'Advanced Micro Devices X86-64' "$evidence/native-elf-header.txt"
grease "$source/prepare.grease" "$repository" "$frontend" "$driver" "$baksmali" "$evidence/checked"
cp "$evidence/checked/native-contract.dex" "$evidence/native-contract.dex"
sha256sum "$source/native_contract_fixture.c" "$source/NativeIdentity.idric" "$source/explicit-jni.tsv" "$source/legacy-jni.tsv" "$evidence/native-contract.dex" "$evidence/libcontract.so" > "$evidence/artifacts.sha256"
git -C "$repository" rev-parse HEAD > "$evidence/source-revision.txt"
printf 'qualified_native_C_cross_build\tPASS\nchecked_explicit_contract_emission\tPASS\nlegacy_contract_behavior_preserved\tPASS\nindependent_decode\tPASS\nART\tNOT_RUN\nphysical_A1\tNOT_RUN\nphysical_C67\tNOT_RUN\n' > "$evidence/host-receipt.tsv"
printf '\033[32mPASS\033[0m checked JNI fixture and qualified native C boundary emission\n'
