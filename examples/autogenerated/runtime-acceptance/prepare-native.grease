#!/usr/bin/env grease
if (len(ARGV) !== 8) { echo 'usage: grease prepare-native.grease REPOSITORY FRONTEND DRIVER BAKSMALI SMALI QUALIFIED_CC NDK EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var baksmali = ARGV[3]
var smali = ARGV[4]
var compiler = ARGV[5]
var ndk = ARGV[6]
var evidence = ARGV[7]
var source = "$repository/examples/autogenerated/jni-contracts"
var toolchain = "$ndk/toolchains/llvm/prebuilt/linux-x86_64"
if test -e "$evidence" { echo 'FAIL native evidence already exists' >&2; exit 1 }
mkdir -p "$evidence"
test -x "$compiler"
test -x "$toolchain/bin/ld.lld"
test -x "$toolchain/bin/llvm-readelf"
test -s "$toolchain/sysroot/usr/include/jni.h"
test -s "$toolchain/sysroot/usr/lib/x86_64-linux-android/29/libc.so"
"$compiler" --version > "$evidence/native-compiler-version.txt"
"$compiler" -dumpmachine > "$evidence/native-compiler-target.txt"
rg -x 'x86_64[^[:space:]]*-linux[^[:space:]]*' "$evidence/native-compiler-target.txt"
"$toolchain/bin/ld.lld" --version > "$evidence/native-linker-version.txt"
printf '%s\n' "$compiler" > "$evidence/native-compiler-path.txt"
sha256sum "$compiler" "$toolchain/bin/ld.lld" "$toolchain/bin/llvm-readelf" "$ndk/source.properties" > "$evidence/native-tools.sha256"
# The pinned ick-host provider exports a native x86_64 GCC driver, not a
# Clang --target driver. Use its verified x86_64 C code generation only. This
# JNI fixture uses the shared fixed-width x86_64 C ABI, Android headers and
# an explicit bionic link; this is not general Android ICK qualification.
"$compiler" -m64 --sysroot="$toolchain/sysroot" \
  -isystem "$toolchain/sysroot/usr/include/x86_64-linux-android" \
  -D__ANDROID__ -D__ANDROID_API__=29 -fPIC -ffreestanding -fno-stack-protector \
  -c "$source/native_contract_fixture.c" -o "$evidence/native_contract_fixture.o" > "$evidence/native-build.txt" 2>&1
"$toolchain/bin/ld.lld" -shared --no-undefined -soname libcontract.so \
  "$evidence/native_contract_fixture.o" -L "$toolchain/sysroot/usr/lib/x86_64-linux-android/29" \
  -lc -o "$evidence/libcontract.so" > "$evidence/native-link.txt" 2>&1
"$toolchain/bin/llvm-readelf" -h "$evidence/libcontract.so" > "$evidence/native-elf-header.txt"
rg -F 'Advanced Micro Devices X86-64' "$evidence/native-elf-header.txt"
rg 'Class:.*ELF64' "$evidence/native-elf-header.txt"
"$toolchain/bin/llvm-readelf" --dynamic --version-info "$evidence/libcontract.so" > "$evidence/native-dynamic.txt"
rg 'NEEDED' "$evidence/native-dynamic.txt" > "$evidence/native-needed.txt"
rg -F '[libc.so]' "$evidence/native-needed.txt"
if rg -v -F '[libc.so]' "$evidence/native-needed.txt" { echo 'FAIL native fixture depends on an unexpected library' >&2; exit 1 }
if rg 'GLIBC_[0-9]|GLIBC_PRIVATE' "$evidence/native-dynamic.txt" { echo 'FAIL host glibc dependency leaked into Android fixture' >&2; exit 1 }
printf 'profile\tfixed_width_x86_64_JNI_fixture\nC_codegen\tqualified_native_ICK_GCC\nheaders_linker_libc\tNDK_27.2_API29\ngeneral_Android_ICK_qualification\tNOT_ESTABLISHED\n' > "$evidence/native-profile.tsv"
grease "$source/prepare.grease" "$repository" "$frontend" "$driver" "$baksmali" "$evidence/checked"
cp "$evidence/checked/native-contract.dex" "$evidence/native-contract.dex"
cp "$evidence/checked/legacy/native-contract.dex" "$evidence/legacy-contract.dex"
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
java -jar "$smali" assemble "$source/IntegerBoundaryObserver.smali" -o "$evidence/integer-observer.dex"
java -jar "$baksmali" disassemble "$evidence/integer-observer.dex" -o "$evidence/integer-observer-decoded"
test -s "$evidence/integer-observer.dex"
rg -F '.method public static __idricIntExact(' "$evidence/checked/decoded/Idric/Generated.smali"
rg -F '.method public static __idricLongExact(' "$evidence/checked/decoded/Idric/Generated.smali"
sha256sum "$source/native_contract_fixture.c" "$source/NativeIdentity.idric" "$source/explicit-jni.tsv" "$source/legacy-jni.tsv" "$source/IntegerBoundaryObserver.smali" "$evidence/integer-observer.dex" "$evidence/native_contract_fixture.o" "$evidence/native-contract.dex" "$evidence/libcontract.so" > "$evidence/artifacts.sha256"
git -C "$repository" rev-parse HEAD > "$evidence/source-revision.txt"
printf 'qualified_native_C_fixture_object\tPASS\nAndroid_bionic_fixture_link\tPASS\nELF_dependency_inspection\tPASS\nchecked_explicit_contract_emission\tPASS\nlegacy_contract_behavior_preserved\tPASS\nindependent_decode\tPASS\nART\tNOT_RUN\ngeneral_Android_ICK_qualification\tNOT_ESTABLISHED\nphysical_A1\tNOT_RUN\nphysical_C67\tNOT_RUN\n' > "$evidence/host-receipt.tsv"
printf '\033[32mPASS\033[0m checked JNI fixture and qualified native C boundary emission\n'
