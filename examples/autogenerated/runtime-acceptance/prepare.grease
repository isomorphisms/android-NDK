#!/usr/bin/env grease
if (len(ARGV) !== 4) { echo 'usage: grease prepare.grease REPOSITORY DRIVER BAKSMALI EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var driver = ARGV[1]
var baksmali = ARGV[2]
var evidence = ARGV[3]
var source = "$repository/examples/autogenerated/runtime-acceptance"
if test -e "$evidence" { echo 'FAIL evidence already exists' >&2; exit 1 }
mkdir -p "$evidence"
proc compile(source_directory, source_file, output_name, output_directory) {
  mkdir -p "$output_directory"
  "$driver" --cg dex --source-dir "$source_directory" \
    --build-dir "$output_directory/build" --output-dir "$output_directory" \
    "$source_file" -o "$output_name" > "$output_directory/compile.txt" 2>&1
  test -s "$output_directory/$output_name.dex"
  if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$output_directory/compile.txt" { echo 'FAIL compiler diagnostic' >&2; exit 1 }
}
compile "$source" "$source/PlainOutput.idric" plain "$evidence/plain"
compile "$source" "$source/PlainOutput.idric" plain "$evidence/plain-repeat"
cmp "$evidence/plain/plain.dex" "$evidence/plain-repeat/plain.dex"
compile "$source" "$source/ClosuresAndRecords.idric" values "$evidence/values"
compile "$source" "$source/Arguments.idric" arguments "$evidence/arguments"
compile "$repository/examples/autogenerated/runtime-tailcalls" "$repository/examples/autogenerated/runtime-tailcalls/TailCalls.idric" tails "$evidence/tails"
for name in plain values arguments tails {
  java -jar "$baksmali" disassemble "$evidence/$name/$name.dex" -o "$evidence/$name/decoded"
  wc -c < "$evidence/$name/$name.dex" > "$evidence/$name/size-bytes.txt"
  rg -c '^\.method' "$evidence/$name/decoded/Idric/Generated.smali" > "$evidence/$name/method-count.txt"
  rg -c '^\.method' "$evidence/$name/decoded" > "$evidence/$name/method-counts-by-class.txt"
  rg --files "$evidence/$name/decoded" > "$evidence/$name/classes.txt"
  wc -l < "$evidence/$name/classes.txt" > "$evidence/$name/class-count.txt"
  sha256sum "$evidence/$name/$name.dex" > "$evidence/$name/artifact.sha256"
}
if rg -n '__idric_arguments|__idricArgCount|__idricArg\(|__idricApply' "$evidence/plain/decoded" { echo 'FAIL unused runtime retained in plain output' >&2; exit 1 }
rg -F '__idricApply' "$evidence/values/decoded/Idric/Generated.smali"
rg -F '__idricArgCount' "$evidence/arguments/decoded/Idric/Generated.smali"
mkdir -p "$evidence/mutant-source"
sed 's/plain-output-ok/plain-output-wrong/' "$source/PlainOutput.idric" > "$evidence/mutant-source/PlainOutput.idric"
compile "$evidence/mutant-source" "$evidence/mutant-source/PlainOutput.idric" plain "$evidence/mutant"
if cmp -s "$evidence/plain/plain.dex" "$evidence/mutant/plain.dex" { echo 'FAIL ineffective source mutation' >&2; exit 1 }
mkdir -p "$evidence/unsupported"
try {
  "$driver" --cg dex --source-dir "$source" --build-dir "$evidence/unsupported/build" \
    --output-dir "$evidence/unsupported" "$source/Unsupported.idric" -o unsupported > "$evidence/unsupported/compile.txt" 2>&1
}
var rejected = _error.code
test "$rejected" -ne 0
rg -F 'unsupported checked foreign declaration' "$evidence/unsupported/compile.txt"
test ! -e "$evidence/unsupported/unsupported.dex"
git -C "$repository" rev-parse HEAD > "$evidence/source-revision.txt"
sha256sum "$source/PlainOutput.idric" "$source/ClosuresAndRecords.idric" "$source/Arguments.idric" "$source/Unsupported.idric" "$repository/examples/autogenerated/runtime-tailcalls/TailCalls.idric" > "$evidence/sources.sha256"
printf 'checked_source_emission\tPASS\ndeterminism\tPASS\nindependent_decode\tPASS\nunused_runtime_pruning\tPASS\nunsupported_foreign\tREJECTED\nART\tNOT_RUN\nphysical_A1\tNOT_RUN\nphysical_C67\tNOT_RUN\n' > "$evidence/host-receipt.tsv"
printf '\033[32mPASS\033[0m runtime repair checked-source emission and independent decode\n'
