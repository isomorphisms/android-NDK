#!/usr/bin/env grease
if (len(ARGV) !== 3) { echo 'usage: grease build.grease REPOSITORY FRONTEND EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var evidence = ARGV[2]
var compiler = "$frontend/_/build/exec/idris2"
if test -e "$evidence" { echo 'FAIL build evidence already exists' >&2; exit 1 }
mkdir -p "$evidence/oracles"
git -C "$repository" rev-parse HEAD > "$evidence/integration-commit.txt"
try { printenv GITHUB_RUN_ID > "$evidence/workflow-run-id.txt" }
try { printenv GITHUB_RUN_ATTEMPT > "$evidence/workflow-run-attempt.txt" }
grease --version > "$evidence/grease-version.txt"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/support/c"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
git -C "$frontend" rev-parse HEAD > "$evidence/frontend-revision.txt"
"$compiler" --version > "$evidence/frontend-version.txt"
grease "$repository/dex/idric/install-frontend.grease" "$frontend" > "$evidence/compiler-api.txt" 2>&1
cd "$repository/dex/idric"
"$compiler" --build backend.ipkg > "$evidence/backend-build.txt" 2>&1
if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$evidence/backend-build.txt" { echo 'FAIL backend compiler diagnostic' >&2; exit 1 }
cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" build/exec/idric-dex_app/
setglobal ENV.IDRIS2_PATH = "$repository/dex/idric/build/ttc"
proc host_control(directory, source, name) {
  "$compiler" -p idris2 --source-dir "$directory" --build-dir "$evidence/$name" \
    "$directory/$source" -o "$name" > "$evidence/$name-build.txt" 2>&1
  if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$evidence/$name-build.txt" { echo 'FAIL host control diagnostic' >&2; exit 1 }
  var app = "$evidence/$name/exec/" ++ name ++ '_app/'
  cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$app"
  "$evidence/$name/exec/$name" > "$evidence/$name.txt" 2>&1
  rg '^PASS' "$evidence/$name.txt"
}
host_control "$repository/dex/idric/tests/dex" RuntimeCapabilitiesTest.idr capabilities
host_control "$repository/dex/idric/tests/dex" ValueLayoutTest.idr layouts
host_control "$repository/examples/autogenerated/jni-contracts" NativeContractChecks.idric contracts
host_control "$repository/examples/autogenerated/runtime-tailcalls" TailRetentionChecks.idric tail-roots
grease "$repository/dex/idric/tests/dex/verify-tail-transfer.grease" "$repository" "$frontend" "$evidence/tail-transfer-mutations"
sha256sum build/exec/idric-dex build/exec/idric-dex_app/idric-dex.so \
  build/exec/idric-dex_app/libidris2_support.so > "$evidence/backend.sha256"
git -C "$repository" rev-parse HEAD > "$evidence/backend-revision.txt"
git -C "$repository" rev-parse 'HEAD^{tree}' > "$evidence/backend-tree.txt"
curl -fL https://github.com/baksmali/smali/releases/download/3.0.10/baksmali-3.0.10-fat-release.jar -o "$evidence/oracles/baksmali.jar"
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$evidence/oracles/baksmali.jar" | sha256sum -c -
curl -fL https://github.com/baksmali/smali/releases/download/3.0.10/smali-3.0.10-fat-release.jar -o "$evidence/oracles/smali.jar"
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$evidence/oracles/smali.jar" | sha256sum -c -
grease "$repository/examples/autogenerated/runtime-acceptance/prepare.grease" "$repository" "$repository/dex/idric/build/exec/idric-dex" "$evidence/oracles/baksmali.jar" "$evidence/candidates"
