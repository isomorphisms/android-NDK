#!/usr/bin/env grease
# This dispatches the maintained foreign Bash/SDK qualification; it does not package itself.
set -eu -o pipefail
if (len(ARGV) !== 4) { echo 'usage: reproducible.grease MANIFEST NATIVE ABI OUTPUT'; exit 2 }
var directory = $(dirname "$0")
var qualifier = $(realpath "$directory/qualify-reproducible.sh")
var manifest = ARGV[0]
var native = ARGV[1]
var abi = ARGV[2]
var output = ARGV[3]
bash "$qualifier" "$manifest" "$native" "$abi" "$output"
