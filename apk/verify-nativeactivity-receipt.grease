#!/usr/bin/env grease
if (len(ARGV) !== 2) { echo 'usage: verify-nativeactivity-receipt.grease RECEIPT APK'; exit 2 }
var receipt = ARGV[0]
var apk = ARGV[1]
proc fail(message) { echo "android-NDK receipt verification failed: $message" >&2; exit 1 }
proc value(field) { awk -F '\t' -v field="$field" '$1 == field { print $2 }' "$receipt" }
proc digest(path) { sha256sum "$path" | awk '{print $1}' }
test -f "$receipt"
test -f "$apk"
var directory = $(dirname "$0")
var schema_id = $(value schema)
var schema_file = ''
if (schema_id === 'android-ndk-nativeactivity-apk-v2') {
  setvar schema_file = "$directory/nativeactivity-receipt-v2.schema.tsv"
} elif (schema_id === 'android-ndk-nativeactivity-apk-v3') {
  setvar schema_file = "$directory/nativeactivity-receipt-v3.schema.tsv"
} else { fail "unsupported receipt schema: $schema_id" }
test -f "$schema_file"
var work = $(mktemp -d)
trap --add EXIT { rm -rf -- "$work" }
tail -n +2 "$schema_file" | cut -f1 > "$work/expected-fields"
if ! awk -F '\t' 'NF != 2 { exit 1 } { print $1 }' "$receipt" > "$work/actual-fields" {
  fail 'receipt is not strict two-column TSV'
}
if ! cmp -s "$work/expected-fields" "$work/actual-fields" { fail 'receipt fields or field order do not match the schema' }
if test "$(value schema_sha256)" != "$(digest "$schema_file")" { fail 'receipt schema digest does not match the maintained schema' }
if ! awk -F '\t' '$1 ~ /_sha256$/ && $2 !~ /^[0-9a-f]{64}$/ { exit 1 }' "$receipt" {
  fail 'receipt contains an invalid SHA-256 digest'
}
awk -F '\t' 'NR == FNR { role[$1] = $2; next } role[$1] == "material" { print }' \
  "$schema_file" "$receipt" > "$work/material.tsv"
var material_sha = $(digest "$work/material.tsv")
if test "$(value material_sha256)" != "$material_sha" { fail "material digest does not match the receipt's material rows" }
var apk_sha = $(digest "$apk")
if test "$(value apk_sha256)" != "$apk_sha" { fail 'APK digest does not match receipt' }
if (schema_id === 'android-ndk-nativeactivity-apk-v3') {
  if ! unzip -p "$apk" classes.dex > "$work/classes.dex" { fail 'missing declared DEX payload' }
  if test "$(digest "$work/classes.dex")" != "$(value dex_sha256)" { fail 'DEX digest does not match receipt' }
}
printf 'ANDROID_NDK_RECEIPT\tPASS\nMATERIAL_SHA256\t%s\nAPK_SHA256\t%s\n' "$material_sha" "$apk_sha"
